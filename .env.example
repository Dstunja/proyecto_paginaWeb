# Copiar como .env (esta en .gitignore) o definir estas variables en el panel de
# Vercel (Settings > Environment Variables).
#
# Para comprobar que no falta ninguna:  npm run check:env
# Para traerlas ya definidas de Vercel: npx vercel env pull .env.local
#
# OJO CON EL MOMENTO EN QUE SE LEEN:
#   - Las PUBLIC_* se leen EN TIEMPO DE BUILD y acaban dentro del JavaScript
#     que descarga el navegador. Ahi no puede ir ningun secreto.
#   - Las demas las leen las funciones EN CADA PETICION, asi que cambiarlas en
#     el panel de Vercel surte efecto sin recompilar.
#
# Los dos mapas no necesitan nada: usan Leaflet con teselas de OpenStreetMap,
# que no piden API key, y la geocodificacion se hace una sola vez con
# `npm run geocodificar` (Nominatim, tambien sin key).

# ---------------------------------------------------------------------------
# Estadisticas de uso (Google Analytics 4)
# ---------------------------------------------------------------------------
# ID de medicion de la propiedad GA4, con el formato G-XXXXXXXXXX.
#
# Se lee EN TIEMPO DE BUILD y solo se inyecta en compilaciones de produccion:
# con `npm run dev` no se envia nada aunque este definido. Si se deja vacio,
# el sitio no carga ningun script de Google.
#
# Donde ponerlo de verdad:
#   - Vercel: Settings > Environment Variables, con el nombre PUBLIC_GA_ID.
#
# NO escribir aqui el ID real: este archivo si esta en el repositorio.
# Ver docs/ANALITICA.md para el paso a paso completo.
PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Radicacion de PQRS (funciones de Vercel + Vercel Blob)
# ---------------------------------------------------------------------------
# El formulario de PQRS radica de verdad: guarda la solicitud y los archivos de
# soporte, devuelve un numero de radicado y manda dos correos. Sin estas
# variables la API responde con un error claro y el formulario cae al respaldo
# por correo. El paso a paso completo esta en docs/PQRS-ADJUNTOS.md.
#
# Las que NO llevan prefijo PUBLIC_ son secretas: solo existen en el servidor.
# Las que SI lo llevan se compilan dentro del JavaScript del navegador, asi que
# ahi no puede ir ningun secreto.

# Token del Blob store. Lo crea Vercel solo al anadir Storage > Blob al
# proyecto; no hay que copiarlo a mano ni ponerlo aqui.
# BLOB_READ_WRITE_TOKEN=

# --- Las dos categorias de PQRS ---------------------------------------------
# El formulario pregunta primero A QUIEN va dirigida la solicitud, y cada
# categoria sigue un camino distinto (ver src/lib/pqrs/categorias.ts):
#
#   ADMINISTRATIVA  sale por el gestor de correo de quien escribe (mailto:),
#                   sin adjuntos, sin antirrobots y sin radicado. No usa
#                   ninguna funcion, asi que tambien funciona en el espejo de
#                   GitHub Pages. Su destino es PUBLIC_PQRS_ADMIN_DESTINO.
#   COMERCIAL       es la radicacion de verdad: sube soportes al Blob, verifica
#                   Turnstile, guarda el registro y devuelve un numero. Su
#                   destino es PQRS_DESTINO, aqui abajo.
#
# PUBLIC_PQRS_ADMIN_DESTINO lleva prefijo PUBLIC_ porque el mailto: se arma EN
# EL NAVEGADOR: el valor tiene que estar dentro del JavaScript compilado. No es
# un secreto (es una direccion de contacto que el sitio ya publica en el pie),
# pero SI hay que redesplegar despues de cambiarla en Vercel.
#
# Si se deja vacia se usa el correo de la empresa (empresa.email en
# src/data/site.ts), asi que el formulario administrativo funciona desde el
# primer despliegue. Admite varias direcciones separadas por coma.
PUBLIC_PQRS_ADMIN_DESTINO=

# Resend, para los dos correos de la categoria COMERCIAL (al area de PQRS y a
# quien radica).
# El dominio del remitente tiene que estar verificado en Resend: mientras no lo
# este, solo se puede enviar al correo del titular de la cuenta.
RESEND_API_KEY=
# Correo del area que recibe cada radicacion COMERCIAL.
PQRS_DESTINO=
# PQRS_REMITENTE="PQRS Distribuciones Santiago de Tunja <pqrs@dstunja.com>"

# Cloudflare Turnstile (antirrobots). Se verifica en los dos endpoints. Si falta
# TURNSTILE_SECRET el servidor RECHAZA la radicacion: no se deja pasar por
# defecto, porque asi es como se publica un formulario sin proteccion sin
# enterarse.
# Claves de prueba de Cloudflare, que siempre pasan, para desarrollo local:
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Protege GET /api/pqrs/limpieza, el cron que borra las subidas abandonadas.
# Una cadena larga y aleatoria. Vercel manda la cabecera Authorization sola.
CRON_SECRET=

# Sal del hash de la IP de quien radica. La IP nunca se guarda en claro; con sal
# ademas no se puede deshacer el hash recorriendo el espacio de direcciones.
PQRS_IP_SALT=

# Limites que aplica el SERVIDOR (son los que mandan).
# PQRS_ADJUNTO_MAX_MB=5
# PQRS_MAX_ARCHIVOS=3

# Acceso de los blobs: 'private' (por defecto) o 'public'. Lleva prefijo PUBLIC_
# porque el navegador necesita el mismo valor al subir. Poner 'public' solo si
# el plan de la cuenta no admite blobs privados; entonces la unica proteccion es
# que la ruta lleva un UUID no adivinable.
# PUBLIC_PQRS_BLOB_ACCESS=private

# Limite de peticiones por IP compartido entre instancias. Sin estas dos, el
# contador vive en la memoria de cada instancia: frena un script torpe, NO un
# ataque. Se aprovisiona desde el marketplace de Vercel (Upstash tiene plan
# gratuito).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Peso maximo por archivo que aplica y muestra el NAVEGADOR. Deberia coincidir
# con PQRS_ADJUNTO_MAX_MB; la del servidor es la que manda, esta sirve para
# avisar antes de subir y para el texto de ayuda ("Maximo N MB").
PUBLIC_PQRS_ADJUNTO_MAX_MB=5

# --- Resenas de Google (todavia NO conectado) ---------------------------------
# La seccion "Resenas reales en Google" del inicio se alimenta hoy de
# src/data/reseñas.ts (archivo local, datos de ejemplo). Para traerlas de la API
# real hay que crear un proyecto en Google Cloud con facturacion, habilitar
# "Places API (New)" y definir estas dos variables. Sin prefijo PUBLIC_: la
# consulta se hace en el build, la key nunca debe llegar al navegador.
# El paso a paso completo esta en el comentario de cabecera de src/data/reseñas.ts.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
