# Copiar como .env (esta en .gitignore) o definir estas variables en el
# panel de Cloudflare Pages/Workers. Se leen EN TIEMPO DE BUILD.
#
# Proveedor del mapa: 'osm' (por defecto, sin API key) o 'google'.
PUBLIC_MAPS_PROVIDER=osm
#
# Solo si PUBLIC_MAPS_PROVIDER=google. OJO: cualquier key de Google Maps
# Embed API viaja en la peticion del navegador, asi que nunca es 100 %
# secreta. La proteccion real es restringirla en Google Cloud Console por
# referente HTTP (solo dstunja.com) y limitarla a la Maps Embed API.
PUBLIC_GOOGLE_MAPS_EMBED_KEY=
