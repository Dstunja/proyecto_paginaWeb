---
/**
 * Franja de consentimiento de cookies (Ley 1581 de 2012, Colombia).
 *
 * Aparece abajo, discreta, la primera vez que alguien entra. La decisión se
 * guarda en localStorage (`dst_consentimiento`) y la franja no vuelve a
 * mostrarse: no se usa una cookie para recordarlo, porque justo eso es lo que
 * se está pidiendo permiso para hacer.
 *
 * Arranca oculta (`hidden`) y el script la muestra solo si no hay decisión
 * previa. Así quien ya respondió nunca la ve parpadear.
 */
import { ruta } from '../lib/rutas';
---

{/* `tablet:pr-24` deja libre la esquina del boton flotante de WhatsApp, que
    vive en el mismo rincon y quedaria medio tapado.

    En movil es una franja pegada al borde, sin margen ni esquinas, con texto
    de 13 px y los dos botones en una sola fila: a 360 px de ancho ocupa menos
    de una cuarta parte de la pantalla (antes, mas de la mitad). El texto y
    cuando se muestra no cambian. */}
<div
  class="aviso-cookies fixed inset-x-0 bottom-0 z-[180] mob:px-4 mob:pb-4 tablet:pr-24"
  data-aviso-cookies
  role="region"
  aria-label="Aviso sobre cookies"
  hidden
>
  <div
    class="aviso-cookies-panel mx-auto flex w-full max-w-[var(--container-site)] flex-col
           gap-2 border-t border-line px-4 pt-2.5 shadow-[0_-8px_24px_rgba(13,44,132,.14)]
           mob:gap-4 mob:rounded-card mob:border mob:px-6 mob:py-5 mob:shadow-[0_18px_44px_rgba(13,44,132,.18)]
           tablet:flex-row tablet:items-center tablet:gap-8"
  >
    <p class="m-0 flex-1 text-[13px] leading-snug text-muted mob:text-[14px] mob:leading-normal">
      Usamos cookies propias y de Google Analytics para saber qué secciones consultan más nuestros
      visitantes y mejorar el sitio. No vendemos ni compartimos tus datos. Puedes consultar la{' '}
      <a class="font-semibold text-secondary-dark underline" href={ruta('/privacidad/')}>
        política de tratamiento de datos</a
      >.
    </p>

    <div class="grid shrink-0 grid-cols-2 gap-2 mob:flex mob:flex-wrap mob:gap-3">
      <button
        type="button"
        class="btn btn-primary !px-4 !py-1.5 !text-[14px] mob:!px-6 mob:!py-2.5"
        data-aceptar-cookies
      >
        Aceptar
      </button>
      <button
        type="button"
        class="btn btn-secondary !px-4 !py-1.5 !text-[14px] mob:!px-6 mob:!py-2.5"
        data-rechazar-cookies
      >
        Solo lo necesario
      </button>
    </div>
  </div>
</div>

<style>
  /* Fondo opaco, no vidrio esmerilado. El resto del sitio usa `glass` para
     paneles decorativos, pero aqui detras hay un titular de 60 px que se
     transparentaba justo encima del texto legal, que es lo unico que la
     persona tiene que poder leer para decidir. */
  .aviso-cookies-panel {
    background-color: var(--color-surface);
    /* En movil va pegada al borde: deja aire para la franja inferior de los
       telefonos sin boton de inicio. */
    padding-bottom: calc(0.625rem + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 520px) {
    .aviso-cookies-panel {
      padding-bottom: 1.25rem;
    }
  }

  /* Entra deslizándose desde abajo, una sola vez. */
  .aviso-cookies:not([hidden]) {
    animation: dst-aviso-entra 0.35s ease-out;
  }

  @keyframes dst-aviso-entra {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aviso-cookies:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import { guardarConsentimiento, leerConsentimiento } from '../lib/analitica';

  const franja = document.querySelector<HTMLElement>('[data-aviso-cookies]');

  if (franja && leerConsentimiento() === null) {
    franja.hidden = false;

    const responder = (valor: 'aceptado' | 'necesario') => {
      guardarConsentimiento(valor);
      franja.hidden = true;
    };

    franja
      .querySelector('[data-aceptar-cookies]')
      ?.addEventListener('click', () => responder('aceptado'));

    franja
      .querySelector('[data-rechazar-cookies]')
      ?.addEventListener('click', () => responder('necesario'));
  }
</script>
