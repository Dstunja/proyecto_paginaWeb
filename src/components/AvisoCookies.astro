---
/**
 * Franja de consentimiento de cookies (Ley 1581 de 2012, Colombia).
 *
 * Aparece abajo, discreta, la primera vez que alguien entra. La decisión se
 * guarda en localStorage (`dst_consentimiento`) y la franja no vuelve a
 * mostrarse: no se usa una cookie para recordarlo, porque justo eso es lo que
 * se está pidiendo permiso para hacer.
 *
 * Arranca oculta (`hidden`) y el script la muestra solo si no hay decisión
 * previa. Así quien ya respondió nunca la ve parpadear.
 */
import { ruta } from '../lib/rutas';
---

<div
  class="aviso-cookies fixed inset-x-0 bottom-0 z-[180] px-4 pb-4"
  data-aviso-cookies
  role="region"
  aria-label="Aviso sobre cookies"
  hidden
>
  <div
    class="glass mx-auto flex w-full max-w-[var(--container-site)] flex-col gap-4 rounded-card
           bg-surface/95 px-6 py-5 shadow-[0_18px_44px_rgba(13,44,132,.18)]
           tablet:flex-row tablet:items-center tablet:gap-8"
  >
    <p class="m-0 flex-1 text-[14px] text-muted">
      Usamos cookies propias y de Google Analytics para saber qué secciones consultan más nuestros
      visitantes y mejorar el sitio. No vendemos ni compartimos tus datos. Puedes consultar la{' '}
      <a class="font-semibold text-secondary-dark underline" href={ruta('/privacidad/')}>
        política de tratamiento de datos</a
      >.
    </p>

    <div class="flex shrink-0 flex-wrap gap-3">
      <button type="button" class="btn btn-primary !px-6 !py-2.5 !text-[14px]" data-aceptar-cookies>
        Aceptar
      </button>
      <button
        type="button"
        class="btn btn-secondary !px-6 !py-2.5 !text-[14px]"
        data-rechazar-cookies
      >
        Solo lo necesario
      </button>
    </div>
  </div>
</div>

<style>
  /* Entra deslizándose desde abajo, una sola vez. */
  .aviso-cookies:not([hidden]) {
    animation: dst-aviso-entra 0.35s ease-out;
  }

  @keyframes dst-aviso-entra {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aviso-cookies:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import { guardarConsentimiento, leerConsentimiento } from '../lib/analitica';

  const franja = document.querySelector<HTMLElement>('[data-aviso-cookies]');

  if (franja && leerConsentimiento() === null) {
    franja.hidden = false;

    const responder = (valor: 'aceptado' | 'necesario') => {
      guardarConsentimiento(valor);
      franja.hidden = true;
    };

    franja
      .querySelector('[data-aceptar-cookies]')
      ?.addEventListener('click', () => responder('aceptado'));

    franja
      .querySelector('[data-rechazar-cookies]')
      ?.addEventListener('click', () => responder('necesario'));
  }
</script>
