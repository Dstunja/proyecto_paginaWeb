---
import { MUNICIPIOS } from '../data/site';
import Icono from './Icono.astro';

// La lista se pinta en el build: se ve aunque el visitante tenga JS desactivado.
const municipios = [...MUNICIPIOS].sort((a, b) => a.localeCompare(b, 'es'));
---

<div class="glass-card p-7">
  <label class="field-label" for="finder-input">¿Tu municipio está cubierto?</label>

  <div class="flex gap-2.5">
    <input
      type="text"
      id="finder-input"
      class="field flex-1"
      placeholder="Escribe tu municipio, ej. Duitama"
      autocomplete="off"
    />
    <button
      type="button"
      id="finder-btn"
      class="group flex items-center gap-2 rounded-full bg-secondary px-5 py-3 font-semibold text-white transition-all duration-300 hover:bg-[#3b9bef]"
    >
      <Icono nombre="search" class="h-[18px] w-[18px]" />
      <span class="sr-only mob:not-sr-only">Buscar</span>
    </button>
  </div>

  <p id="finder-result" class="mt-3.5 min-h-5 text-[14.5px]" role="status" aria-live="polite"></p>

  <div
    id="muni-list"
    class="mt-4 flex max-h-[120px] flex-wrap gap-2 overflow-y-auto"
    aria-label="Municipios con cobertura"
  >
    {
      municipios.map((m) => (
        <span
          data-muni={m}
          class="glass rounded-full px-2.5 py-1 text-[12.5px] font-medium text-ink transition-colors duration-200 hover:bg-secondary hover:text-white"
        >
          {m}
        </span>
      ))
    }
  </div>
</div>

<script>
  const input = document.getElementById('finder-input') as HTMLInputElement | null;
  const boton = document.getElementById('finder-btn');
  const resultado = document.getElementById('finder-result');
  const chips = Array.from(document.querySelectorAll<HTMLElement>('#muni-list [data-muni]'));

  /** Compara sin tildes ni mayúsculas: "Chiquinquira" encuentra "Chiquinquirá". */
  const normalizar = (t: string) =>
    t
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '');

  function filtrar(termino: string) {
    const t = normalizar(termino);
    chips.forEach((chip) => {
      chip.hidden = t !== '' && !normalizar(chip.dataset.muni ?? '').includes(t);
    });
  }

  function verificar() {
    if (!input || !resultado) return;
    const valor = input.value.trim();

    if (!valor) {
      resultado.textContent = 'Escribe el nombre de tu municipio.';
      resultado.className = 'mt-3.5 min-h-5 text-[14.5px]';
      filtrar('');
      return;
    }

    // Se responde con el nombre oficial del municipio, no con lo que se escribió.
    const encontrado = chips.find(
      (c) => normalizar(c.dataset.muni ?? '') === normalizar(valor),
    )?.dataset.muni;

    resultado.textContent = encontrado
      ? `Sí, cubrimos ${encontrado}. Un asesor puede contactarte.`
      : `Por ahora no tenemos cobertura confirmada en "${valor}". Escríbenos y lo validamos.`;
    resultado.className = `mt-3.5 min-h-5 text-[14.5px] ${encontrado ? 'text-ok' : 'text-accent-text'}`;
    filtrar(valor);
  }

  boton?.addEventListener('click', verificar);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') verificar();
  });
  input?.addEventListener('input', () => filtrar(input.value));
</script>
