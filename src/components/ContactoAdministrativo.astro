---
/**
 * Bloque de contacto de la categoría ADMINISTRATIVA de la página de PQRS.
 *
 * POR QUÉ NO ES UN FORMULARIO DE PQRS. Facturación, certificados, documentos y
 * trámites los resuelve una persona del equipo consultando sistemas a los que
 * el sitio no llega. Radicarlos con número y plazo de 15 días hábiles sería
 * prometer un trámite legal donde lo que hace falta es una llamada. Por eso
 * esta categoría NO enseña el paso 2 ni el formulario de PQRS: enseña esto.
 *
 * QUÉ HAY DENTRO, EN ESTE ORDEN:
 *   1. Los datos de contacto, que es lo que resuelve el caso más común. El
 *      teléfono lleva `tel:`, botón de WhatsApp con el mensaje ya escrito y
 *      botón de copiar; el correo lleva `mailto:` con el asunto puesto y otro
 *      botón de copiar.
 *   2. Un formulario corto y OPCIONAL, para quien prefiera que le devuelvan la
 *      llamada. No genera radicado y así se dice en pantalla.
 *
 * DE DÓNDE SALEN EL TELÉFONO Y EL CORREO. De `empresa`, en src/data/site.ts,
 * que es la fuente única del sitio y ya alimenta el pie y la página de
 * contacto. No se escriben a mano aquí: un número repetido en dos archivos es
 * un número que algún día dejará de coincidir.
 *
 * SI LA FUNCIÓN NO ESTÁ (el espejo de GitHub Pages no tiene backend, o Vercel
 * devuelve un error), el envío cae a un `mailto:` con los campos en el cuerpo.
 * Nadie se queda sin poder escribir porque falle una función.
 */
import { empresa } from '../data/site';
import { LIMITES_TEXTO } from '../lib/pqrs/limites-texto';
import ContadorCaracteres from './ContadorCaracteres.astro';
import Icono from './Icono.astro';
import LoaderDST from './LoaderDST.astro';

/** Asunto y saludo, en un solo sitio: los usan el enlace y el respaldo. */
const ASUNTO = 'Solicitud administrativa';
const SALUDO_WHATSAPP = 'Hola, tengo una solicitud administrativa';

const enlaceWhatsapp = `${empresa.whatsapp}?text=${encodeURIComponent(SALUDO_WHATSAPP)}`;
const enlaceCorreo = `mailto:${empresa.email}?subject=${encodeURIComponent(ASUNTO)}`;

const claveTurnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<div
  class="glass-card p-8"
  data-contacto-admin-caja
  data-destino={empresa.email}
  data-asunto={ASUNTO}
  data-turnstile-key={claveTurnstile}
>
  <span class="icono-chip mb-5 flex h-12 w-12">
    <Icono nombre="headset" class="h-6 w-6" interactivo={false} />
  </span>

  <h3 class="mb-3 text-[22px] tablet:text-[26px]">Información Administrativa</h3>
  <p class="mb-6 text-muted">
    Si tu queja es de tipo administrativa, por favor contáctanos directamente a través de:
  </p>

  <!-- TELÉFONO -->
  <div class="mb-4 rounded-xl border border-line bg-fondo p-5">
    <p class="kicker mb-2">Teléfono</p>
    <div class="flex flex-wrap items-center gap-3">
      <a
        class="font-display text-[20px] font-bold text-primary underline-offset-4 hover:underline"
        href={`tel:${empresa.telefonoE164}`}
      >
        {empresa.telefono}
      </a>
      {/*
        El valor a copiar va en el propio atributo y no se toma del texto del
        enlace: así se copia el número tal como se lee, sin depender de cómo
        quede maquetado alrededor.
      */}
      <button
        type="button"
        class="btn btn-secondary px-3 py-1.5 text-[13px]"
        data-copiar-dato={empresa.telefono}
        aria-label="Copiar el teléfono"
      >
        <Icono nombre="copy" class="h-4 w-4" interactivo={false} />
        <span data-copiar-texto>Copiar</span>
      </button>
      <a
        class="btn btn-secondary px-3 py-1.5 text-[13px]"
        href={enlaceWhatsapp}
        target="_blank"
        rel="noopener"
      >
        <Icono nombre="whatsapp" class="h-4 w-4" interactivo={false} />
        WhatsApp
      </a>
    </div>
  </div>

  <!-- CORREO -->
  <div class="mb-6 rounded-xl border border-line bg-fondo p-5">
    <p class="kicker mb-2">Correo</p>
    <div class="flex flex-wrap items-center gap-3">
      <a
        class="font-display text-[16px] font-semibold break-all text-primary underline-offset-4 hover:underline"
        href={enlaceCorreo}
      >
        {empresa.email}
      </a>
      <button
        type="button"
        class="btn btn-secondary px-3 py-1.5 text-[13px]"
        data-copiar-dato={empresa.email}
        aria-label="Copiar el correo"
      >
        <Icono nombre="copy" class="h-4 w-4" interactivo={false} />
        <span data-copiar-texto>Copiar</span>
      </button>
    </div>
  </div>

  <p class="mb-6 text-muted">
    También puedes dejarnos tus datos y nuestro equipo se pondrá en contacto contigo.
  </p>

  <!-- FORMULARIO CORTO, OPCIONAL -->
  <form data-form-admin class="grid grid-cols-1 gap-5 border-t border-line pt-6" novalidate={false}>
    <div>
      <label class="field-label" for="nombre-admin">Nombre *</label>
      <input class="field" id="nombre-admin" name="nombre-admin" type="text" required />
    </div>

    <div class="grid grid-cols-1 gap-5 mob:grid-cols-2">
      <div>
        <label class="field-label" for="telefono-admin">Teléfono *</label>
        <input class="field" id="telefono-admin" name="telefono-admin" type="tel" required />
      </div>
      <div>
        <label class="field-label" for="correo-admin">Correo (opcional)</label>
        <input class="field" id="correo-admin" name="correo-admin" type="email" />
      </div>
    </div>

    <div>
      <label class="field-label" for="mensaje-admin">¿Qué necesitas? *</label>
      <textarea
        class="field"
        id="mensaje-admin"
        name="mensaje-admin"
        rows="4"
        required
        maxlength={LIMITES_TEXTO.mensajeAdministrativo.max}
        aria-describedby="mensaje-admin-ayuda"
        placeholder="Cuéntanos en pocas líneas qué trámite o documento necesitas."></textarea>
      <ContadorCaracteres para="mensaje-admin" limites={LIMITES_TEXTO.mensajeAdministrativo} />
    </div>

    <!-- Turnstile en modo `interaction-only`: normalmente no se ve nada. -->
    <div data-turnstile-admin class="empty:hidden"></div>

    {/*
      Solo aparece si, después de pulsar Enviar, Cloudflare pide marcar la
      casilla. Mismo aviso que el formulario de Empleos.
    */}
    <p
      data-aviso-verificacion-admin
      class="m-0 hidden rounded-xl border border-secondary/30 bg-secondary-soft px-4 py-3 text-[14px] text-ink"
      role="status"
      aria-live="polite"
    >
      Falta un paso: marca la casilla de verificación de seguridad que aparece arriba para terminar
      de enviar tus datos.
    </p>

    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" class="btn btn-primary" data-enviar-admin>Enviar mis datos</button>
      <div data-espera-admin class="hidden" role="status" aria-live="polite">
        <LoaderDST tamano={28} anuncia={false} />
        <span class="sr-only">Enviando…</span>
      </div>
    </div>

    <div
      data-errores-admin
      class="hidden rounded-xl border border-accent-text/30 bg-accent-soft px-4 py-3"
      role="alert"
    >
      <p class="m-0 mb-1 font-display text-[14px] font-semibold text-accent-text">
        No pudimos enviar tus datos
      </p>
      <ul data-lista-errores-admin class="m-0 list-disc space-y-1 pl-5 text-[14px] text-ink"></ul>
    </div>

    <p class="m-0 text-[13px] text-muted">
      Esta solicitud <strong>no genera número de radicado</strong>: es una petición de contacto. Si
      necesitas constancia con número y fecha, vuelve arriba y elige la categoría{' '}
      <strong>comercial</strong>.
    </p>
  </form>

  <!-- Confirmación. Reemplaza al formulario, no se añade debajo. -->
  <div
    data-confirmacion-admin
    class="hidden border-t border-line pt-6"
    role="status"
    aria-live="polite"
  >
    <span class="icono-chip mb-5 flex h-12 w-12">
      <Icono nombre="circle-check" class="h-6 w-6" interactivo={false} />
    </span>
    <h4 class="mb-2 text-[20px]">Recibimos tus datos</h4>
    <p class="m-0 text-muted">
      Nuestro equipo se pondrá en contacto contigo. Si es urgente, llámanos al{' '}
      <a class="font-semibold text-secondary-dark underline" href={`tel:${empresa.telefonoE164}`}>
        {empresa.telefono}</a
      >.
    </p>
  </div>
</div>

<script>
  import { ErrorTurnstile, prepararTurnstile, tokenTurnstile } from '../lib/turnstile-cliente';
  import { ruta } from '../lib/rutas';

  /**
   * La ruta pasa por `ruta()` como todas las del sitio. Escrita a mano
   * apuntaría a la raíz del dominio, que en el espejo de GitHub Pages
   * —publicado bajo /proyecto_paginaWeb— es una dirección que no existe.
   */
  const RUTA_ENVIO = ruta('/api/pqrs/administrativa');

  document.querySelectorAll<HTMLElement>('[data-contacto-admin-caja]').forEach((raiz) => {
    // --- Copiar un dato ------------------------------------------------------
    raiz.querySelectorAll<HTMLButtonElement>('[data-copiar-dato]').forEach((boton) => {
      const etiqueta = boton.querySelector<HTMLElement>('[data-copiar-texto]');
      boton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(boton.dataset.copiarDato ?? '');
          if (etiqueta) etiqueta.textContent = 'Copiado';
        } catch {
          // Sin permiso de portapapeles (http://, o el navegador lo bloquea) el
          // dato sigue a la vista y se puede seleccionar a mano. Se dice.
          if (etiqueta) etiqueta.textContent = 'Cópialo a mano';
        }
        setTimeout(() => {
          if (etiqueta) etiqueta.textContent = 'Copiar';
        }, 2000);
      });
    });

    // --- Formulario corto ----------------------------------------------------
    const form = raiz.querySelector<HTMLFormElement>('[data-form-admin]');
    const cajaTurnstile = raiz.querySelector<HTMLElement>('[data-turnstile-admin]');
    const cajaErrores = raiz.querySelector<HTMLElement>('[data-errores-admin]');
    const listaErrores = raiz.querySelector<HTMLUListElement>('[data-lista-errores-admin]');
    const confirmacion = raiz.querySelector<HTMLElement>('[data-confirmacion-admin]');
    const boton = raiz.querySelector<HTMLButtonElement>('[data-enviar-admin]');
    const espera = raiz.querySelector<HTMLElement>('[data-espera-admin]');
    const avisoVerificacion = raiz.querySelector<HTMLElement>('[data-aviso-verificacion-admin]');
    if (!form || !cajaTurnstile || !cajaErrores || !listaErrores || !confirmacion || !boton) return;
    if (!avisoVerificacion) return;

    const claveTurnstile = raiz.dataset.turnstileKey ?? '';
    const destino = raiz.dataset.destino ?? '';
    const asunto = raiz.dataset.asunto ?? 'Solicitud administrativa';

    /*
     * Turnstile monta UN SOLO widget por página (ver src/lib/turnstile-cliente.ts):
     * si el formulario de PQRS ya lo preparó, esta llamada reutiliza el que hay
     * en lugar de montar un segundo. Los dos formularios nunca están visibles a
     * la vez, así que comparten widget sin estorbarse.
     */
    let turnstileListo = false;
    if (claveTurnstile) {
      prepararTurnstile(cajaTurnstile, claveTurnstile).then(
        () => {
          turnstileListo = true;
        },
        () => {
          turnstileListo = false;
        },
      );
    }

    /**
     * Token para el envío. Si Cloudflare pide marcar la casilla, se enseña el
     * aviso y se lleva la casilla a la vista; la espera no vence mientras la
     * persona la marca (ver src/lib/turnstile-cliente.ts).
     */
    async function token(): Promise<string> {
      if (!claveTurnstile) return '';
      return tokenTurnstile({
        alPedirInteraccion: () => {
          raiz.dataset.verificacion = 'pendiente';
          avisoVerificacion!.classList.remove('hidden');
          cajaTurnstile!.scrollIntoView({ behavior: 'smooth', block: 'center' });
        },
      });
    }

    function ocultarAvisoVerificacion() {
      if (raiz.dataset.verificacion === 'pendiente') delete raiz.dataset.verificacion;
      avisoVerificacion!.classList.add('hidden');
    }

    function valorDe(id: string): string {
      return (form!.querySelector<HTMLInputElement>(`#${id}`)?.value ?? '').trim();
    }

    function mostrarErrores(mensajes: string[]) {
      listaErrores!.textContent = '';
      for (const mensaje of mensajes) {
        const item = document.createElement('li');
        item.textContent = mensaje;
        listaErrores!.append(item);
      }
      cajaErrores!.classList.toggle('hidden', mensajes.length === 0);
    }

    /**
     * Respaldo: abre el gestor de correo con lo escrito.
     *
     * Solo se usa cuando la función NO contestó (no hay backend, o dio 5xx). Un
     * 400 no cae aquí: ahí el servidor sí contestó y dijo qué corregir.
     */
    function caerAlCorreo() {
      const lineas = [
        `Nombre: ${valorDe('nombre-admin')}`,
        `Teléfono: ${valorDe('telefono-admin')}`,
        `Correo: ${valorDe('correo-admin') || '(no lo dejó)'}`,
        '',
        valorDe('mensaje-admin'),
        '',
        '---',
        'Enviado desde dstunja.com',
      ];
      raiz.dataset.respaldo = 'correo';
      window.location.href =
        `mailto:${destino}?subject=${encodeURIComponent(asunto)}` +
        `&body=${encodeURIComponent(lineas.join('\n'))}`;
    }

    let temporizador: number | undefined;
    function mostrarEspera() {
      clearTimeout(temporizador);
      temporizador = window.setTimeout(() => espera?.classList.remove('hidden'), 150);
    }
    function ocultarEspera() {
      clearTimeout(temporizador);
      espera?.classList.add('hidden');
    }

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!form.reportValidity()) return;

      mostrarErrores([]);
      boton!.disabled = true;
      const textoBoton = boton!.textContent;
      mostrarEspera();

      try {
        if (claveTurnstile && !turnstileListo) {
          // Un último intento: puede que el script tardara más que la persona.
          await prepararTurnstile(cajaTurnstile!, claveTurnstile);
          turnstileListo = true;
        }

        boton!.textContent = 'Enviando…';

        // El token se pide ANTES del fetch y aparte: si Turnstile falla, el
        // `catch` de abajo lo distingue de una red caída.
        const turnstileToken = await token();
        ocultarAvisoVerificacion();

        const respuesta = await fetch(RUTA_ENVIO, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            nombre: valorDe('nombre-admin'),
            telefono: valorDe('telefono-admin'),
            correo: valorDe('correo-admin'),
            mensaje: valorDe('mensaje-admin'),
            turnstileToken,
          }),
        });

        // Un espejo estático sin funciones devuelve HTML, no JSON.
        const tipoRespuesta = respuesta.headers.get('content-type') ?? '';
        if (!tipoRespuesta.includes('application/json')) {
          caerAlCorreo();
          return;
        }

        const datos = (await respuesta.json()) as
          | { ok: true }
          | { ok: false; errores: string[]; codigo?: string };

        if (respuesta.ok && datos.ok) {
          raiz.dataset.enviado = 'api';
          form!.classList.add('hidden');
          confirmacion!.classList.remove('hidden');
          confirmacion!.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        // 503 config-incompleta: el servidor no tiene clave de Resend. Se avisa
        // con claridad antes de abrir el correo, para que la persona sepa por
        // qué se le abre su gestor en lugar de enviarse desde la página.
        if (!datos.ok && datos.codigo === 'config-incompleta') {
          raiz.dataset.configuracion = 'incompleta';
          mostrarErrores([
            'El envío desde la página no está disponible en este momento. Te abrimos tu gestor de correo con los datos para que nos escribas, o llámanos al número de arriba.',
          ]);
          caerAlCorreo();
          return;
        }

        if (respuesta.status >= 500) {
          caerAlCorreo();
          return;
        }

        // 400, 403, 429: el servidor contestó y explicó por qué. No hay respaldo
        // que valga; hay que corregir lo que dice y volver a enviar.
        mostrarErrores(datos.ok ? ['Error desconocido.'] : datos.errores);
      } catch (fallo) {
        /*
         * Un fallo de la verificación de seguridad NO es "no hay función": el
         * servidor ni siquiera se ha llamado. Antes caía aquí al `mailto:`, igual
         * que pasaba en Empleos. Solo el script de Cloudflare bloqueado
         * (`no-cargo`) justifica el respaldo por correo, porque desde la página
         * no hay forma de pasar la comprobación; si falló o caducó, se explica y
         * se puede volver a intentar.
         */
        if (fallo instanceof ErrorTurnstile && fallo.motivo !== 'no-cargo') {
          console.warn('[pqrs/administrativa] verificación de seguridad:', fallo.motivo, fallo.codigo ?? '');
          raiz.dataset.verificacion = 'fallida';
          avisoVerificacion!.classList.add('hidden');
          mostrarErrores([
            'No pudimos completar la verificación de seguridad. Vuelve a pulsar «Enviar mis datos» y, si aparece la casilla, márcala. Si sigue fallando, llámanos o escríbenos por WhatsApp con los datos de arriba.',
          ]);
          return;
        }
        caerAlCorreo();
      } finally {
        ocultarAvisoVerificacion();
        ocultarEspera();
        boton!.disabled = false;
        boton!.textContent = textoBoton;
      }
    });
  });
</script>
