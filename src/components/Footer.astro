---
import { empresa, redes, navegacion, PIDEKY_URL } from '../data/site';
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import EnlaceUbicacion from './EnlaceUbicacion.astro';
import { ruta } from '../lib/rutas';

const anio = new Date().getFullYear();

/**
 * Canales de atención.
 *
 * EDITAR AQUÍ (src/data/site.ts, PIDEKY_URL): mientras esa variable esté vacía,
 * Pideky NO aparece en esta lista. Antes había un enlace "Pideky" que llevaba a
 * un ancla del inicio, no a Pideky, y el botón de esa sección apuntaba a `#`:
 * un canal que se anuncia y no lleva a ninguna parte cuesta más confianza de la
 * que gana. En cuanto se llene la URL, el enlace reaparece solo, aquí y en el
 * inicio.
 */
const canales = [
  { icono: 'whatsapp', texto: 'WhatsApp', href: empresa.whatsapp, externo: true },
  ...(PIDEKY_URL.trim() !== ''
    ? [{ icono: 'shopping-cart', texto: 'Pideky', href: PIDEKY_URL, externo: true }]
    : []),
  { icono: 'shopping-cart', texto: 'Arma tu pedido', href: '/pedido/', externo: false },
  { icono: 'headset', texto: 'PQRS', href: '/pqrs/', externo: false },
  { icono: 'users', texto: 'Trabaja con nosotros', href: '/empleos/', externo: false },
];
---

{/* El pie cierra la pagina con el tono mas profundo de la paleta, un escalon
    por debajo del fondo, y un filo de luz arriba que lo separa del contenido. */}
<footer class="sobre-oscuro relative mt-8 bg-primary pt-20 pb-8 text-muted">
  <div class="wrap">
    <div class="grid grid-cols-1 gap-14 border-b border-line pb-14 tablet:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <Logo variante="claro" />
        <p class="mt-6 max-w-[38ch] text-[14.5px] text-muted">
          21 años llevando productos de calidad a miles de negocios en Boyacá, Santander y
          Cundinamarca.
        </p>

        {/* Cada red con su NOMBRE al lado del ícono. Un ícono suelto obliga a
            reconocer el logotipo, y el de un canal de WhatsApp no todo el mundo
            lo distingue; el nombre lo resuelve sin ambigüedad y deja el enlace
            legible también para un lector de pantalla. Las direcciones salen de
            `redes` (src/data/site.ts): aquí no hay ninguna escrita a mano, y
            para quitar o sumar una red se edita esa lista, no esta plantilla. */}
        <ul class="m-0 mt-8 flex list-none flex-wrap gap-2.5 p-0">
          {
            redes.map((red) => (
              <li>
                <a
                  href={red.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${red.nombre} — se abre en una pestaña nueva`}
                  class="glass group inline-flex items-center gap-2.5 rounded-full py-2 pr-4 pl-3
                         text-[14px] font-semibold text-muted transition-all duration-300
                         hover:-translate-y-0.5 hover:border-accent hover:bg-accent
                         hover:text-ink-dark focus-visible:border-accent
                         focus-visible:bg-accent focus-visible:text-ink-dark"
                >
                  <Icono nombre={red.icono} class="h-4 w-4" />
                  {red.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="mb-6 text-[12px] font-semibold tracking-[0.14em] text-ink uppercase">
          Enlaces rápidos
        </h4>
        <ul class="m-0 flex list-none flex-col gap-3.5 p-0">
          {
            navegacion.map((item) => (
              <li>
                <a
                  class="text-[14.5px] text-muted transition-colors duration-200 hover:text-accent"
                  href={ruta(item.href)}
                >
                  {item.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="mb-6 text-[12px] font-semibold tracking-[0.14em] text-ink uppercase">
          Nuestros canales
        </h4>
        <ul class="m-0 flex list-none flex-col gap-3.5 p-0">
          {
            canales.map((canal) => (
              <li>
                <a
                  class="group flex items-center gap-3 text-[14.5px] text-muted transition-colors duration-200 hover:text-accent"
                  href={ruta(canal.href)}
                  {...canal.externo ? { target: '_blank', rel: 'noopener' } : {}}
                >
                  <Icono nombre={canal.icono} class="h-4 w-4" />
                  {canal.texto}
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="m-0 mt-8 flex list-none flex-col gap-3.5 p-0">
          <li>
            <a
              class="group flex items-center gap-3 text-[14.5px] text-muted transition-colors duration-200 hover:text-accent"
              href={`mailto:${empresa.email}`}
            >
              <Icono nombre="mail" class="h-4 w-4" />
              {empresa.email}
            </a>
          </li>
          <li>
            <a
              class="group flex items-center gap-3 text-[14.5px] text-muted transition-colors duration-200 hover:text-accent"
              href={`tel:${empresa.telefonoE164}`}
            >
              <Icono nombre="phone" class="h-4 w-4" />
              {empresa.telefono}
            </a>
          </li>
          {/* La dirección se lee igual que el correo y el teléfono de arriba
              —mismo tamaño, mismo color, mismo cambio a naranja al pasar el
              mouse— y como ellos es un enlace: abre la sede en Google Maps.
              Por eso va sin subrayado: en esta columna lo que anuncia que algo
              es clicable es el color, y un subrayado solo aquí desalinearía la
              lista. El destino sale de EnlaceUbicacion.astro. */}
          <li>
            <EnlaceUbicacion
              subrayado={false}
              class="group flex items-center gap-3 text-[14.5px] text-muted transition-colors duration-200 hover:text-accent"
            >
              <Icono nombre="map-pin" class="h-4 w-4" />
              {empresa.direccion}, {empresa.ciudad}
            </EnlaceUbicacion>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 pt-8 text-[13px] text-muted/70">
      <span>© {anio} {empresa.razonSocial} Todos los derechos reservados.</span>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {/* La ley de proteccion de datos pide que la politica se pueda
            encontrar desde cualquier pagina. */}
        <a class="underline transition-colors duration-200 hover:text-accent" href={ruta('/privacidad/')}>
          Tratamiento de datos
        </a>
        <span class="tracking-[0.08em] uppercase">Boyacá · Santander · Cundinamarca</span>
      </div>
    </div>
  </div>
</footer>
