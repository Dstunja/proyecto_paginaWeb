---
import { empresa, redes, navegacion } from '../data/site';
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { ruta } from '../lib/rutas';

const anio = new Date().getFullYear();

const canales = [
  { icono: 'whatsapp', texto: 'WhatsApp', href: empresa.whatsapp, externo: true },
  { icono: 'shopping-cart', texto: 'Pideky', href: '/#haz-tu-pedido', externo: false },
  { icono: 'headset', texto: 'PQRS', href: '/pqrs/', externo: false },
  { icono: 'users', texto: 'Trabaja con nosotros', href: '/empleos/', externo: false },
];
---

<footer class="bg-ink pt-14 pb-6 text-white/80">
  <div class="wrap">
    <div class="grid grid-cols-1 gap-10 border-b border-white/15 pb-9 tablet:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Logo variante="claro" />
        <p class="mt-4 max-w-[36ch] text-sm text-white/65">
          21 años llevando productos de calidad a miles de negocios en Boyacá, Santander y
          Cundinamarca.
        </p>

        <div class="mt-6 flex gap-3">
          {
            redes.map((red) => (
              <a
                href={red.url}
                target="_blank"
                rel="noopener"
                aria-label={red.nombre}
                class="group flex h-9 w-9 items-center justify-center rounded-full border border-white/25
                       text-white/75 transition-all duration-200 hover:border-accent hover:bg-accent
                       hover:text-ink-dark focus-visible:border-accent focus-visible:bg-accent
                       focus-visible:text-ink-dark"
              >
                <Icono nombre={red.icono} class="h-4 w-4" />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h4 class="mb-4 text-[13px] tracking-wide text-white uppercase">Enlaces rápidos</h4>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
          {
            navegacion.map((item) => (
              <li>
                <a
                  class="text-sm text-white/70 transition-colors duration-200 hover:text-accent"
                  href={ruta(item.href)}
                >
                  {item.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="mb-4 text-[13px] tracking-wide text-white uppercase">Nuestros canales</h4>
        <ul class="m-0 flex list-none flex-col gap-3 p-0">
          {
            canales.map((canal) => (
              <li>
                <a
                  class="group flex items-center gap-2.5 text-sm text-white/70 transition-colors duration-200 hover:text-accent"
                  href={ruta(canal.href)}
                  {...canal.externo ? { target: '_blank', rel: 'noopener' } : {}}
                >
                  <Icono nombre={canal.icono} class="h-4 w-4" />
                  {canal.texto}
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="m-0 mt-6 flex list-none flex-col gap-3 p-0">
          <li>
            <a
              class="group flex items-center gap-2.5 text-sm text-white/70 transition-colors duration-200 hover:text-accent"
              href={`mailto:${empresa.email}`}
            >
              <Icono nombre="mail" class="h-4 w-4" />
              {empresa.email}
            </a>
          </li>
          <li>
            <a
              class="group flex items-center gap-2.5 text-sm text-white/70 transition-colors duration-200 hover:text-accent"
              href={`tel:${empresa.telefonoE164}`}
            >
              <Icono nombre="phone" class="h-4 w-4" />
              {empresa.telefono}
            </a>
          </li>
          <li class="flex items-center gap-2.5 text-sm text-white/70">
            <Icono nombre="map-pin" class="h-4 w-4" interactivo={false} />
            {empresa.direccion}, {empresa.ciudad}
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 pt-[22px] text-[13px] text-white/55">
      <span>© {anio} {empresa.razonSocial} Todos los derechos reservados.</span>
      <span>Boyacá · Santander · Cundinamarca</span>
    </div>
  </div>
</footer>
