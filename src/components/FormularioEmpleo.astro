---
/**
 * Formulario de postulación de /empleos/.
 *
 * Manda la postulación con la hoja de vida adjunta a `POST /api/empleos/postular`
 * como multipart, sin abrir el gestor de correo del candidato. La función la
 * reenvía por Resend a Talento Humano (ver src/lib/empleos/ y
 * docs/EMPLEOS-POSTULACION.md).
 *
 * QUÉ LLEVA. Nombre, correo, teléfono, cargo (las vacantes abiertas más la
 * opción espontánea, de src/lib/empleos/cargos.ts), un texto opcional sobre la
 * experiencia, la hoja de vida (PDF, DOC o DOCX, máximo 3 MB) y la casilla de
 * autorización de tratamiento de datos, obligatoria.
 *
 * LA HOJA DE VIDA SE REVISA ANTES DE ENVIAR con `validarFileHojaDeVida`, las
 * mismas reglas que aplica el servidor: extensión, peso, doble extensión y
 * bytes mágicos. Un archivo rechazado se saca del input y se explica por qué;
 * el nombre y el peso del aceptado se enseñan debajo del campo. Esta revisión
 * es una cortesía: la que vale es la del servidor, sobre los bytes recibidos.
 *
 * ANTISPAM. Tres capas, las mismas que la PQRS más una: un campo trampa
 * (honeypot) fuera de la vista que solo rellenan los robots, el límite por IP
 * del servidor y Turnstile en modo `interaction-only`, que normalmente no se
 * ve.
 *
 * YA NO HAY RESPALDO POR `mailto:`, y quitarlo fue el objetivo de todo esto. La
 * página abría el gestor de correo del candidato con sus datos y le pedía que
 * adjuntara la hoja de vida OTRA VEZ, a mano, porque un `mailto:` no puede
 * llevar archivos. En el celular, y sobre todo dentro del navegador de WhatsApp,
 * muchas veces no se abría nada: la persona se quedaba mirando un aviso que
 * hablaba de un correo que nunca existió, y su postulación no llegaba ni quedaba
 * registrada en ningún sitio. Ahora el envío es el único camino, y cuando falla
 * lo arregla el servidor: reintenta el correo y, si no sale, guarda la hoja de
 * vida (ver src/lib/empleos/postular.ts).
 *
 * TURNSTILE NO PUEDE DEJAR A NADIE FUERA. El reto se reintenta solo una vez
 * (src/lib/turnstile-cliente.ts) y, si aun así no se consigue el token, la
 * postulación SE MANDA IGUAL con la marca `sin_verificar`: el servidor la acepta
 * por una puerta más estrecha y le pone «[SIN VERIFICAR]» al asunto del correo.
 * Un navegador que no puede resolver un reto de Cloudflare —el WebView de
 * WhatsApp o de Instagram, un teléfono viejo, un bloqueador— no es motivo para
 * perder a un candidato.
 *
 * CADA ERROR QUE SE ENSEÑA LLEVA UN CÓDIGO CORTO («Código: T-110200»). Sirve
 * para que quien manda una captura de pantalla nos diga la causa sin abrir la
 * consola. WhatsApp aparece solo ahí, con el error, como último recurso.
 *
 * PREGUNTAS DE FILTRO DE LA VACANTE (src/lib/empleos/preguntas.ts). Talento
 * Humano escribe en Control360 hasta 8 preguntas básicas por vacante (moto,
 * licencia, años de experiencia, ciudad, disponibilidad…). Llegan con las
 * vacantes en el build y viajan al navegador en un JSON incrustado; al elegir
 * un cargo se pintan debajo del select (Sí/No → radios, opción → select,
 * número → input numérico, texto → input corto; las obligatorias con * y
 * `required`). Si la vacante no tiene preguntas, no aparece nada y el
 * formulario queda como siempre. El servidor las vuelve a exigir
 * (src/lib/empleos/postulacion.ts) y las manda a Control360 como `respuestas`.
 */
import { contactoEmpleo } from '../data/vacantes';
import { cargosAdmitidos } from '../lib/empleos/cargos';
import { CAMPO_HONEYPOT } from '../lib/empleos/config';
import { AUTORIZACION_PARRAFOS } from '../lib/empleos/autorizacion';
import { ACEPTA_HOJA_DE_VIDA, AYUDA_HOJA_DE_VIDA } from '../lib/empleos/hoja-de-vida';
import { cargarVacantes } from '../lib/empleos/vacantes-fuente';
import { ruta } from '../lib/rutas';
import Icono from './Icono.astro';
import LoaderDST from './LoaderDST.astro';

/*
 * WhatsApp ya no es una alternativa que se ofrece de entrada, sino el último
 * recurso cuando el envío falló: por eso el mensaje dice que YA lo intentó. Con
 * eso, quien atiende el número no empieza la conversación desde cero ni le pide
 * al candidato que vuelva a la página que acaba de fallarle.
 */
const SALUDO_WHATSAPP =
  'Hola, intenté postularme a una vacante desde la página de Distribuciones Santiago de Tunja y no pude enviar mi hoja de vida. ¿Me ayudan?';
const enlaceWhatsapp = `https://wa.me/${contactoEmpleo.whatsapp.numero}?text=${encodeURIComponent(SALUDO_WHATSAPP)}`;
const enlaceCorreo = `mailto:${contactoEmpleo.email}`;

const claveTurnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
// Las vacantes de Control360 (o la lista estática si no se pudieron leer):
// se resuelven en el build, una sola vez por proceso.
const cargos = await cargosAdmitidos();

// Las preguntas de filtro, por cargo, para el navegador. Solo las vacantes que
// traen alguna; el JSON va incrustado en un <script type="application/json">
// y se escapa `<` para que ningún texto pueda cerrar la etiqueta.
const { vacantes } = await cargarVacantes();
const preguntasPorCargo = Object.fromEntries(
  vacantes.filter((v) => v.preguntas?.length).map((v) => [v.cargo, v.preguntas]),
);
const jsonPreguntas = JSON.stringify(preguntasPorCargo).replace(/</g, '\\u003c');
---

<form
  data-form-empleo
  data-destino={contactoEmpleo.email}
  data-turnstile-key={claveTurnstile}
  class="relative grid grid-cols-1 gap-5"
  enctype="multipart/form-data"
>
  <div>
    <label class="field-label" for="nombre-empleo">Nombre completo *</label>
    <input
      class="field"
      id="nombre-empleo"
      name="nombre"
      type="text"
      required
      minlength="3"
      maxlength="150"
      autocomplete="name"
      autocapitalize="words"
      spellcheck="false"
    />
  </div>

  <div class="grid grid-cols-1 gap-5 mob:grid-cols-2">
    <div>
      <label class="field-label" for="correo-empleo">Correo *</label>
      <input
        class="field"
        id="correo-empleo"
        name="correo"
        type="email"
        required
        maxlength="150"
        autocomplete="email"
        inputmode="email"
        autocapitalize="off"
        spellcheck="false"
      />
    </div>
    <div>
      <label class="field-label" for="telefono-empleo">Teléfono *</label>
      <input
        class="field"
        id="telefono-empleo"
        name="telefono"
        type="tel"
        required
        maxlength="30"
        autocomplete="tel"
        inputmode="tel"
        aria-describedby="telefono-empleo-ayuda"
      />
      <p class="mt-2 mb-0 text-[13px] text-muted" id="telefono-empleo-ayuda">Celular o fijo, con o sin +57.</p>
    </div>
  </div>

  <div>
    <label class="field-label" for="cargo-empleo">Cargo al que te postulas *</label>
    <select class="field" id="cargo-empleo" name="cargo" required>
      {cargos.map((cargo) => <option value={cargo}>{cargo}</option>)}
    </select>
  </div>

  {/*
    PREGUNTAS DE FILTRO. Vacío hasta que se elige un cargo con preguntas; las
    pinta el script de abajo a partir del JSON. `hidden` mientras no hay nada,
    para que no quede un hueco en el formulario.
  */}
  <script type="application/json" is:inline data-preguntas-por-cargo set:html={jsonPreguntas}></script>
  <fieldset
    class="m-0 hidden grid-cols-1 gap-5 rounded-xl border border-line bg-fondo p-5"
    data-preguntas-empleo
    aria-live="polite"
  >
    <legend class="px-2 font-display text-[14px] font-semibold text-ink">
      Unas preguntas rápidas sobre esta vacante
    </legend>
    <p class="m-0 text-[13.5px] text-muted" data-preguntas-ayuda>
      Nos ayudan a revisar tu postulación más rápido. Las marcadas con * son obligatorias.
    </p>
    <div class="grid grid-cols-1 gap-5" data-preguntas-campos></div>
  </fieldset>

  <div>
    <label class="field-label" for="experiencia-empleo">
      Cuéntanos sobre tu experiencia{' '}
      <span class="font-normal text-muted">(opcional)</span>
    </label>
    <textarea class="field" id="experiencia-empleo" name="experiencia" rows="4" maxlength="3000"
    ></textarea>
  </div>

  <!-- HOJA DE VIDA -->
  <div data-hoja-de-vida>
    <label class="field-label" for="hoja-de-vida-empleo">Hoja de vida *</label>
    <input
      class="field cursor-pointer py-2.5 file:mr-3 file:cursor-pointer file:rounded-lg file:border-0
             file:bg-primary-soft file:px-3 file:py-1.5 file:font-display file:text-[13.5px]
             file:font-semibold file:text-primary hover:file:bg-secondary-soft"
      id="hoja-de-vida-empleo"
      name="hoja-de-vida"
      type="file"
      accept={ACEPTA_HOJA_DE_VIDA}
      required
      aria-describedby="hoja-de-vida-empleo-ayuda hoja-de-vida-empleo-error"
      data-entrada-hv
    />
    {/* El tope se dice ANTES de elegir, para no descubrirlo con el rechazo. */}
    <p class="mt-2 mb-0 text-[13px] text-muted" id="hoja-de-vida-empleo-ayuda" data-ayuda-hv>
      {AYUDA_HOJA_DE_VIDA}
    </p>

    <p
      class="mt-3 mb-0 hidden items-center gap-2 rounded-xl border border-line bg-fondo px-3 py-2 text-[14px]"
      data-archivo-hv
    >
      <Icono nombre="paperclip" class="h-4 w-4 shrink-0 text-secondary" interactivo={false} />
      <span class="min-w-0 truncate font-semibold text-ink" data-archivo-nombre></span>
      <span class="shrink-0 text-[12.5px] text-muted" data-archivo-peso></span>
    </p>

    <p
      id="hoja-de-vida-empleo-error"
      class="mt-2 mb-0 hidden text-[13.5px] font-semibold text-accent-text"
      role="alert"
      data-error-hv
    >
    </p>
  </div>

  {/*
    CAMPO TRAMPA. Un robot que rellena todos los campos lo llena; el servidor
    responde 200 y no manda nada, sin decirle qué lo delató.

    LO QUE NINGUNA PERSONA DEBE PODER HACER ES LLENARLO SIN QUERER, porque
    entonces su postulación se perdería en silencio y ella vería «Postulación
    enviada». De ahí cada una de estas defensas, que son cuatro y no una:

      - Fuera de la pantalla y `aria-hidden` en el contenedor Y en el campo: no
        se ve, y un lector de pantalla no lo anuncia ni lo alcanza.
      - `tabindex="-1"`: no se llega a él tabulando.
      - SIN <label>. Antes había uno que decía «Sitio web», y un gestor de
        contraseñas que lee etiquetas tenía ahí justo la pista para rellenarlo.
        Sin etiqueta y con `aria-hidden` no hay nada que leer.
      - `autocomplete="nope"`: un valor que no existe en el estándar. Los
        navegadores tratan lo que no reconocen como «off», y a diferencia de
        `off` -que Chrome ignora a menudo en formularios de contacto- no hay
        ninguna heurística que lo asocie a un campo conocido. Los `data-…` son
        las señales que respetan 1Password y LastPass.
  */}
  <div class="absolute top-0 -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <input
      id="sitio-web-empleo"
      name={CAMPO_HONEYPOT}
      type="text"
      tabindex="-1"
      aria-hidden="true"
      autocomplete="nope"
      data-1p-ignore
      data-lpignore="true"
      data-form-type="other"
      data-honeypot
    />
  </div>

  <!--
    EL TEXTO COMPLETO, y no un resumen: Control360 guarda con cada postulación la
    versión y la huella del texto aceptado (src/lib/empleos/autorizacion.ts). Eso
    solo prueba algo si la persona vio exactamente ese texto.
  -->
  <div
    id="texto-autorizacion-empleo"
    class="max-h-40 overflow-y-auto rounded-xl border border-black/10 bg-black/[0.02] p-3 text-[13px] leading-relaxed text-muted"
    tabindex="0"
    aria-label="Autorización de tratamiento de datos personales"
  >
    {AUTORIZACION_PARRAFOS.map((parrafo) => <p class="mb-2 last:mb-0">{parrafo}</p>)}
  </div>

  {/* Toda la etiqueta es zona táctil (mínimo 44 px de alto), no solo la casilla. */}
  <label class="flex min-h-11 cursor-pointer items-start gap-3 py-1 text-[14.5px] text-muted">
    <input
      type="checkbox"
      id="autorizacion-empleo"
      name="autorizacion"
      value="si"
      required
      aria-describedby="texto-autorizacion-empleo"
      class="mt-0.5 h-5 w-5 shrink-0 cursor-pointer accent-[var(--color-primary)]"
    />
    <span>
      He leído y acepto la autorización de tratamiento de datos de arriba, conforme a la
      Ley 1581 de 2012 y a la{' '}
      <a class="underline hover:text-primary" href={ruta('/privacidad/')}>
        política de privacidad
      </a>. *
    </span>
  </label>

  <!-- Turnstile en modo `interaction-only`: normalmente no se ve nada. -->
  <div data-turnstile-empleo class="empty:hidden"></div>

  {/*
    Solo aparece si, después de pulsar Enviar, Cloudflare pide marcar la
    casilla. Sin este aviso la casilla salía sin explicación y la espera
    vencía mientras la persona se preguntaba qué pasaba.
  */}
  <p
    data-aviso-verificacion
    class="m-0 hidden rounded-xl border border-secondary/30 bg-secondary-soft px-4 py-3 text-[14px] text-ink"
    role="status"
    aria-live="polite"
  >
    Falta un paso: marca la casilla de verificación de seguridad que aparece arriba para terminar
    de enviar tu postulación.
  </p>

  {/*
    Solo el botón de enviar. El de WhatsApp estaba aquí, al lado, y competía con
    el envío de verdad: la hoja de vida llega por WhatsApp como un archivo
    suelto, sin cargo ni autorización de datos, y alguien tiene que transcribirlo
    a mano. Ahora aparece abajo, dentro del aviso de error, cuando de verdad hace
    falta.
  */}
  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary" data-enviar-empleo>Enviar postulación</button>
    <div data-espera-empleo class="hidden" role="status" aria-live="polite">
      <LoaderDST tamano={28} anuncia={false} />
      <span class="sr-only">Enviando…</span>
    </div>
  </div>

  <div
    id="errores-empleo"
    data-errores-empleo
    class="hidden rounded-xl border border-accent-text/30 bg-accent-soft px-4 py-3"
    role="alert"
    tabindex="-1"
  >
    <p class="m-0 mb-1 font-display text-[14px] font-semibold text-accent-text">
      No pudimos enviar tu postulación
    </p>
    <ul data-lista-errores-empleo class="m-0 list-disc space-y-1 pl-5 text-[14px] text-ink"></ul>

    {/*
      CÓDIGO CORTO Y VISIBLE. No es para el candidato, que no puede hacer nada
      con él: es para nosotros. Quien manda una captura de pantalla por WhatsApp
      nos está diciendo con ese código si el problema fue el dominio sin
      autorizar en Cloudflare (T-110200), el reto que no corre en su navegador
      (T-600010) o el correo (E-CORREO), sin pedirle que abra ninguna consola.
    */}
    <p class="m-0 mt-2 hidden font-mono text-[12.5px] text-muted" data-codigo-error>
      Código: <span data-codigo-valor></span>
    </p>

    {/*
      Último recurso. Solo aparece con el error, nunca antes: por aquí la hoja de
      vida llega como un archivo suelto que alguien tiene que procesar a mano.
    */}
    <p class="m-0 mt-3 text-[14px] text-ink">
      Si vuelve a fallar, mándanos tu hoja de vida por{' '}
      <a
        class="font-semibold text-secondary-dark underline"
        href={enlaceWhatsapp}
        target="_blank"
        rel="noopener"
        data-whatsapp-empleo
      >
        WhatsApp
      </a>{' '}
      y te ayudamos a completar la postulación.
    </p>
  </div>
</form>

<!-- Confirmación. Reemplaza al formulario, no se añade debajo. -->
<div data-confirmacion-empleo class="hidden" role="status" aria-live="polite">
  <span class="icono-chip mb-5 flex h-12 w-12">
    <Icono nombre="circle-check" class="h-6 w-6" interactivo={false} />
  </span>
  <h3 class="mb-2 text-[22px]">Postulación enviada</h3>
  <p class="m-0 text-muted">Recibimos tu postulación, te contactaremos al correo indicado.</p>

  {/*
    Solo se enseña cuando el servidor devolvió una referencia, y eso pasa
    únicamente si la postulación quedó guardada pero el aviso a Talento Humano
    todavía no salió. En el camino normal no aparece: no hay nada que citar,
    porque el correo ya está en la bandeja.
  */}
  <p
    class="mt-3 mb-0 hidden rounded-xl border border-line bg-fondo px-4 py-3 text-[14px] text-ink"
    data-referencia-empleo
  >
    Guarda esta referencia por si necesitas preguntar por tu postulación:{' '}
    <strong class="font-mono" data-referencia-valor></strong>
  </p>
  <p class="mt-3 mb-0 text-[14.5px] text-muted">
    Si quieres agregar algo, escríbenos a{' '}
    <a class="font-semibold text-secondary-dark underline" href={enlaceCorreo}>
      {contactoEmpleo.email}
    </a>{' '}
    o por{' '}
    <a
      class="font-semibold text-secondary-dark underline"
      href={enlaceWhatsapp}
      target="_blank"
      rel="noopener"
    >
      WhatsApp
    </a>.
  </p>
</div>

<script>
  import { formatearTamano, nombreParaMostrar } from '../lib/adjuntos';
  import { registrarEvento } from '../lib/analitica';
  import { validarFileHojaDeVida } from '../lib/empleos/hoja-de-vida';
  import { LIMITES, nombreCampo, type PreguntaVacante } from '../lib/empleos/preguntas';
  import { ruta } from '../lib/rutas';
  import {
    ErrorTurnstile,
    codigoVisible,
    prepararTurnstile,
    tokenTurnstile,
  } from '../lib/turnstile-cliente';

  /**
   * La ruta pasa por `ruta()` como todas las del sitio. Escrita a mano
   * apuntaría a la raíz del dominio, que en el espejo de GitHub Pages
   * —publicado bajo /proyecto_paginaWeb— es una dirección que no existe.
   */
  const RUTA_ENVIO = ruta('/api/empleos/postular');

  document.querySelectorAll<HTMLFormElement>('[data-form-empleo]').forEach((form) => {
    const entrada = form.querySelector<HTMLInputElement>('[data-entrada-hv]');
    const cajaArchivo = form.querySelector<HTMLElement>('[data-archivo-hv]');
    const nombreArchivo = form.querySelector<HTMLElement>('[data-archivo-nombre]');
    const pesoArchivo = form.querySelector<HTMLElement>('[data-archivo-peso]');
    const errorArchivo = form.querySelector<HTMLElement>('[data-error-hv]');
    const cajaTurnstile = form.querySelector<HTMLElement>('[data-turnstile-empleo]');
    const cajaErrores = form.querySelector<HTMLElement>('[data-errores-empleo]');
    const listaErrores = form.querySelector<HTMLUListElement>('[data-lista-errores-empleo]');
    const cajaCodigo = form.querySelector<HTMLElement>('[data-codigo-error]');
    const valorCodigo = form.querySelector<HTMLElement>('[data-codigo-valor]');
    const avisoVerificacion = form.querySelector<HTMLElement>('[data-aviso-verificacion]');
    const boton = form.querySelector<HTMLButtonElement>('[data-enviar-empleo]');
    const espera = form.querySelector<HTMLElement>('[data-espera-empleo]');
    const confirmacion = form.parentElement?.querySelector<HTMLElement>(
      '[data-confirmacion-empleo]',
    );
    // Viven dentro de la confirmación, no del formulario.
    const cajaReferencia = confirmacion?.querySelector<HTMLElement>('[data-referencia-empleo]');
    const valorReferencia = confirmacion?.querySelector<HTMLElement>('[data-referencia-valor]');
    if (
      !entrada ||
      !cajaArchivo ||
      !nombreArchivo ||
      !pesoArchivo ||
      !errorArchivo ||
      !cajaTurnstile ||
      !cajaErrores ||
      !listaErrores ||
      !cajaCodigo ||
      !valorCodigo ||
      !avisoVerificacion ||
      !boton ||
      !confirmacion
    ) {
      return;
    }

    const claveTurnstile = form.dataset.turnstileKey ?? '';

    // --- Preguntas de filtro de la vacante ----------------------------------
    //
    // Se pintan con createElement, nunca con innerHTML: los textos vienen de
    // Control360 (los escribe Talento Humano) y lo que llega de fuera no se
    // pinta como HTML. Cada campo se llama `pregunta__<id>`, que es lo que el
    // servidor lee (src/lib/empleos/postulacion.ts).
    const selectCargo = form.querySelector<HTMLSelectElement>('#cargo-empleo');
    const cajaPreguntas = form.querySelector<HTMLFieldSetElement>('[data-preguntas-empleo]');
    const camposPreguntas = form.querySelector<HTMLElement>('[data-preguntas-campos]');
    const jsonPreguntas = form.querySelector<HTMLScriptElement>('[data-preguntas-por-cargo]');
    let preguntasPorCargo: Record<string, PreguntaVacante[]> = {};
    try {
      preguntasPorCargo = JSON.parse(jsonPreguntas?.textContent || '{}') as Record<string, PreguntaVacante[]>;
    } catch {
      preguntasPorCargo = {};
    }

    function etiqueta(p: PreguntaVacante, para?: string): HTMLLabelElement {
      const label = document.createElement('label');
      label.className = 'field-label';
      if (para) label.htmlFor = para;
      label.textContent = p.obligatoria ? `${p.texto} *` : p.texto;
      return label;
    }

    function campoPregunta(p: PreguntaVacante): HTMLElement {
      const caja = document.createElement('div');
      const nombre = nombreCampo(p.id);
      const idHtml = `${nombre}-empleo`;

      if (p.tipo === 'SI_NO') {
        // Un grupo de radios: la etiqueta va como leyenda del grupo, no de un input.
        const grupo = document.createElement('div');
        grupo.setAttribute('role', 'radiogroup');
        const leyenda = etiqueta(p);
        leyenda.id = `${idHtml}-leyenda`;
        grupo.setAttribute('aria-labelledby', leyenda.id);
        caja.append(leyenda);
        const opciones = document.createElement('div');
        opciones.className = 'flex flex-wrap gap-x-6 gap-y-2';
        for (const [valor, texto] of [['SI', 'Sí'], ['NO', 'No']] as const) {
          const l = document.createElement('label');
          l.className = 'inline-flex cursor-pointer items-center gap-2 text-[15px] text-ink';
          const r = document.createElement('input');
          r.type = 'radio';
          r.name = nombre;
          r.value = valor;
          r.required = p.obligatoria;
          r.className = 'h-4 w-4 accent-[var(--color-primary)]';
          l.append(r, document.createTextNode(texto));
          opciones.append(l);
        }
        grupo.append(opciones);
        caja.append(grupo);
        return caja;
      }

      caja.append(etiqueta(p, idHtml));
      if (p.tipo === 'OPCION') {
        const s = document.createElement('select');
        s.className = 'field';
        s.id = idHtml;
        s.name = nombre;
        s.required = p.obligatoria;
        const vacia = document.createElement('option');
        vacia.value = '';
        vacia.textContent = 'Elige una opción';
        s.append(vacia);
        for (const o of p.opciones ?? []) {
          const op = document.createElement('option');
          op.value = o;
          op.textContent = o;
          s.append(op);
        }
        caja.append(s);
        return caja;
      }

      const i = document.createElement('input');
      i.className = 'field';
      i.id = idHtml;
      i.name = nombre;
      i.required = p.obligatoria;
      if (p.tipo === 'NUMERO') {
        i.type = 'number';
        i.inputMode = 'decimal';
        i.min = '0';
        i.step = 'any';
      } else {
        i.type = 'text';
        i.maxLength = LIMITES.respuesta;
      }
      caja.append(i);
      return caja;
    }

    function pintarPreguntas() {
      if (!cajaPreguntas || !camposPreguntas) return;
      const lista = preguntasPorCargo[selectCargo?.value ?? ''] ?? [];
      camposPreguntas.textContent = '';
      for (const p of lista) camposPreguntas.append(campoPregunta(p));
      cajaPreguntas.classList.toggle('hidden', lista.length === 0);
      cajaPreguntas.classList.toggle('grid', lista.length > 0);
    }

    selectCargo?.addEventListener('change', pintarPreguntas);
    pintarPreguntas();

    function valorDe(nombre: string): string {
      const campo = form.elements.namedItem(nombre) as
        | HTMLInputElement
        | HTMLSelectElement
        | HTMLTextAreaElement
        | null;
      return (campo?.value ?? '').trim();
    }

    // --- Hoja de vida -------------------------------------------------------

    function mostrarArchivo(archivo: File | null) {
      if (!archivo) {
        cajaArchivo!.classList.add('hidden');
        cajaArchivo!.classList.remove('flex');
        nombreArchivo!.textContent = '';
        pesoArchivo!.textContent = '';
        return;
      }
      // textContent, nunca innerHTML: el nombre lo escribe quien sube el archivo.
      nombreArchivo!.textContent = nombreParaMostrar(archivo.name);
      nombreArchivo!.title = nombreArchivo!.textContent;
      pesoArchivo!.textContent = formatearTamano(archivo.size);
      cajaArchivo!.classList.remove('hidden');
      cajaArchivo!.classList.add('flex');
    }

    /**
     * Enseña el motivo del rechazo y lo deja también como validez personalizada
     * del input: así `reportValidity()` frena el envío con NUESTRO mensaje y no
     * con el genérico de "selecciona un archivo".
     */
    function avisarArchivo(mensaje: string) {
      errorArchivo!.textContent = mensaje;
      errorArchivo!.classList.toggle('hidden', mensaje === '');
      entrada!.setAttribute('aria-invalid', mensaje === '' ? 'false' : 'true');
      entrada!.setCustomValidity(mensaje);
    }

    entrada.addEventListener('change', async () => {
      const archivo = entrada!.files?.[0] ?? null;
      if (!archivo) {
        // Diálogo cancelado: el input quedó vacío y se dice.
        mostrarArchivo(null);
        avisarArchivo('');
        return;
      }

      // Mientras se leen las firmas el envío queda bloqueado.
      entrada!.setCustomValidity('Estamos revisando el archivo, espera un momento.');
      let veredicto;
      try {
        veredicto = await validarFileHojaDeVida(archivo);
      } finally {
        entrada!.setCustomValidity('');
      }

      if (!veredicto.ok) {
        // El rechazado se saca del input: nunca se envía.
        entrada!.value = '';
        mostrarArchivo(null);
        avisarArchivo(veredicto.error);
        return;
      }

      avisarArchivo('');
      mostrarArchivo(archivo);
    });

    // --- Turnstile ------------------------------------------------------------

    /*
     * Turnstile monta UN SOLO widget por página (ver src/lib/turnstile-cliente.ts).
     * Aquí es el único formulario, así que el widget es suyo.
     */
    let turnstileListo = false;
    if (claveTurnstile) {
      prepararTurnstile(cajaTurnstile, claveTurnstile).then(
        () => {
          turnstileListo = true;
        },
        () => {
          turnstileListo = false;
        },
      );
    }

    /**
     * Consigue el token, y si no puede lo dice en vez de reventar.
     *
     * NUNCA LANZA. Ese es el cambio importante: antes un fallo de Turnstile
     * cortaba el envío y la postulación no llegaba a salir de la página. Ahora
     * devuelve `sinVerificar: true` con el código del fallo, y quien llama
     * decide qué hacer con eso; lo que hace es mandarla igual.
     *
     * Si Cloudflare pide marcar la casilla, se enseña el aviso y se lleva la
     * casilla a la vista; la espera no vence mientras la persona la marca (ver
     * src/lib/turnstile-cliente.ts).
     */
    async function token(): Promise<{ valor: string; sinVerificar: boolean; codigo: string }> {
      if (!claveTurnstile) return { valor: '', sinVerificar: false, codigo: '' };

      try {
        if (!turnstileListo) {
          // Ahora sí es un reintento de verdad: la promesa fallida ya no se
          // queda cacheada (ver src/lib/turnstile-cliente.ts).
          await prepararTurnstile(cajaTurnstile!, claveTurnstile);
          turnstileListo = true;
        }
        const valor = await tokenTurnstile({
          alPedirInteraccion: () => {
            form.dataset.verificacion = 'pendiente';
            avisoVerificacion!.classList.remove('hidden');
            cajaTurnstile!.scrollIntoView({ behavior: 'smooth', block: 'center' });
          },
        });
        return { valor, sinVerificar: false, codigo: '' };
      } catch (fallo) {
        if (!(fallo instanceof ErrorTurnstile)) throw fallo;
        const codigo = codigoVisible(fallo);
        console.warn('[empleos] sin verificación de seguridad:', fallo.motivo, codigo);
        form.dataset.verificacion = 'omitida';
        return { valor: '', sinVerificar: true, codigo };
      }
    }

    function ocultarAvisoVerificacion() {
      delete form.dataset.verificacion;
      avisoVerificacion!.classList.add('hidden');
    }

    // --- Mensajes -----------------------------------------------------------

    function mostrarErrores(mensajes: string[], codigo = '') {
      listaErrores!.textContent = '';
      for (const mensaje of mensajes) {
        const item = document.createElement('li');
        item.textContent = mensaje;
        listaErrores!.append(item);
      }

      // textContent, nunca innerHTML: el código viene de una respuesta del
      // servidor, y lo que llega de fuera no se pinta como HTML.
      valorCodigo!.textContent = codigo;
      cajaCodigo!.classList.toggle('hidden', codigo === '');

      cajaErrores!.classList.toggle('hidden', mensajes.length === 0);
      // El botón de enviar apunta a la caja de errores mientras la haya, y el
      // foco salta a ella: quien navega con lector de pantalla o teclado sabe
      // qué falló sin tener que buscarlo.
      if (mensajes.length > 0) {
        boton?.setAttribute('aria-describedby', 'errores-empleo');
        cajaErrores!.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        cajaErrores!.focus({ preventScroll: true });
      } else {
        boton?.removeAttribute('aria-describedby');
      }
    }

    let temporizador: number | undefined;
    function mostrarEspera() {
      clearTimeout(temporizador);
      temporizador = window.setTimeout(() => espera?.classList.remove('hidden'), 150);
    }
    function ocultarEspera() {
      clearTimeout(temporizador);
      espera?.classList.add('hidden');
    }

    /**
     * Confirma en pantalla.
     *
     * `referencia` solo llega cuando la postulación quedó GUARDADA pero el aviso
     * a Talento Humano todavía no salió (ver src/lib/empleos/postular.ts). En el
     * camino normal no existe, y entonces no se enseña nada: no hay ningún
     * código que el candidato necesite apuntar.
     */
    function confirmar(referencia?: string) {
      form.dataset.enviado = 'api';
      if (referencia && cajaReferencia && valorReferencia) {
        valorReferencia.textContent = referencia;
        cajaReferencia.classList.remove('hidden');
      }
      form.classList.add('hidden');
      confirmacion!.classList.remove('hidden');
      confirmacion!.scrollIntoView({ behavior: 'smooth', block: 'center' });
      // Solo el cargo: ningún dato personal sale hacia la analítica.
      registrarEvento('postulacion_enviada', { cargo: valorDe('cargo') });
    }

    // --- Envío ----------------------------------------------------------------

    type RespuestaApi =
      | { ok: true; referencia?: string }
      | { ok: false; errores: string[]; codigo?: string };

    /** Lo que el navegador necesita saber de una respuesta del servidor. */
    interface Desenlace {
      estado: number;
      datos: RespuestaApi | null;
    }

    /**
     * Manda el multipart. Devuelve `datos: null` si la respuesta no es JSON, que
     * es lo que pasa en el espejo de GitHub Pages, donde no hay funciones.
     */
    async function enviar(
      turnstileToken: string,
      sinVerificar: boolean,
      codigo: string,
    ): Promise<Desenlace> {
      // El multipart sale del propio formulario: campos, casilla, campo trampa
      // y archivo. Sin cabecera content-type: la pone el navegador, con el
      // boundary.
      const cuerpo = new FormData(form);
      cuerpo.set('turnstileToken', turnstileToken);
      if (sinVerificar) {
        cuerpo.set('sin_verificar', 'si');
        if (codigo) cuerpo.set('turnstileCodigo', codigo);
      }

      const respuesta = await fetch(RUTA_ENVIO, { method: 'POST', body: cuerpo });

      const tipoRespuesta = respuesta.headers.get('content-type') ?? '';
      if (!tipoRespuesta.includes('application/json')) {
        return { estado: respuesta.status, datos: null };
      }
      return { estado: respuesta.status, datos: (await respuesta.json()) as RespuestaApi };
    }

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!form.reportValidity()) return;

      mostrarErrores([]);
      boton!.disabled = true;
      const textoBoton = boton!.textContent;
      boton!.textContent = 'Enviando…';
      mostrarEspera();

      try {
        /*
         * 1. El token. `token()` no lanza: si el reto no se pudo resolver ni al
         *    segundo intento, devuelve `sinVerificar` y el código del fallo, y
         *    la postulación sale igual. Un navegador que no puede con un reto de
         *    Cloudflare no es motivo para perder a un candidato.
         */
        const verificacion = await token();
        ocultarAvisoVerificacion();

        // 2. El envío.
        let desenlace = await enviar(
          verificacion.valor,
          verificacion.sinVerificar,
          verificacion.codigo,
        );

        /*
         * 3. Un 403 con token es un token que el SERVIDOR rechazó: caducado,
         *    ya usado, o de un dominio que el widget no tiene autorizado. Para
         *    la persona es indistinguible de que el reto no funcione, así que se
         *    reenvía una vez como «sin verificar» en vez de dejarla fuera. Si ya
         *    iba sin verificar, no hay nada que reintentar.
         */
        if (desenlace.estado === 403 && !verificacion.sinVerificar) {
          const codigo =
            desenlace.datos && !desenlace.datos.ok ? (desenlace.datos.codigo ?? '') : '';
          console.warn('[empleos] el servidor rechazó el token; se reenvía sin verificar:', codigo);
          form.dataset.verificacion = 'omitida';
          desenlace = await enviar('', true, '');
        }

        const { estado, datos } = desenlace;

        if (datos === null) {
          /*
           * No hay función que conteste. Es el espejo de GitHub Pages, que no
           * tiene backend. NO se abre ningún gestor de correo: se dice qué pasa
           * y se ofrece WhatsApp, que sí puede llevar el archivo.
           */
          mostrarErrores(
            [
              'El envío de postulaciones no está disponible en esta dirección. Entra a dstunja.com/empleos o mándanos tu hoja de vida por WhatsApp.',
            ],
            'E-SIN-API',
          );
          return;
        }

        if (estado >= 200 && estado < 300 && datos.ok) {
          confirmar(datos.referencia);
          return;
        }

        // 400, 403, 429, 500: el servidor contestó y explicó por qué. El código
        // va debajo, para que una captura de pantalla nos diga la causa.
        mostrarErrores(
          datos.ok ? ['No pudimos enviar tu postulación.'] : datos.errores,
          datos.ok ? '' : (datos.codigo ?? ''),
        );
      } catch (fallo) {
        /*
         * Aquí solo se llega por un fallo de RED: el `fetch` no salió o se cortó
         * a mitad. Los fallos de Turnstile ya no pasan por aquí, los absorbe
         * `token()`.
         */
        console.warn('[empleos] no se pudo enviar:', fallo);
        mostrarErrores(
          [
            'No pudimos conectar con el servidor. Revisa tu conexión y vuelve a pulsar «Enviar postulación».',
          ],
          'E-RED',
        );
      } finally {
        if (form.dataset.verificacion === 'pendiente') ocultarAvisoVerificacion();
        ocultarEspera();
        boton!.disabled = false;
        boton!.textContent = textoBoton;
      }
    });
  });
</script>
