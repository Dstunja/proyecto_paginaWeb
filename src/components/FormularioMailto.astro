---
import { empresa } from '../data/site';

/**
 * Formulario que abre el gestor de correo.
 *
 * Lo usa CONTACTO, que es una página estática: no envía nada por sí misma,
 * arma un correo con lo que escribió la persona y lo abre en su gestor. Para
 * ese caso basta, porque no hay nada de lo que dejar constancia ni plazo legal
 * que contar.
 *
 * Ni la PQRS ni EMPLEOS usan ya este componente: la PQRS radica de verdad
 * contra /api/pqrs (src/components/FormularioPqrs.astro) y empleos manda la
 * postulación con la hoja de vida adjunta a /api/empleos/postular
 * (src/components/FormularioEmpleo.astro). Si algún día contacto necesita
 * constancia, el camino es el mismo.
 */
interface Props {
  asunto: string;
  /** Texto del botón de envío. */
  boton?: string;
  destinatario?: string;
  /**
   * Nombre con el que este formulario aparece en la analítica. Viaja en el
   * evento `envio_contacto` para poder distinguir un formulario de otro si
   * algún día hay más de uno; nunca lleva nada de lo que la persona escribió.
   */
  medicion?: string;
}

const {
  asunto,
  boton = 'Enviar',
  destinatario = empresa.email,
  medicion = 'contacto',
} = Astro.props;
---

<form
  data-mailto
  data-asunto={asunto}
  data-destinatario={destinatario}
  data-medicion={medicion}
  novalidate={false}
  class="grid grid-cols-1 gap-5"
>
  <slot />

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary">{boton}</button>
    <a class="btn btn-secondary" href={empresa.whatsapp} target="_blank" rel="noopener">
      Prefiero WhatsApp
    </a>
  </div>

  <p data-aviso class="m-0 hidden text-[14.5px] text-ok" role="status" aria-live="polite"></p>
</form>

<script>
  import { registrarEvento } from '../lib/analitica';

  const ETIQUETAS: Record<string, string> = {};

  document.querySelectorAll<HTMLFormElement>('form[data-mailto]').forEach((form) => {
    // Etiqueta legible de cada campo, para que el correo se entienda.
    form.querySelectorAll<HTMLLabelElement>('label[for]').forEach((label) => {
      ETIQUETAS[label.htmlFor] = label.textContent?.replace(/\*/g, '').trim() ?? label.htmlFor;
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const datos = new FormData(form);
      const lineas: string[] = [];

      for (const [nombre, valor] of datos.entries()) {
        if (typeof valor !== 'string' || valor.trim() === '') continue;
        const etiqueta = ETIQUETAS[nombre] ?? nombre;
        lineas.push(`${etiqueta}: ${valor.trim()}`);
      }

      const destinatario = form.dataset.destinatario ?? '';
      const asunto = form.dataset.asunto ?? 'Mensaje desde la web';
      const cuerpo = `${lineas.join('\n')}\n\n---\nEnviado desde dstunja.com`;

      /*
       * Evento `envio_contacto`: la persona dio a enviar y se le abre el gestor
       * de correo. Solo viaja qué formulario fue; nada de lo que escribió, que
       * es justo lo que este componente mete en el cuerpo del correo.
       *
       * OJO: esto mide la intención, no la entrega. El mensaje sale del gestor
       * de correo de la persona, y desde aquí no hay forma de saber si acabó
       * pulsando enviar allí.
       */
      registrarEvento('envio_contacto', {
        formulario: form.dataset.medicion ?? 'contacto',
      });

      const aviso = form.querySelector<HTMLElement>('[data-aviso]');
      if (aviso) {
        aviso.textContent =
          'Abrimos tu gestor de correo con la solicitud lista para enviar. Si no se abrió, escríbenos por WhatsApp.';
        aviso.classList.remove('hidden');
      }

      window.location.href =
        `mailto:${destinatario}` +
        `?subject=${encodeURIComponent(asunto)}` +
        `&body=${encodeURIComponent(cuerpo)}`;
    });
  });
</script>
