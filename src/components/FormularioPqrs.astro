---
/**
 * Formulario de radicación de PQRS. Sirve SOLO a la categoría comercial.
 *
 * LA ADMINISTRATIVA NO PASA POR AQUÍ. Antes sí: compartían formulario y la
 * administrativa salía por un `mailto:` al pulsar enviar. Hoy esa categoría ni
 * siquiera enseña el paso 2 —muestra el bloque de contacto de
 * ContactoAdministrativo.astro, con el teléfono y el correo—, así que este
 * componente se quedó con un solo camino. Si alguna vez vuelve a haber más de
 * uno, el interruptor es `via` en src/lib/pqrs/categorias.ts.
 *
 * EL FLUJO, que es largo:
 *   1. Si hay archivos, se sube cada uno DIRECTAMENTE a Vercel Blob con
 *      `upload()`. No pasan por la función: una función de Vercel rechaza
 *      cuerpos de más de 4,5 MB y el tope por archivo es 5 MB.
 *   2. Se manda el resto del formulario a /api/pqrs como JSON, con las rutas de
 *      los blobs ya subidos.
 *   3. Se enseña el radicado y la fecha, con botón de copiar.
 *
 * RESPALDO. Si la API no contesta (red caída, o el sitio servido desde un
 * espejo estático sin funciones) se cae a un `mailto:`, pero con un aviso claro
 * de que eso NO es una radicación y de que los archivos hay que adjuntarlos a
 * mano; queda marcado en el DOM como `data-respaldo`. Un error 400 o 403 no
 * activa el respaldo: ahí la API sí contestó y lo que hay que hacer es enseñar
 * el motivo.
 */
import { empresa } from '../data/site';
import Icono from './Icono.astro';
import LoaderDST from './LoaderDST.astro';

interface Props {
  boton?: string;
  /** Correo del respaldo, cuando la API falla. */
  destinatario?: string;
}

const { boton = 'Enviar PQRS', destinatario = empresa.email } = Astro.props;

const claveTurnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<div
  data-pqrs
  data-turnstile-key={claveTurnstile}
  data-destinatario={destinatario}
>
  <form data-form class="grid grid-cols-1 gap-5" novalidate={false}>
    <slot />

    <!-- Turnstile en modo `interaction-only`: normalmente no se ve nada. -->
    <div data-turnstile class="empty:hidden"></div>

    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" class="btn btn-primary" data-enviar>{boton}</button>
      {/*
        Espera del envio. Solo aparece si la radicacion tarda mas de 150 ms:
        por debajo de eso el logotipo seria un destello que estorba mas de lo
        que informa. El boton, mientras tanto, va contando por su cuenta en
        que paso esta ("Subiendo archivos...", "Radicando...").
      */}
      <div data-espera class="hidden" role="status" aria-live="polite">
        <LoaderDST tamano={28} anuncia={false} />
        <span class="sr-only">Enviando...</span>
      </div>
      {/*
        El `href` se reescribe con lo que se lleve escrito (ver `pintarWhatsapp`).
        El valor que sale del servidor es el número pelado, sin texto: es lo que
        queda si el JavaScript no llega a ejecutarse, y sigue sirviendo.
      */}
      <a
        class="btn btn-secondary"
        href={empresa.whatsapp}
        target="_blank"
        rel="noopener"
        data-whatsapp
        data-base={empresa.whatsapp}
      >
        Prefiero WhatsApp
      </a>
    </div>

    <!-- Progreso de subida, una fila por archivo -->
    <ul data-progreso class="m-0 hidden list-none space-y-2 p-0"></ul>

    <!-- Errores devueltos por el servidor -->
    <div
      data-errores
      class="hidden rounded-xl border border-accent-text/30 bg-accent-soft px-4 py-3"
      role="alert"
    >
      <p class="m-0 mb-1 font-display text-[14px] font-semibold text-accent-text">
        No pudimos radicar tu solicitud
      </p>
      <ul data-lista-errores class="m-0 list-disc space-y-1 pl-5 text-[14px] text-ink"></ul>
    </div>

    <p data-aviso class="m-0 hidden text-[14.5px]" role="status" aria-live="polite"></p>
  </form>

  <!-- Pantalla de confirmación -->
  <div data-confirmacion class="hidden" role="status" aria-live="polite">
    <span class="icono-chip mb-5 h-12 w-12">
      <Icono nombre="circle-check" class="h-6 w-6" interactivo={false} />
    </span>
    <h3 class="mb-2 text-[22px]">Radicamos tu solicitud</h3>
    {/*
      "También te lo enviamos por correo" solo se dice si es verdad. Con el
      remitente de pruebas de Resend la constancia no sale (solo entrega al
      titular de la cuenta) y el servidor lo indica con `constancia`.
    */}
    <p class="mb-6 text-muted">
      Guarda este número: con él puedes hacer seguimiento.<span data-constancia-enviada>
        También te lo enviamos por correo.</span
      >
    </p>

    <div class="mb-6 rounded-xl border border-line bg-fondo p-5">
      <p class="kicker mb-2">Número de radicado</p>
      <div class="flex flex-wrap items-center gap-3">
        <code
          data-radicado
          class="font-display text-[22px] font-bold tracking-[0.04em] text-primary"></code>
        <button type="button" class="btn btn-secondary px-4 py-2 text-[13.5px]" data-copiar>
          Copiar
        </button>
      </div>
      <p class="kicker mt-5 mb-2">Fecha de radicación</p>
      <p data-fecha class="m-0 text-[15px]"></p>
    </div>

    <p class="m-0 text-[14.5px] text-muted">
      Respondemos en un plazo máximo de 15 días hábiles.
    </p>
    <p data-avisos-envio class="mt-4 mb-0 hidden text-[13.5px] text-accent-text"></p>
  </div>


</div>

<script>
  import { upload } from '@vercel/blob/client';
  import { extensionDe, nombreParaMostrar, formatearTamano } from '../lib/adjuntos';
  import { ruta } from '../lib/rutas';
  import { prepararTurnstile, tokenTurnstile } from '../lib/turnstile-cliente';
  import { asuntoDe, categoriaDe } from '../lib/pqrs/categorias';

  /**
   * La ruta pasa por `ruta()` como todas las del sitio. Escrita a mano
   * ("/api/pqrs/token") apuntaba a la raíz del dominio, que en el espejo de
   * GitHub Pages —publicado bajo /proyecto_paginaWeb— es una dirección que no
   * existe.
   */
  const RUTA_TOKEN = ruta('/api/pqrs/token');

  /** Códigos que devuelve /api/pqrs/token. Ver src/lib/pqrs/errores.ts. */
  type CodigoError =
    | 'config-incompleta'
    | 'cuerpo-invalido'
    | 'sesion-invalida'
    | 'ruta-ajena'
    | 'tipo-invalido'
    | 'archivo-no-permitido'
    | 'antirrobots'
    | 'demasiadas-peticiones';

  /**
   * Fallo al subir un soporte, con el código que dio el servidor.
   *
   * El código es lo que permite decidir después: si el servicio no está
   * configurado no tiene sentido pedirle a la persona que lo intente otra vez,
   * hay que ofrecerle el respaldo por correo.
   */
  class ErrorDeSubida extends Error {
    constructor(
      readonly nombreArchivo: string,
      readonly motivo: string,
      readonly codigo?: CodigoError,
    ) {
      super(`No pudimos subir «${nombreArchivo}»: ${motivo}`);
      this.name = 'ErrorDeSubida';
    }
  }

  /** Campo del formulario -> clave del JSON que espera /api/pqrs. */
  const CAMPOS: Record<string, string> = {
    'tipo-pqrs': 'tipo',
    'nombre-pqrs': 'nombre',
    'documento-pqrs': 'documento',
    'telefono-pqrs': 'telefono',
    'correo-pqrs': 'correo',
    'municipio-pqrs': 'municipio',
    'descripcion-pqrs': 'descripcion',
  };

  interface AdjuntoSubido {
    url: string;
    pathname: string;
    nombreOriginal: string;
    tamano: number;
  }

  document.querySelectorAll<HTMLElement>('[data-pqrs]').forEach((raiz) => {
    const form = raiz.querySelector<HTMLFormElement>('[data-form]');
    const cajaTurnstile = raiz.querySelector<HTMLElement>('[data-turnstile]');
    const progreso = raiz.querySelector<HTMLUListElement>('[data-progreso]');
    const cajaErrores = raiz.querySelector<HTMLElement>('[data-errores]');
    const listaErrores = raiz.querySelector<HTMLUListElement>('[data-lista-errores]');
    const aviso = raiz.querySelector<HTMLElement>('[data-aviso]');
    const confirmacion = raiz.querySelector<HTMLElement>('[data-confirmacion]');
    const botonEnviar = raiz.querySelector<HTMLButtonElement>('[data-enviar]');
    const cajaEspera = raiz.querySelector<HTMLElement>('[data-espera]');
    if (!form || !cajaTurnstile || !progreso || !cajaErrores || !listaErrores) return;
    if (!aviso || !confirmacion || !botonEnviar) return;

    const claveTurnstile = raiz.dataset.turnstileKey ?? '';
    /*
     * Siempre privado, igual que `ACCESO_BLOB` en src/lib/pqrs/config.ts. El
     * store (pqrs-adjuntos) es privado y rechaza subidas públicas; antes esto
     * dependía de PUBLIC_PQRS_BLOB_ACCESS, que ya no existe.
     */
    const acceso = 'private' as const;
    const destinatario = raiz.dataset.destinatario ?? '';

    let turnstileListo = false;
    if (claveTurnstile) {
      prepararTurnstile(cajaTurnstile, claveTurnstile).then(
        () => {
          turnstileListo = true;
        },
        () => {
          turnstileListo = false;
        },
      );
    }

    /**
     * Token de Turnstile, o cadena vacía si el sitio no tiene clave configurada.
     *
     * Devolver vacío en vez de reventar hace que el error salga del servidor
     * ("la comprobación antirrobots no está configurada"), que es un mensaje
     * entendible, en lugar de caer al respaldo por correo sin explicar nada.
     */
    async function token(): Promise<string> {
      if (!claveTurnstile) return '';
      return tokenTurnstile();
    }

    // --- Pintado ------------------------------------------------------------

    function mostrarErrores(mensajes: string[]) {
      listaErrores!.textContent = '';
      for (const mensaje of mensajes) {
        const item = document.createElement('li');
        item.textContent = mensaje;
        listaErrores!.append(item);
      }
      cajaErrores!.classList.toggle('hidden', mensajes.length === 0);
      if (mensajes.length > 0) cajaErrores!.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function avisar(texto: string, tono: 'ok' | 'error' | 'neutro' = 'neutro') {
      aviso!.textContent = texto;
      aviso!.classList.toggle('hidden', texto === '');
      aviso!.classList.toggle('text-ok', tono === 'ok');
      aviso!.classList.toggle('text-accent-text', tono === 'error');
      aviso!.classList.toggle('text-muted', tono === 'neutro');
    }

    /** Una fila de progreso por archivo; devuelve cómo actualizarla. */
    function filaProgreso(nombre: string, tamano: number) {
      const fila = document.createElement('li');
      fila.className = 'rounded-xl border border-line bg-fondo px-3 py-2';

      const cabecera = document.createElement('div');
      cabecera.className = 'flex items-baseline justify-between gap-3';

      const etiqueta = document.createElement('span');
      etiqueta.className = 'truncate text-[14px] font-semibold text-ink';
      etiqueta.textContent = nombre;

      const estado = document.createElement('span');
      estado.className = 'shrink-0 text-[12.5px] text-muted';
      estado.textContent = `0 % · ${formatearTamano(tamano)}`;

      cabecera.append(etiqueta, estado);

      const canal = document.createElement('div');
      canal.className = 'mt-2 h-1.5 overflow-hidden rounded-full bg-surface-2';
      const barra = document.createElement('div');
      barra.className = 'h-full w-0 rounded-full bg-secondary transition-all duration-200';
      canal.append(barra);

      fila.append(cabecera, canal);
      progreso!.append(fila);
      progreso!.classList.remove('hidden');

      /**
       * El SDK puede emitir un último `onUploadProgress` DESPUÉS de que la
       * subida haya resuelto, y ese aviso tardío repintaba "100 %" encima del
       * "Subido" que ya se había puesto. La fila se quedaba en verde pero sin
       * decir que había terminado. Una vez cerrada, no se vuelve a tocar.
       */
      let cerrada = false;

      return {
        avanzar(porcentaje: number) {
          if (cerrada) return;
          barra.style.width = `${porcentaje}%`;
          estado.textContent = `${Math.round(porcentaje)} % · ${formatearTamano(tamano)}`;
        },
        terminar() {
          cerrada = true;
          barra.style.width = '100%';
          barra.classList.remove('bg-secondary');
          barra.classList.add('bg-ok');
          estado.textContent = `Subido · ${formatearTamano(tamano)}`;
        },
        fallar() {
          cerrada = true;
          barra.classList.remove('bg-secondary');
          barra.classList.add('bg-accent');
          estado.textContent = 'No se pudo subir';
        },
      };
    }

    // --- Envío --------------------------------------------------------------

    function datosDelFormulario() {
      const datos = new FormData(form!);
      const cuerpo: Record<string, unknown> = {};
      for (const [campo, clave] of Object.entries(CAMPOS)) {
        const valor = datos.get(campo);
        cuerpo[clave] = typeof valor === 'string' ? valor : '';
      }
      cuerpo.autorizacion = datos.get('autorizacion-pqrs') !== null;
      return cuerpo;
    }

    function archivosElegidos(): File[] {
      const entrada = form!.querySelector<HTMLInputElement>('[data-adjuntos] [data-entrada]');
      if (!entrada || entrada.disabled) return [];
      return Array.from(entrada.files ?? []);
    }

    /**
     * Le vuelve a preguntar al endpoint POR QUÉ falló, para poder decírselo a
     * la persona en vez de enseñarle el mensaje del SDK.
     *
     * Va con el token de Turnstile VACÍO a propósito. Un token del widget es de
     * un solo uso, así que gastar uno bueno en una consulta de diagnóstico
     * dejaría sin él al reintento de verdad. Y no hace falta: el endpoint
     * comprueba configuración, sesión, ruta, tipo de PQRS y extensión ANTES que
     * Turnstile, así que todos esos motivos se reciben igual. Si lo que
     * responde es 403, el problema era justamente el antirrobots.
     *
     * Devuelve `null` si no consigue una respuesta útil; entonces se muestra el
     * mensaje que traía el SDK, que es mejor que nada.
     */
    async function motivoDelFallo(
      rutaBlob: string,
      sessionId: string,
      tipo: string,
    ): Promise<{ codigo: CodigoError; mensaje: string } | null> {
      try {
        const respuesta = await fetch(RUTA_TOKEN, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            type: 'blob.generate-client-token',
            payload: {
              pathname: rutaBlob,
              clientPayload: JSON.stringify({ sessionId, tipo, turnstileToken: '' }),
              multipart: false,
            },
          }),
        });

        // Un espejo estático sin funciones devuelve HTML, no JSON.
        const tipoRespuesta = respuesta.headers.get('content-type') ?? '';
        if (!tipoRespuesta.includes('application/json')) return null;

        const datos = (await respuesta.json()) as
          | { ok: false; codigo: CodigoError; mensaje: string }
          | Record<string, unknown>;

        if (datos && (datos as { ok?: unknown }).ok === false) {
          const { codigo, mensaje } = datos as { codigo: CodigoError; mensaje: string };
          if (typeof mensaje === 'string' && mensaje !== '') return { codigo, mensaje };
        }
      } catch {
        // La red se cayó entre medias: nos quedamos con el mensaje del SDK.
      }
      return null;
    }

    async function subirArchivos(sessionId: string, tipo: string): Promise<AdjuntoSubido[]> {
      const archivos = archivosElegidos();
      if (archivos.length === 0) return [];

      progreso!.textContent = '';
      const subidos: AdjuntoSubido[] = [];

      for (const archivo of archivos) {
        const nombre = nombreParaMostrar(archivo.name);
        const barra = filaProgreso(nombre, archivo.size);
        // La ruta la propone el navegador pero el servidor la comprueba contra
        // la sesión: el UUID solo sirve para no chocar entre archivos.
        const rutaBlob = `pqrs/pendientes/${sessionId}/${crypto.randomUUID()}${extensionDe(archivo.name)}`;

        try {
          const resultado = await upload(rutaBlob, archivo, {
            access: acceso,
            handleUploadUrl: RUTA_TOKEN,
            contentType: archivo.type || undefined,
            clientPayload: JSON.stringify({
              sessionId,
              tipo,
              turnstileToken: await token(),
            }),
            onUploadProgress: ({ percentage }) => barra.avanzar(percentage),
          });
          barra.terminar();
          subidos.push({
            url: resultado.url,
            pathname: resultado.pathname,
            nombreOriginal: nombre,
            tamano: archivo.size,
          });
        } catch (fallo) {
          barra.fallar();
          const mensajeSdk = (fallo as Error).message ?? '';

          // El SDK solo mira si la respuesta fue 2xx: cuando no lo es, tira
          // "Failed to retrieve the client token" y se traga el motivo que
          // había dentro. Se lo volvemos a preguntar al servidor.
          if (/client token/i.test(mensajeSdk)) {
            const motivo = await motivoDelFallo(rutaBlob, sessionId, tipo);
            if (motivo) throw new ErrorDeSubida(nombre, motivo.mensaje, motivo.codigo);
          }

          throw new ErrorDeSubida(nombre, mensajeSdk);
        }
      }

      return subidos;
    }

    // --- Envíos por correo ----------------------------------------------------

    /**
     * Valor de un campo del formulario por su id. Sirve igual para los ocultos
     * que alimentan las tarjetas de arriba y para el municipio, que es visible.
     */
    function valorDe(id: string): string {
      return (form!.querySelector<HTMLInputElement>(`#${id}`)?.value ?? '').trim();
    }

    /**
     * Lo que la persona escribió, en líneas legibles para el cuerpo del correo.
     *
     * La categoría y el tipo se añaden A MANO porque viven en campos ocultos y
     * el recorrido de abajo solo mira los `label[for]`: sin estas dos líneas el
     * correo llegaría sin decir de qué trata la solicitud.
     */
    function lineasDelFormulario(): string[] {
      const datos = new FormData(form!);
      const lineas: string[] = [];

      const categoria = categoriaDe(valorDe('categoria-pqrs'));
      if (categoria) lineas.push(`Categoría: ${categoria.nombre}`);
      const tipo = valorDe('tipo-pqrs');
      if (tipo) lineas.push(`Tipo de solicitud: ${tipo}`);

      form!.querySelectorAll<HTMLLabelElement>('label[for]').forEach((label) => {
        const valor = datos.get(label.htmlFor);
        if (typeof valor !== 'string' || valor.trim() === '') return;
        lineas.push(`${label.textContent?.replace(/\*/g, '').trim()}: ${valor.trim()}`);
      });

      return lineas;
    }

    /**
     * Mantiene al día el enlace de "Prefiero WhatsApp" con lo que se lleve
     * escrito, para que el asesor no tenga que volver a preguntarlo todo.
     *
     * QUÉ VIAJA Y QUÉ NO. Categoría, tipo, municipio, nombre y el relato, que es
     * lo que sirve para atender. NO van el documento de identidad, el teléfono
     * ni el correo: WhatsApp ya trae el teléfono de quien escribe, y meter un
     * número de cédula en el texto de un enlace es esparcirla sin necesidad.
     *
     * La descripción se recorta: `wa.me` no documenta ningún tope, así que se
     * elige uno conservador antes que arriesgarse a que la app corte el mensaje
     * por la mitad o no abra.
     */
    function pintarWhatsapp() {
      const enlace = raiz.querySelector<HTMLAnchorElement>('[data-whatsapp]');
      if (!enlace) return;

      const base = enlace.dataset.base ?? '';
      const categoria = categoriaDe(valorDe('categoria-pqrs'))?.nombre ?? '';
      const descripcion = valorDe('descripcion-pqrs');

      const lineas = [
        ['Categoría', categoria],
        ['Tipo', valorDe('tipo-pqrs')],
        ['Municipio', valorDe('municipio-pqrs')],
        ['Nombre', valorDe('nombre-pqrs')],
      ]
        .filter(([, valor]) => valor !== '')
        .map(([etiqueta, valor]) => `${etiqueta}: ${valor}`);

      if (descripcion !== '') {
        const recortada =
          descripcion.length > 900 ? `${descripcion.slice(0, 900)}…` : descripcion;
        lineas.push('', recortada);
      }

      // Sin nada escrito todavía, un saludo normal es mejor que un mensaje
      // vacío o que una plantilla con los huecos a la vista.
      const texto =
        lineas.length > 0
          ? ['Hola, quiero hablar sobre una PQRS.', '', ...lineas].join('\n')
          : 'Hola, quiero radicar una PQRS.';

      enlace.href = `${base}?text=${encodeURIComponent(texto)}`;
    }

    // Se repinta con cualquier cambio del formulario: los campos de texto
    // emiten `input` y los ocultos de las tarjetas emiten `change`.
    form.addEventListener('input', pintarWhatsapp);
    form.addEventListener('change', pintarWhatsapp);
    pintarWhatsapp();

    /**
     * Abre el gestor de correo. Se llama SIEMPRE al final, después de haber
     * pintado el aviso y anotado el marcador en el DOM: la navegación a un
     * `mailto:` cede el control al sistema operativo y lo que venga detrás
     * puede no llegar a ejecutarse.
     */
    function abrirCorreo(destino: string, asunto: string, lineas: string[]) {
      const cuerpo = `${lineas.join('\n')}\n\n---\nEnviado desde dstunja.com`;
      window.location.href =
        `mailto:${destino}?subject=${encodeURIComponent(asunto)}` +
        `&body=${encodeURIComponent(cuerpo)}`;
    }

    /**
     * Respaldo cuando la radicación falla. NO es una radicación y así se dice:
     * sin número, sin constancia y con los archivos por adjuntar a mano.
     */
    function caerAlCorreo(motivo: string) {
      const lineas = lineasDelFormulario();

      const archivos = archivosElegidos().map((a) => nombreParaMostrar(a.name));
      if (archivos.length > 0) {
        lineas.push('', `Archivos de soporte (${archivos.length}):`);
        archivos.forEach((n) => lineas.push(`  - ${n}`));
        lineas.push('IMPORTANTE: adjunta estos archivos al correo antes de enviarlo.');
      }

      avisar(
        `${motivo} Abrimos tu gestor de correo con la solicitud. Ojo: así NO queda radicada ` +
          'con número, y los archivos tienes que adjuntarlos tú.',
        'error',
      );
      // Queda anotado en el DOM que se usó el respaldo: lo comprueba
      // scripts/verificar-pqrs.mjs, porque el navegador no emite ningún evento
      // observable al abrir un mailto:.
      raiz.dataset.respaldo = 'correo';

      abrirCorreo(
        destinatario,
        asuntoDe({
          categoria: valorDe('categoria-pqrs'),
          tipo: valorDe('tipo-pqrs'),
          municipio: valorDe('municipio-pqrs'),
        }),
        lineas,
      );
    }

    /**
     * Qué pasó con los correos, según /api/pqrs.
     *
     * Antes llegaba una lista `avisos` con los motivos técnicos y se pintaba tal
     * cual: la persona podía leer «Falta RESEND_API_KEY.» o el inglés de Resend.
     * Ahora el servidor solo dice QUÉ no salió y aquí se explica en llano. Si no
     * viene (una versión anterior de la API, o la prueba), se asume que todo salió.
     */
    interface EstadoCorreos {
      correoArea?: boolean;
      constancia?: 'enviada' | 'omitida' | 'fallida';
    }

    function mostrarConfirmacion(radicado: string, fecha: string, correos: EstadoCorreos) {
      form!.classList.add('hidden');
      confirmacion!.classList.remove('hidden');
      confirmacion!.querySelector('[data-radicado]')!.textContent = radicado;
      confirmacion!.querySelector('[data-fecha]')!.textContent = fecha;

      const constancia = correos.constancia ?? 'enviada';
      confirmacion!
        .querySelector<HTMLElement>('[data-constancia-enviada]')
        ?.classList.toggle('hidden', constancia !== 'enviada');
      raiz.dataset.constancia = constancia;

      const mensajes: string[] = [];
      if (correos.correoArea === false) {
        mensajes.push(
          'Tu solicitud quedó radicada, pero no pudimos avisar al equipo por correo. ' +
            'Si en unos días no te contactamos, escríbenos por WhatsApp citando el número.',
        );
      }
      if (constancia !== 'enviada') {
        mensajes.push(
          'No te enviamos el número por correo: cópialo o anótalo antes de salir de esta página.',
        );
      }

      const cajaAvisos = confirmacion!.querySelector<HTMLElement>('[data-avisos-envio]');
      if (cajaAvisos) {
        cajaAvisos.textContent = mensajes.join(' ');
        cajaAvisos.classList.toggle('hidden', mensajes.length === 0);
      }
      confirmacion!.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // --- Espera del envio ---------------------------------------------------

    let temporizadorEspera: number | undefined;

    /** Enciende el logotipo, pero solo si el envio se hace esperar. */
    function mostrarEspera() {
      clearTimeout(temporizadorEspera);
      temporizadorEspera = window.setTimeout(() => {
        cajaEspera?.classList.remove('hidden');
      }, 150);
    }

    /**
     * Lo apaga. Se llama desde el `finally` del envio, que corre tanto si la
     * radicacion sale bien como si falla o se cae la red: asi el logotipo no
     * se queda dando vueltas para siempre. El `clearTimeout` es lo que evita
     * que aparezca DESPUES de haber terminado, cuando la respuesta llego
     * antes de los 150 ms.
     */
    function ocultarEspera() {
      clearTimeout(temporizadorEspera);
      cajaEspera?.classList.add('hidden');
    }

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!form.reportValidity()) return;

      mostrarErrores([]);

      const clave = valorDe('categoria-pqrs');
      const tipoElegido = valorDe('tipo-pqrs');
      const categoria = categoriaDe(clave);

      // El formulario solo se muestra con las dos cosas ya elegidas. Esto es la
      // red por si alguien llega con el bloque visible de otra manera.
      if (!categoria || !tipoElegido) {
        mostrarErrores(['Elige arriba la categoría y el tipo de solicitud.']);
        return;
      }

      /*
       * Este formulario solo radica. La administrativa no llega hasta aquí
       * —enseña el bloque de contacto y esconde esta sección entera—, pero si
       * alguien fuerza el DOM para que llegue, mejor decírselo que mandarle a
       * /api/pqrs una solicitud que el servidor guardaría como comercial.
       */
      if (categoria.via !== 'radicacion') {
        mostrarErrores([
          'Esta categoría no se radica en línea. Vuelve arriba y elige la categoría comercial, o escríbenos por los datos de contacto.',
        ]);
        return;
      }

      botonEnviar.disabled = true;
      const textoBoton = botonEnviar.textContent;
      mostrarEspera();

      try {
        if (claveTurnstile && !turnstileListo) {
          // Un último intento: puede que el script tardara más que la persona.
          await prepararTurnstile(cajaTurnstile, claveTurnstile);
          turnstileListo = true;
        }

        const cuerpo = datosDelFormulario();
        const sessionId = crypto.randomUUID();

        botonEnviar.textContent = 'Subiendo archivos…';
        avisar('Subiendo los archivos de soporte…');
        const adjuntos = await subirArchivos(sessionId, String(cuerpo.tipo ?? ''));

        botonEnviar.textContent = 'Radicando…';
        avisar('Radicando tu solicitud…');

        const respuesta = await fetch('/api/pqrs', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            ...cuerpo,
            sessionId,
            turnstileToken: await token(),
            adjuntos,
          }),
        });

        // Un espejo estático sin funciones devuelve HTML, no JSON.
        const tipoRespuesta = respuesta.headers.get('content-type') ?? '';
        if (!tipoRespuesta.includes('application/json')) {
          caerAlCorreo('La radicación en línea no está disponible en esta dirección.');
          return;
        }

        const datos = (await respuesta.json()) as
          | ({ ok: true; radicado: string; fecha: string } & EstadoCorreos)
          | { ok: false; errores: string[]; codigo?: string };

        if (respuesta.ok && datos.ok) {
          avisar('');
          mostrarConfirmacion(datos.radicado, datos.fecha, datos);
          return;
        }

        // 503 config-incompleta: al servidor le falta el Blob o la clave de
        // Resend. Se dice con claridad y se ofrece el correo; reintentar no
        // arreglaría nada.
        if (!datos.ok && datos.codigo === 'config-incompleta') {
          raiz.dataset.configuracion = 'incompleta';
          caerAlCorreo('La radicación en línea no está disponible en este momento.');
          return;
        }

        if (respuesta.status >= 500) {
          caerAlCorreo('El servidor no pudo procesar la radicación.');
          return;
        }

        // 400, 403, 429: la API contestó y explicó por qué. No hay respaldo que
        // valga; hay que corregir lo que dice y volver a enviar.
        avisar('');
        mostrarErrores(datos.ok ? ['Error desconocido.'] : datos.errores);
      } catch (fallo) {
        if (fallo instanceof ErrorDeSubida) {
          // Si el servicio de adjuntos no está configurado, insistir no sirve
          // de nada: lo único que puede hacer la persona es escribirnos.
          if (fallo.codigo === 'config-incompleta') {
            caerAlCorreo(fallo.motivo);
            return;
          }
          // El resto sí los puede corregir quien radica (cambiar el archivo,
          // cambiar el tipo, recargar para renovar el antirrobots).
          avisar('');
          mostrarErrores([fallo.message]);
          return;
        }
        caerAlCorreo('No pudimos conectar con el servidor.');
      } finally {
        ocultarEspera();
        botonEnviar.disabled = false;
        botonEnviar.textContent = textoBoton;
      }
    });

    // --- Copiar el radicado -------------------------------------------------
    confirmacion.querySelector<HTMLButtonElement>('[data-copiar]')?.addEventListener(
      'click',
      async (evento) => {
        const boton = evento.currentTarget as HTMLButtonElement;
        const radicado = confirmacion.querySelector('[data-radicado]')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(radicado);
          boton.textContent = 'Copiado';
        } catch {
          boton.textContent = 'Cópialo a mano';
        }
        setTimeout(() => {
          boton.textContent = 'Copiar';
        }, 2000);
      },
    );
  });
</script>
