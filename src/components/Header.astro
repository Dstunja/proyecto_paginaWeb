---
import { navegacion } from '../data/site';
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { ruta, esActual } from '../lib/rutas';

/** Ruta actual, para marcar el enlace activo (descuenta el `base`). */
const actual = Astro.url.pathname;

/**
 * El botón "Haz tu pedido" lleva a /pedido/, no a WhatsApp: ahora existe una
 * página que hace exactamente lo que promete, y desde ella se sigue llegando a
 * WhatsApp con la lista ya escrita. WhatsApp directo queda a un toque en el
 * botón flotante y en el pie de página.
 *
 * El carrito no se suma a `navegacion` a propósito: el menú horizontal aparece
 * a 1100 px y con siete enlaces ya va justo. Va como botón de ícono, que
 * además es donde se espera encontrar el contador y se ve igual en móvil.
 */
const enPedido = esActual('/pedido/', actual);
---

{/* Barra fija de vidrio esmerilado: el contenido se desliza por debajo.
    La altura vive en --nav-h (global.css) y `main` reserva ese espacio. */}
<header class="barra-fija fixed inset-x-0 top-0 z-[100]">
  <div class="wrap flex h-[var(--nav-h)] items-center justify-between gap-6">
    <Logo href={ruta('/')} />

    <nav
      id="main-nav"
      class="barra-fija invisible absolute inset-x-0 top-full z-40 flex -translate-y-[130%] flex-col bg-canvas
             items-start gap-5 px-6 py-6 opacity-0
             shadow-[0_18px_40px_rgba(13,44,132,.12)]
             transition-[transform,opacity,visibility] duration-300 ease-out
             data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100
             nav:static nav:visible nav:z-auto nav:translate-y-0 nav:flex-row
             nav:items-center nav:gap-6 [@media(min-width:1250px)]:gap-8 nav:border-0 nav:bg-transparent nav:p-0
             nav:opacity-100 nav:shadow-none nav:backdrop-blur-none nav:transition-none"
      data-open="false"
    >
      {
        navegacion.map((item) => {
          const activo = esActual(item.href, actual);
          return (
            <a
              href={ruta(item.href)}
              aria-current={activo ? 'page' : undefined}
              class:list={[
                'relative py-1 font-display text-[13px] font-semibold tracking-[0.08em] uppercase transition-colors duration-200 hover:text-secondary-dark',
                activo
                  ? "text-ink after:absolute after:inset-x-0 after:-bottom-1 after:h-[2px] after:rounded-full after:bg-accent after:content-['']"
                  : 'text-muted',
              ]}
            >
              {item.texto}
            </a>
          );
        })
      }

      {/* En el menú desplegable el pedido va con su nombre completo: el botón
          de ícono de la barra no dice a dónde lleva. */}
      <a
        href={ruta('/pedido/')}
        class="btn btn-primary w-full !py-2.5 !text-[12.5px] tracking-[0.08em] uppercase nav:hidden"
      >
        <Icono nombre="shopping-cart" class="h-4 w-4" />
        Arma tu pedido
      </a>
    </nav>

    <div class="flex items-center gap-1.5 nav:gap-3">
      {/* Carrito con el total de unidades. Se ve en todos los anchos: es el
          único indicador de que hay un pedido a medio armar. En /pedido/ el
          script del panel intercepta el clic y lo abre sin recargar. */}
      <a
        href={ruta('/pedido/')}
        data-abrir-pedido={enPedido ? '' : undefined}
        aria-haspopup={enPedido ? 'dialog' : undefined}
        class="group relative grid h-11 w-11 place-items-center rounded-full text-ink transition-colors duration-200 hover:bg-secondary-soft hover:text-primary"
        aria-label="Ver mi pedido"
      >
        <Icono nombre="shopping-cart" class="h-[22px] w-[22px]" />
        <span
          class="absolute -top-0.5 -right-0.5 min-w-[20px] rounded-full bg-accent px-1.5 py-0.5 text-center font-display text-[11px] leading-tight font-bold text-ink-dark"
          data-total-unidades
          data-contador-barra
          hidden>0</span
        >
      </a>

      <a
        class="btn btn-primary hidden whitespace-nowrap !px-5 !py-2.5 !text-[12.5px] tracking-[0.08em] uppercase nav:inline-flex"
        href={ruta('/pedido/')}
      >
        Haz tu pedido
        <Icono nombre="arrow-right" class="h-4 w-4" />
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="group flex flex-col gap-[5px] rounded-full p-2.5 transition-colors duration-200 hover:bg-secondary-soft nav:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="block h-0.5 w-[22px] rounded-full bg-ink transition-colors duration-200"></span>
        <span class="block h-0.5 w-[22px] rounded-full bg-ink transition-colors duration-200"></span>
        <span class="block h-0.5 w-[22px] rounded-full bg-ink transition-colors duration-200"></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { alCambiarPedido, leerPedido, totalUnidades, type Pedido } from '../lib/carrito';

  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const abierto = nav.dataset.open !== 'true';
      nav.dataset.open = String(abierto);
      toggle.setAttribute('aria-expanded', String(abierto));
      toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    });

    // Cerrar al navegar dentro de la misma página (anclas) o con Escape.
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        nav.dataset.open = 'false';
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.dataset.open === 'true') {
        nav.dataset.open = 'false';
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }

  /**
   * Contador del carrito. Vive en la barra, así que se actualiza en todas las
   * páginas: el pedido se guarda en el navegador y sigue ahí al navegar.
   */
  const contador = document.querySelector<HTMLElement>('[data-contador-barra]');
  const enlaceCarrito = contador?.closest('a');

  if (contador && enlaceCarrito) {
    const pintar = (pedido: Pedido) => {
      const total = totalUnidades(pedido);
      contador.textContent = String(total);
      contador.hidden = total === 0;
      enlaceCarrito.setAttribute(
        'aria-label',
        total === 0
          ? 'Ver mi pedido (vacío)'
          : `Ver mi pedido: ${total} ${total === 1 ? 'unidad' : 'unidades'}`,
      );
    };

    pintar(leerPedido());
    alCambiarPedido(pintar);
  }
</script>
