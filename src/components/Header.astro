---
import { navegacion, empresa } from '../data/site';
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { ruta, esActual } from '../lib/rutas';

/** Ruta actual, para marcar el enlace activo (descuenta el `base`). */
const actual = Astro.url.pathname;
---

{/* Barra fija de vidrio esmerilado: el contenido se desliza por debajo.
    La altura vive en --nav-h (global.css) y `main` reserva ese espacio. */}
<header class="barra-fija fixed inset-x-0 top-0 z-[100]">
  <div class="wrap flex h-[var(--nav-h)] items-center justify-between gap-6">
    <Logo href={ruta('/')} />

    <button
      type="button"
      id="nav-toggle"
      class="group flex flex-col gap-[5px] rounded-full p-2.5 transition-colors duration-200 hover:bg-secondary-soft tablet:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="block h-0.5 w-[22px] rounded-full bg-ink transition-colors duration-200"></span>
      <span class="block h-0.5 w-[22px] rounded-full bg-ink transition-colors duration-200"></span>
      <span class="block h-0.5 w-[22px] rounded-full bg-ink transition-colors duration-200"></span>
    </button>

    <nav
      id="main-nav"
      class="barra-fija invisible absolute inset-x-0 top-full z-40 flex -translate-y-[130%] flex-col bg-canvas
             items-start gap-5 px-6 py-6 opacity-0
             shadow-[0_18px_40px_rgba(13,44,132,.12)]
             transition-[transform,opacity,visibility] duration-300 ease-out
             data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100
             tablet:static tablet:visible tablet:z-auto tablet:translate-y-0 tablet:flex-row
             tablet:items-center tablet:gap-8 tablet:border-0 tablet:bg-transparent tablet:p-0
             tablet:opacity-100 tablet:shadow-none tablet:backdrop-blur-none tablet:transition-none"
      data-open="false"
    >
      {
        navegacion.map((item) => {
          const activo = esActual(item.href, actual);
          return (
            <a
              href={ruta(item.href)}
              aria-current={activo ? 'page' : undefined}
              class:list={[
                'relative py-1 font-display text-[13px] font-semibold tracking-[0.08em] uppercase transition-colors duration-200 hover:text-secondary-dark',
                activo
                  ? "text-ink after:absolute after:inset-x-0 after:-bottom-1 after:h-[2px] after:rounded-full after:bg-accent after:content-['']"
                  : 'text-muted',
              ]}
            >
              {item.texto}
            </a>
          );
        })
      }
    </nav>

    <a
      class="btn btn-primary hidden !px-5 !py-2.5 !text-[12.5px] tracking-[0.08em] uppercase tablet:inline-flex"
      href={empresa.whatsapp}
      target="_blank"
      rel="noopener"
    >
      Haz tu pedido
      <Icono nombre="whatsapp" class="h-4 w-4" />
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const abierto = nav.dataset.open !== 'true';
      nav.dataset.open = String(abierto);
      toggle.setAttribute('aria-expanded', String(abierto));
      toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    });

    // Cerrar al navegar dentro de la misma página (anclas) o con Escape.
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        nav.dataset.open = 'false';
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.dataset.open === 'true') {
        nav.dataset.open = 'false';
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }
</script>
