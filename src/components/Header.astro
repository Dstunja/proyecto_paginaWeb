---
import { navegacion } from '../data/site';
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { ruta, esActual } from '../lib/rutas';

/** Ruta actual, para marcar el enlace activo (descuenta el `base`). */
const actual = Astro.url.pathname;

/**
 * "Arma tu pedido" es la acción principal del sitio y por eso vive fuera de la
 * navegación, como una PÍLDORA NARANJA a la derecha del menú, visible en todas
 * las páginas y en todos los anchos.
 *
 * No está en `navegacion` a propósito: entre siete enlaces de texto iguales, el
 * que importa se pierde. Y el naranja (#F5A623) es en este sitio el color de la
 * llamada destacada; el azul de la barra ya lo llevan el logo y los enlaces.
 *
 * La píldora ES TAMBIÉN EL CARRITO: lleva el total de unidades del pedido en
 * curso. Antes eran dos elementos separados —un botón "Haz tu pedido" y un
 * ícono de carrito— que apuntaban a la misma página, y en móvil se llevaban
 * entre los dos casi todo el espacio de la barra.
 *
 * En /pedido/ el script del panel intercepta el clic y abre el panel en vez de
 * recargar la página; por eso `data-abrir-pedido` solo se pone allí.
 */
const enPedido = esActual('/pedido/', actual);
---

{/* Barra fija de vidrio esmerilado: el contenido se desliza por debajo.
    La altura vive en --nav-h (global.css) y `main` reserva ese espacio. */}
<header class="barra-fija fixed inset-x-0 top-0 z-[100]">
  <div class="wrap flex h-[var(--nav-h)] items-center justify-between gap-3 nav:gap-6">
    <Logo variante="iso" href={ruta('/')} />

    {/* Menú. Bajo 1100 px es un panel a pantalla completa que se abre con la
        hamburguesa; a partir de ahí, la fila de enlaces de siempre. */}
    <nav
      id="main-nav"
      class="menu-movil bg-canvas nav:static nav:visible nav:h-auto nav:translate-y-0 nav:overflow-visible
             nav:bg-transparent nav:opacity-100 nav:transition-none"
      data-open="false"
      aria-label="Navegación principal"
    >
      <div
        class="flex h-full flex-col gap-1 overflow-y-auto px-6 pt-4 pb-10
               nav:h-auto nav:flex-row nav:items-center nav:gap-6 nav:overflow-visible nav:p-0
               [@media(min-width:1250px)]:gap-8"
      >
        {
          navegacion.map((item) => {
            const activo = esActual(item.href, actual);
            return (
              <a
                href={ruta(item.href)}
                aria-current={activo ? 'page' : undefined}
                class:list={[
                  'relative border-b border-line py-4 font-display text-[15px] font-semibold tracking-[0.06em] uppercase transition-colors duration-200 hover:text-secondary-dark',
                  'nav:border-0 nav:py-1 nav:text-[13px] nav:tracking-[0.08em]',
                  activo
                    ? "text-ink nav:after:absolute nav:after:inset-x-0 nav:after:-bottom-1 nav:after:h-[2px] nav:after:rounded-full nav:after:bg-accent nav:after:content-['']"
                    : 'text-muted',
                ]}
              >
                {item.texto}
              </a>
            );
          })
        }

        {/* La misma acción destacada, al final de la lista: en un menú abierto a
            pantalla completa la píldora de la barra queda tapada. */}
        <a
          href={ruta('/pedido/')}
          class="btn btn-accent mt-6 w-full !py-3 tracking-[0.08em] uppercase nav:hidden"
        >
          <Icono nombre="shopping-cart" class="h-[18px] w-[18px]" />
          Arma tu pedido
        </a>
      </div>
    </nav>

    <div class="flex items-center gap-1.5 nav:gap-3">
      {/* Acción principal + carrito, en un solo control. */}
      <a
        href={ruta('/pedido/')}
        data-abrir-pedido={enPedido ? '' : undefined}
        aria-haspopup={enPedido ? 'dialog' : undefined}
        class="btn btn-accent relative whitespace-nowrap !px-4 !py-2.5 !text-[12px] tracking-[0.06em] uppercase mob:!px-5 mob:!text-[12.5px] mob:tracking-[0.08em]"
      >
        <Icono nombre="shopping-cart" class="h-[18px] w-[18px]" />
        Arma tu pedido
        <span
          class="absolute -top-1 -right-1 min-w-[20px] rounded-full bg-primary px-1.5 py-0.5 text-center font-display text-[11px] leading-tight font-bold text-white"
          data-total-unidades
          data-contador-barra
          hidden>0</span
        >
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="group flex flex-col gap-[5px] rounded-full p-2.5 transition-colors duration-200 hover:bg-secondary-soft nav:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="block h-0.5 w-[22px] rounded-full bg-ink transition-colors duration-200"></span>
        <span class="block h-0.5 w-[22px] rounded-full bg-ink transition-colors duration-200"></span>
        <span class="block h-0.5 w-[22px] rounded-full bg-ink transition-colors duration-200"></span>
      </button>
    </div>
  </div>
</header>

<style>
  /**
   * Menú móvil: panel que ocupa la pantalla por debajo de la barra.
   *
   * Antes era un desplegable que crecía hacia abajo con los siete enlaces
   * apretados; en un teléfono no cabían y el último quedaba fuera de la
   * pantalla. Ahora ocupa todo el alto disponible, los enlaces van apilados con
   * separadores y, si aún así no cupieran, el panel se desplaza por dentro.
   *
   * `visibility` (y no solo `opacity`) saca su contenido del orden de
   * tabulación mientras está cerrado: sin eso, tabulando desde el logo se
   * pasaba por siete enlaces invisibles. El cambio de `visibility` no se
   * interpola: al cerrar se aplaza hasta que termina el desplazamiento y al
   * abrir ocurre de inmediato, para que el foco se pueda dar enseguida.
   */
  .menu-movil {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    /* Por encima de la barra fija del carrito (z-150, PanelPedido.astro): con
       el menú abierto esa barra tapaba su último enlace. Sigue por debajo del
       aviso de cookies (z-180) y del panel del pedido (z-200), que son
       diálogos y deben poder aparecer encima de todo. No hace falta pasar del
       z-100 de la barra superior porque el menú empieza justo debajo de ella y
       nunca se solapan. */
    z-index: 160;
    height: calc(100dvh - var(--nav-h));
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      transform 0.25s ease-out,
      opacity 0.25s ease-out,
      visibility 0s linear 0.25s;
  }

  .menu-movil[data-open='true'] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      transform 0.25s ease-out,
      opacity 0.25s ease-out,
      visibility 0s;
  }

  /* A partir de 1100 px vuelve a ser una fila normal dentro de la barra: se
     anula todo lo de arriba, incluido el `position: fixed`. */
  @media (min-width: 1100px) {
    .menu-movil {
      position: static;
      inset: auto;
      height: auto;
      overflow: visible;
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-movil {
      transition: none;
    }
  }
</style>

<script>
  import { alCambiarPedido, leerPedido, totalUnidades, type Pedido } from '../lib/carrito';

  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');

  if (toggle && nav) {
    /** Enlaces y botones del menú que pueden recibir el foco. */
    const enfocables = () => [
      ...nav.querySelectorAll<HTMLElement>('a[href], button:not(:disabled)'),
    ];

    const abrir = () => {
      nav.dataset.open = 'true';
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú');
      // El panel tapa la página: si no se bloquea, el fondo se desplaza detrás.
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => enfocables()[0]?.focus());
    };

    const cerrar = (devolverFoco = true) => {
      if (nav.dataset.open !== 'true') return;
      nav.dataset.open = 'false';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú');
      document.body.style.overflow = '';
      if (devolverFoco) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      if (nav.dataset.open === 'true') cerrar();
      else abrir();
    });

    // Al navegar se cierra: sin esto, volver atrás en el navegador deja el
    // menú abierto encima de la página nueva.
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) cerrar(false);
    });

    document.addEventListener('keydown', (e) => {
      if (nav.dataset.open !== 'true') return;

      if (e.key === 'Escape') {
        e.preventDefault();
        cerrar();
        return;
      }

      // Mientras el menú tapa la página, el foco no debe salirse de él.
      if (e.key === 'Tab') {
        const candidatos = [toggle, ...enfocables()];
        const primero = candidatos[0]!;
        const ultimo = candidatos[candidatos.length - 1]!;
        if (e.shiftKey && document.activeElement === primero) {
          e.preventDefault();
          ultimo.focus();
        } else if (!e.shiftKey && document.activeElement === ultimo) {
          e.preventDefault();
          primero.focus();
        }
      }
    });

    // Al pasar a escritorio el panel deja de existir como tal: si quedó abierto,
    // el `overflow: hidden` del body se quedaría pegado.
    const anchoEscritorio = window.matchMedia('(min-width: 1100px)');
    anchoEscritorio.addEventListener('change', (e) => {
      if (e.matches) cerrar(false);
    });
  }

  /**
   * Contador del carrito. Vive en la barra, así que se actualiza en todas las
   * páginas: el pedido se guarda en el navegador y sigue ahí al navegar.
   */
  const contador = document.querySelector<HTMLElement>('[data-contador-barra]');
  const enlaceCarrito = contador?.closest('a');

  if (contador && enlaceCarrito) {
    const pintar = (pedido: Pedido) => {
      const total = totalUnidades(pedido);
      contador.textContent = String(total);
      contador.hidden = total === 0;
      enlaceCarrito.setAttribute(
        'aria-label',
        total === 0
          ? 'Arma tu pedido'
          : `Arma tu pedido — llevas ${total} ${total === 1 ? 'unidad' : 'unidades'}`,
      );
    };

    pintar(leerPedido());
    alCambiarPedido(pintar);
  }
</script>
