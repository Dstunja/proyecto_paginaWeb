---
import { empresa } from '../data/site';

/**
 * Logo oficial de la marca.
 *
 * - `iso`: solo el isotipo. Es el que va en la barra. El nombre de la empresa
 *   NO se dibuja a su lado a propósito: el logotipo horizontal trae el texto
 *   dentro de la imagen y a 44 px de alto quedaba ilegible. El nombre sigue
 *   estando en el sitio como texto real —el <title> de cada página, los datos
 *   estructurados de BaseLayout.astro y el pie— que es donde de verdad cuenta
 *   para SEO y para un lector de pantalla. Sus alturas van atadas a `--nav-h`
 *   (global.css): 48 px mientras la barra mide 64 px y 56 px cuando sube a
 *   80 px, para que siempre quede aire arriba y abajo. Si cambia una, revisar
 *   la otra.
 * - `claro`: el isotipo dentro de una pastilla blanca (conserva sus colores de
 *   marca) más el nombre en Montserrat blanco y la línea naranja del logo.
 *   Para fondos oscuros, como el pie de página: ahí el logotipo horizontal no
 *   serviría, porque su texto es azul oscuro #0D2C84. El nombre de aquí es
 *   texto de verdad, no parte de una imagen, así que se lee bien y es el que
 *   mantiene la razón social visible en todas las páginas.
 * - `completo`: logotipo horizontal original, con el nombre dentro de la
 *   imagen. Hoy no lo usa nadie: se conserva por ser el archivo oficial de
 *   marca, para piezas donde haya espacio de sobra y el texto se lea.
 *
 * Las rutas respetan el `base` configurado en astro.config.mjs.
 */
interface Props {
  variante?: 'completo' | 'claro' | 'iso';
  href?: string;
  class?: string;
}

const { variante = 'completo', href, class: clase } = Astro.props;
const Tag = href ? 'a' : 'div';
const etiqueta = `${empresa.razonSocial} — inicio`;

const base = import.meta.env.BASE_URL;
const ISOTIPO = `${base}${base.endsWith('/') ? '' : '/'}LOGO-removebg-preview.png`;
const LOGOTIPO = `${base}${base.endsWith('/') ? '' : '/'}logo-distribuciones.png`;
---

<Tag
  {...href ? { href, 'aria-label': etiqueta } : {}}
  class:list={['group inline-flex shrink-0 items-center gap-3', clase]}
>
  {
    variante === 'completo' && (
      <>
        {/* Pantallas muy pequeñas: solo el isotipo. */}
        <img
          src={ISOTIPO}
          alt={empresa.razonSocial}
          width="183"
          height="180"
          class="icono-int h-11 w-11 object-contain mob:hidden"
        />
        <img
          src={LOGOTIPO}
          alt={empresa.razonSocial}
          width="3821"
          height="1441"
          class="icono-int hidden h-11 w-auto object-contain mob:block tablet:h-14"
        />
      </>
    )
  }

  {
    variante === 'iso' && (
      <img
        src={ISOTIPO}
        alt={empresa.razonSocial}
        width="183"
        height="180"
        class="icono-int h-12 w-12 object-contain tablet:h-14 tablet:w-14"
      />
    )
  }

  {
    variante === 'claro' && (
      <>
        <span class="icono-int flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-white p-1.5 shadow-[0_4px_14px_rgba(0,0,0,.18)]">
          <img
            src={ISOTIPO}
            alt=""
            width="183"
            height="180"
            class="h-full w-full object-contain"
          />
        </span>
        <span class="font-display leading-tight text-ink">
          <span class="block text-[18px] font-bold tracking-[-0.01em]">Distribuciones</span>
          <span class="mt-1 flex items-center gap-2 text-[10.5px] font-semibold tracking-[0.08em] text-muted uppercase">
            <span class="h-[2px] w-5 bg-accent" aria-hidden="true" />
            Santiago De Tunja S.A.S
          </span>
        </span>
      </>
    )
  }
</Tag>
