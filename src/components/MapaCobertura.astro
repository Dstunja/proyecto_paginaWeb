---
import { empresa } from '../data/site';
import { sede } from '../data/municipios';

/**
 * Mapa de la sede principal.
 *
 * Se dibuja con Leaflet a nivel de calle sobre la dirección real
 * (Cra 2 Este #58-79). Las coordenadas salen de src/data/coordenadas.json, que
 * genera `npm run geocodificar` consultando Nominatim una sola vez.
 */
interface Props {
  /** true cuando el mapa vive dentro de la rejilla de la home. */
  enGrid?: boolean;
  titulo?: string;
}

const { enGrid = true, titulo = 'Dónde estamos' } = Astro.props;

const direccionCompleta = `${empresa.direccion}, ${empresa.ciudad}, ${empresa.departamento}`;
---

<div class:list={[enGrid && 'col-span-full mt-20']}>
  <h3 class="mb-7 text-xl tablet:text-2xl">{titulo}</h3>

  <div
    class:list={[
      'grid grid-cols-1 items-start gap-8',
      enGrid && 'tablet:grid-cols-[1.35fr_.65fr]',
    ]}
  >
    <div
      class="glass-card aspect-square min-h-[280px] overflow-hidden tablet:aspect-[4/3] tablet:min-h-[340px]"
    >
      <div
        id="mapa-sede"
        class="h-full w-full bg-fondo"
        data-lat={sede.lat}
        data-lng={sede.lng}
        data-direccion={direccionCompleta}
        data-empresa={empresa.nombre}
        role="application"
        aria-label={`Mapa de la sede principal en ${direccionCompleta}`}
      >
      </div>
    </div>

    <aside class="glass-card flex h-full flex-col p-8">
      <h4 class="mb-3 text-base">Sede principal</h4>
      <p class="mb-2.5 text-[15px] text-muted">
        {empresa.direccion}<br />{empresa.ciudad}, {empresa.departamento}
      </p>
      <p class="mb-7 font-semibold">
        <a class="hover:text-accent-text" href={`tel:${empresa.telefonoE164}`}>{empresa.telefono}</a>
      </p>
      <a
        class="btn btn-secondary mt-auto self-start"
        href={empresa.mapsUrl}
        target="_blank"
        rel="noopener"
      >
        Cómo llegar
      </a>
    </aside>
  </div>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const contenedor = document.getElementById('mapa-sede');
  if (contenedor) {
    const lat = Number(contenedor.dataset.lat);
    const lng = Number(contenedor.dataset.lng);

    const mapa = L.map(contenedor, {
      center: [lat, lng],
      // Zoom de manzana: se ven las calles alrededor de la bodega.
      zoom: 16,
      scrollWheelZoom: false,
    });

    // Calles de OpenStreetMap: a este nivel de detalle se leen los nombres.
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
    }).addTo(mapa);

    L.marker([lat, lng], {
      icon: L.divIcon({
        className: 'marcador-sede',
        html: '<span class="nucleo"></span>',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      }),
      title: contenedor.dataset.empresa,
      alt: 'Sede principal',
      keyboard: true,
    })
      .addTo(mapa)
      .bindPopup(
        `<strong>${contenedor.dataset.empresa}</strong><br>${contenedor.dataset.direccion}`,
      );
  }
</script>

<style>
  /* Marcador de la sede: punto azul con anillo que late. */
  :global(#mapa-sede .marcador-sede) {
    display: grid;
    place-items: center;
  }

  :global(#mapa-sede .marcador-sede .nucleo) {
    position: relative;
    display: block;
    height: 16px;
    width: 16px;
    border-radius: 9999px;
    background: var(--color-primary);
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(3, 8, 25, 0.45);
  }

  :global(#mapa-sede .marcador-sede .nucleo::after) {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 9999px;
    border: 2px solid var(--color-primary);
    animation: pulso-sede-punto 1.8s ease-out infinite;
  }

  @keyframes pulso-sede-punto {
    0% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    70%,
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  :global(#mapa-sede.leaflet-container) {
    font-family: var(--font-body);
    background: var(--color-fondo);
  }

  :global(#mapa-sede .leaflet-control-zoom a) {
    color: var(--color-primary) !important;
    border-radius: 8px !important;
  }
</style>
