---
import { empresa } from '../data/site';

/**
 * El mapa se arma en el BUILD, no en el navegador.
 * Por defecto usa OpenStreetMap, que no necesita API key.
 * Para usar Google Maps Embed API: definir PUBLIC_MAPS_PROVIDER=google y
 * PUBLIC_GOOGLE_MAPS_EMBED_KEY en .env o en las variables de Cloudflare.
 * Ver .env.example: la key nunca se escribe en el repositorio.
 */
interface Props {
  /** true cuando el mapa vive dentro de la rejilla de la home. */
  enGrid?: boolean;
  titulo?: string;
}

const { enGrid = true, titulo = 'Dónde estamos' } = Astro.props;

const provider = import.meta.env.PUBLIC_MAPS_PROVIDER ?? 'osm';
const key = import.meta.env.PUBLIC_GOOGLE_MAPS_EMBED_KEY ?? '';
const usarGoogle = provider === 'google' && Boolean(key);

const consulta = `${empresa.direccion}, ${empresa.ciudad}, ${empresa.departamento}, Colombia`;
const bbox = '-74.55,5.35,-72.85,6.85';
const marcador = '5.5353,-73.3678';

const src = usarGoogle
  ? `https://www.google.com/maps/embed/v1/place?key=${encodeURIComponent(key)}&q=${encodeURIComponent(consulta)}&zoom=8`
  : `https://www.openstreetmap.org/export/embed.html?bbox=${encodeURIComponent(bbox)}&layer=mapnik&marker=${encodeURIComponent(marcador)}`;
---

<div class:list={[enGrid && 'col-span-full mt-11']}>
  <h3 class="mb-4 text-xl text-primary">{titulo}</h3>

  <div
    class:list={[
      'grid grid-cols-1 items-start gap-7',
      enGrid && 'tablet:grid-cols-[1.35fr_.65fr]',
    ]}
  >
    <div>
      <div
        class="relative aspect-square min-h-[260px] overflow-hidden rounded-card border border-line
               bg-primary-soft tablet:aspect-[4/3] tablet:min-h-[300px]"
      >
        <!-- El embed de OpenStreetMap trae una barra de texto propia sobre el mapa.
             Se recorta para dejar solo el mapa; la atribución que exige la licencia
             queda debajo. -->
        <iframe
          src={src}
          title="Mapa de cobertura de Distribuciones Santiago de Tunja"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class:list={['block w-full border-0', usarGoogle ? 'h-full' : 'h-[calc(100%+52px)]']}
        ></iframe>
      </div>

      {
        !usarGoogle && (
          <p class="mt-2 text-right text-[11.5px] text-muted/75">
            Cartografía ©{' '}
            <a
              class="underline"
              href="https://www.openstreetmap.org/copyright"
              target="_blank"
              rel="noopener"
            >
              OpenStreetMap
            </a>
          </p>
        )
      }
    </div>

    <aside class="flex h-full flex-col rounded-card border border-line bg-surface p-[26px]">
      <h4 class="mb-3 text-base text-primary">Sede principal</h4>
      <p class="mb-2.5 text-[15px] text-muted">
        {empresa.direccion}<br />{empresa.ciudad}, {empresa.departamento}
      </p>
      <p class="mb-[22px] font-semibold">
        <a class="hover:text-accent-text" href={`tel:${empresa.telefonoE164}`}>{empresa.telefono}</a>
      </p>
      <a class="btn btn-secondary mt-auto self-start" href={empresa.mapsUrl} target="_blank" rel="noopener">
        Cómo llegar
      </a>
    </aside>
  </div>
</div>
