---
import { empresa } from '../data/site';
import LoaderDST from './LoaderDST.astro';

/**
 * El mapa se arma en el BUILD, no en el navegador.
 * Por defecto usa OpenStreetMap, que no necesita API key.
 * Para usar Google Maps Embed API: definir PUBLIC_MAPS_PROVIDER=google y
 * PUBLIC_GOOGLE_MAPS_EMBED_KEY en .env o en las variables de Cloudflare.
 * Ver .env.example: la key nunca se escribe en el repositorio.
 */
interface Props {
  /** true cuando el mapa vive dentro de la rejilla de la home. */
  enGrid?: boolean;
  titulo?: string;
}

const { enGrid = true, titulo = 'Dónde estamos' } = Astro.props;

const provider = import.meta.env.PUBLIC_MAPS_PROVIDER ?? 'osm';
const key = import.meta.env.PUBLIC_GOOGLE_MAPS_EMBED_KEY ?? '';
const usarGoogle = provider === 'google' && Boolean(key);

const consulta = `${empresa.direccion}, ${empresa.ciudad}, ${empresa.departamento}, Colombia`;
const bbox = '-74.55,5.35,-72.85,6.85';
const marcador = '5.5353,-73.3678';

const src = usarGoogle
  ? `https://www.google.com/maps/embed/v1/place?key=${encodeURIComponent(key)}&q=${encodeURIComponent(consulta)}&zoom=8`
  : `https://www.openstreetmap.org/export/embed.html?bbox=${encodeURIComponent(bbox)}&layer=mapnik&marker=${encodeURIComponent(marcador)}`;
---

<div class:list={[enGrid && 'col-span-full mt-20']}>
  <h3 class="mb-7 text-xl tablet:text-2xl">{titulo}</h3>

  <div
    class:list={[
      'grid grid-cols-1 items-start gap-8',
      enGrid && 'tablet:grid-cols-[1.35fr_.65fr]',
    ]}
  >
    <div>
      <div
        class="glass relative aspect-square min-h-[260px] overflow-hidden rounded-card
               tablet:aspect-[4/3] tablet:min-h-[320px]"
      >
        <!-- El embed de OpenStreetMap trae una barra de texto propia sobre el mapa.
             Se recorta para dejar solo el mapa; la atribución que exige la licencia
             queda debajo. -->
        <iframe
          src={src}
          title="Mapa de cobertura de Distribuciones Santiago de Tunja"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class:list={['block w-full border-0', usarGoogle ? 'h-full' : 'h-[calc(100%+52px)]']}
          data-mapa-sede
        ></iframe>

        {/* El mapa viene de un servidor ajeno: hasta que responde, el marco
            esta en blanco. */}
        <div class="dst-capa-carga" data-cargando-sede>
          <LoaderDST tamano={72} texto="Cargando el mapa…" />
        </div>
      </div>

      {
        !usarGoogle && (
          <p class="mt-2 text-right text-[11.5px] text-muted/75">
            Cartografía ©{' '}
            <a
              class="underline"
              href="https://www.openstreetmap.org/copyright"
              target="_blank"
              rel="noopener"
            >
              OpenStreetMap
            </a>
          </p>
        )
      }
    </div>

    <aside class="glass-card flex h-full flex-col p-8">
      <h4 class="mb-3 text-base">Sede principal</h4>
      <p class="mb-2.5 text-[15px] text-muted">
        {empresa.direccion}<br />{empresa.ciudad}, {empresa.departamento}
      </p>
      <p class="mb-7 font-semibold">
        <a class="hover:text-accent-text" href={`tel:${empresa.telefonoE164}`}>{empresa.telefono}</a>
      </p>
      <a class="btn btn-secondary mt-auto self-start" href={empresa.mapsUrl} target="_blank" rel="noopener">
        Cómo llegar
      </a>
    </aside>
  </div>
</div>

<script>
  /* Retirada de la animacion de carga del mapa de la sede.
   *
   * El mapa es un iframe de un servidor ajeno y con `loading="lazy"`, y eso
   * complica saber cuando esta listo de verdad:
   *
   *   - `contentDocument.readyState` no sirve: mientras el iframe no se acerca
   *     a la pantalla contiene un about:blank que ya dice "complete".
   *   - El evento `load` tampoco basta por si solo: el navegador lo dispara
   *     tambien por ese about:blank de relleno, antes de pedir nada a la red.
   *
   * Con cualquiera de los dos, la capa desapareceria al instante y se veria un
   * marco vacio. Asi que se espera al primer `load` posterior a que el iframe
   * se acerque a la pantalla, que es cuando la carga diferida arranca de
   * verdad.
   */
  const marco = document.querySelector<HTMLIFrameElement>('[data-mapa-sede]');
  const capa = document.querySelector<HTMLElement>('[data-cargando-sede]');

  if (marco && capa) {
    const ocultar = () => {
      if (capa.dataset.fuera === 'true') return;
      capa.dataset.fuera = 'true';
      window.setTimeout(() => capa.remove(), 260);
    };

    let cargaIniciada = false;

    if ('IntersectionObserver' in window) {
      // Margen amplio: el navegador arranca la carga diferida antes de que el
      // iframe entre en pantalla, y aqui hay que enterarse todavia antes.
      const observador = new IntersectionObserver(
        (entradas) => {
          if (!entradas.some((entrada) => entrada.isIntersecting)) return;
          cargaIniciada = true;
          observador.disconnect();
        },
        { rootMargin: '600px' },
      );
      observador.observe(marco);
    } else {
      cargaIniciada = true; // sin observador, se confia en el `load`
    }

    marco.addEventListener('load', () => {
      if (cargaIniciada) ocultar();
    });

    // Bloqueadores de contenido de terceros o servidor de mapas caido: la capa
    // no debe quedarse pegada tapando el hueco para siempre.
    window.setTimeout(ocultar, 8000);
  }
</script>
