---
import Icono from './Icono.astro';
import { departamentos, municipios, totalClientes, totalMunicipios } from '../data/municipios';

/**
 * Mapa interactivo de la red comercial.
 *
 * Dibuja un punto por cliente real: los conteos salen de la base de datos
 * (src/data/clientes-municipio.ts) y, como no hay dirección exacta de cada
 * cliente, los puntos se reparten alrededor de la cabecera de su municipio.
 * Al alejarse, Leaflet.markercluster los agrupa y muestra el total; al acercar,
 * el grupo se abre hasta ver los puntos uno a uno.
 *
 * Los colores son los del departamento, iguales a los de los contadores.
 */
const formatoNumero = new Intl.NumberFormat('es-CO');
---

<div class="glass-card overflow-hidden">
  <!-- CONTROLES -->
  <div
    class="flex flex-col gap-4 border-b border-line px-5 py-4 tablet:flex-row tablet:items-center tablet:justify-between"
  >
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar clientes por departamento">
      <button type="button" class="filtro-mapa" data-filtro="todos" aria-pressed="true">
        Todos los municipios
      </button>
      {
        departamentos.map((dep) => (
          <button type="button" class="filtro-mapa" data-filtro={dep.nombre} aria-pressed="false">
            <span
              class="h-2.5 w-2.5 rounded-full"
              style={`background:${dep.color}`}
              aria-hidden="true"
            />
            {dep.nombre}
          </button>
        ))
      }
    </div>

    <form class="flex w-full gap-2 tablet:w-auto" id="buscador-mapa" role="search">
      <label class="sr-only" for="buscar-municipio">Buscar municipio</label>
      <input
        class="field !w-full !py-2.5 tablet:!w-[240px]"
        id="buscar-municipio"
        name="municipio"
        type="search"
        list="lista-municipios"
        placeholder="Busca tu municipio…"
        autocomplete="off"
      />
      <datalist id="lista-municipios">
        {municipios.map((m) => <option value={m.nombre} />)}
      </datalist>
      <button
        class="group flex shrink-0 items-center gap-2 rounded-full bg-primary px-5 py-2.5 font-semibold text-white transition-colors duration-200 hover:bg-primary-dark"
        type="submit"
      >
        <Icono nombre="search" class="h-[18px] w-[18px]" />
        <span class="sr-only mob:not-sr-only">Buscar</span>
      </button>
    </form>
  </div>

  <!-- MAPA -->
  <div class="relative">
    <div
      id="mapa-red"
      class="h-[440px] w-full bg-fondo tablet:h-[560px]"
      role="application"
      aria-label="Mapa de clientes por municipio"
    >
    </div>

    <p
      id="aviso-mapa"
      class="pointer-events-none absolute inset-x-4 top-4 z-[500] m-0 hidden rounded-xl bg-surface px-4 py-2.5 text-[14px] font-medium shadow-[0_8px_24px_rgba(13,44,132,.16)] tablet:inset-x-auto tablet:left-1/2 tablet:-translate-x-1/2"
      role="status"
    >
    </p>
  </div>

  <!-- LEYENDA -->
  <div
    class="flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-line px-5 py-4 text-[13.5px]"
  >
    <span class="inline-flex items-center gap-2.5 font-medium">
      <span class="punto-sede" aria-hidden="true"></span>
      Tunja, sede principal — punto pulsante en el mapa
    </span>
    {
      departamentos.map((dep) => (
        <span class="inline-flex items-center gap-2 text-muted">
          <span
            class="h-3 w-3 rounded-full border-2 border-white shadow-[0_0_0_1px_rgba(13,44,132,.2)]"
            style={`background:${dep.color}`}
            aria-hidden="true"
          />
          {dep.nombre}
        </span>
      ))
    }
    <span class="text-muted">
      Un punto por cliente · {formatoNumero.format(totalClientes)} clientes en {totalMunicipios} municipios
    </span>
  </div>
</div>

<style>
  /* Píldoras de filtro */
  .filtro-mapa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.5rem 1rem;
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-muted);
    transition: all 0.2s ease-out;
  }

  .filtro-mapa:hover {
    border-color: var(--color-secondary);
    color: var(--color-primary);
  }

  .filtro-mapa[aria-pressed='true'] {
    border-color: transparent;
    background: var(--color-primary);
    color: #fff;
  }

  /* Punto pulsante de la sede, en la leyenda y en el mapa */
  .punto-sede {
    position: relative;
    display: inline-block;
    height: 0.75rem;
    width: 0.75rem;
    border-radius: 9999px;
    background: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(13, 44, 132, 0.18);
  }

  .punto-sede::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    border: 2px solid var(--color-primary);
    animation: pulso-sede 1.8s ease-out infinite;
  }

  @keyframes pulso-sede {
    0% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    70%,
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }

  :global(.marcador-sede) {
    display: grid;
    place-items: center;
  }

  :global(.marcador-sede .nucleo) {
    position: relative;
    display: block;
    height: 14px;
    width: 14px;
    border-radius: 9999px;
    background: var(--color-primary);
    border: 3px solid #fff;
    box-shadow: 0 2px 6px rgba(3, 8, 25, 0.4);
  }

  :global(.marcador-sede .nucleo::after) {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 9999px;
    border: 2px solid var(--color-primary);
    animation: pulso-sede 1.8s ease-out infinite;
  }

  /* --- Grupos de clientes ---
     El número va dentro de un círculo del color del departamento. */
  :global(.grupo-clientes) {
    display: grid;
    place-items: center;
  }

  :global(.grupo-clientes span) {
    display: grid;
    place-items: center;
    height: 100%;
    width: 100%;
    border-radius: 9999px;
    border: 2px solid #fff;
    color: #fff;
    font-family: var(--font-display);
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(3, 8, 25, 0.28);
    transition:
      transform 0.2s ease-out,
      box-shadow 0.2s ease-out;
  }

  :global(.grupo-clientes:hover span) {
    transform: scale(1.08);
    box-shadow: 0 8px 20px rgba(3, 8, 25, 0.35);
  }

  /* Ajustes de Leaflet al estilo del sitio */
  :global(#mapa-red.leaflet-container) {
    font-family: var(--font-body);
    background: var(--color-fondo);
  }

  :global(#mapa-red .leaflet-control-zoom a) {
    color: var(--color-primary) !important;
    border-radius: 8px !important;
  }

  :global(#mapa-red .leaflet-popup-content-wrapper) {
    border-radius: 12px;
  }

  :global(#mapa-red .leaflet-popup-content) {
    margin: 12px 16px;
    font-size: 13.5px;
  }

  :global(#mapa-red .leaflet-popup-content strong) {
    font-family: var(--font-display);
    color: var(--color-primary);
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster/dist/MarkerCluster.css';
  import { municipios, colorDepartamento, sede, type Municipio } from '../data/municipios';

  const contenedor = document.getElementById('mapa-red');

  if (contenedor) {
    // El plugin de agrupación es UMD y busca `L` en el objeto global.
    (window as unknown as { L: typeof L }).L = L;
    await import('leaflet.markercluster');

    const formato = new Intl.NumberFormat('es-CO');

    // ---- Puntos por cliente -------------------------------------------------
    // No existe la dirección de cada cliente, solo cuántos hay por municipio.
    // Se reparten alrededor de la cabecera con un generador con semilla: así el
    // mapa se ve igual en cada visita y no "baila" al recargar.
    function semilla(texto: string): number {
      let h = 2166136261;
      for (let i = 0; i < texto.length; i++) {
        h ^= texto.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return h >>> 0;
    }

    function aleatorio(estado: number): () => number {
      return () => {
        estado = (estado + 0x6d2b79f5) | 0;
        let t = Math.imul(estado ^ (estado >>> 15), 1 | estado);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    /** Radio de dispersión en km: entre 1 y 3, según el tamaño del municipio. */
    const radioKm = (clientes: number) => Math.min(3, Math.max(1, 0.8 + Math.sqrt(clientes) / 25));

    function puntosDe(municipio: Municipio): [number, number][] {
      const rnd = aleatorio(semilla(municipio.nombre));
      const radio = radioKm(municipio.clientes);
      const gradosLat = radio / 111;
      const gradosLng = radio / (111 * Math.cos((municipio.lat * Math.PI) / 180));

      return Array.from({ length: municipio.clientes }, () => {
        // Raíz cuadrada del azar = reparto uniforme dentro del círculo.
        const distancia = Math.sqrt(rnd());
        const angulo = rnd() * Math.PI * 2;
        return [
          municipio.lat + distancia * gradosLat * Math.sin(angulo),
          municipio.lng + distancia * gradosLng * Math.cos(angulo),
        ] as [number, number];
      });
    }

    // ---- Mapa ---------------------------------------------------------------
    const mapa = L.map(contenedor, {
      center: [5.8, -73.6],
      zoom: 8,
      scrollWheelZoom: false,
      zoomControl: true,
    });

    L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}',
      {
        maxZoom: 16,
        attribution:
          'Teselas &copy; <a href="https://www.esri.com/" target="_blank" rel="noopener">Esri</a> — Esri, HERE, Garmin, &copy; OpenStreetMap contributors',
      },
    ).addTo(mapa);

    const normalizar = (texto: string) =>
      texto
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();

    /** Un grupo por departamento: así el color del grupo siempre es correcto. */
    const grupos = new Map<string, any>();
    const fichas = new Map<string, Municipio>();

    for (const municipio of municipios) {
      fichas.set(normalizar(municipio.nombre), municipio);

      const color = colorDepartamento(municipio.departamento);
      let grupo = grupos.get(municipio.departamento);

      if (!grupo) {
        grupo = (L as any).markerClusterGroup({
          chunkedLoading: true,
          maxClusterRadius: 55,
          spiderfyOnMaxZoom: false,
          showCoverageOnHover: false,
          disableClusteringAtZoom: 14,
          iconCreateFunction: (cluster: any) => {
            const total = cluster.getChildCount();
            // El círculo crece con la cantidad de dígitos para que el número
            // quepa completo: 1.769 necesita más ancho que 60.
            const lado = total > 9999 ? 76 : total > 999 ? 68 : total > 99 ? 52 : 42;
            const tamanoLetra = total > 999 ? 12 : 12.5;
            return L.divIcon({
              className: 'grupo-clientes',
              html: `<span style="background:${color};font-size:${tamanoLetra}px">${formato.format(total)}</span>`,
              iconSize: [lado, lado],
            });
          },
        });

        grupo.on('click', (evento: any) => {
          const nombre = evento.layer?.options?.municipio as string | undefined;
          const ficha = nombre ? fichas.get(normalizar(nombre)) : undefined;
          if (!ficha) return;
          L.popup()
            .setLatLng(evento.latlng)
            .setContent(
              `<strong>${ficha.nombre}</strong><br>${ficha.departamento}<br>${formato.format(ficha.clientes)} clientes`,
            )
            .openOn(mapa);
        });

        grupos.set(municipio.departamento, grupo);
      }

      const marcadores = puntosDe(municipio).map(([lat, lng]) =>
        L.circleMarker([lat, lng], {
          radius: 4,
          weight: 1,
          color: '#ffffff',
          fillColor: color,
          fillOpacity: 0.85,
          // Se guarda el municipio para el globo de información.
          municipio: municipio.nombre,
        } as L.CircleMarkerOptions),
      );
      grupo.addLayers(marcadores);
    }

    grupos.forEach((grupo) => grupo.addTo(mapa));

    // Sede principal, siempre encima de los grupos.
    L.marker([sede.lat, sede.lng], {
      icon: L.divIcon({
        className: 'marcador-sede',
        html: '<span class="nucleo"></span>',
        iconSize: [14, 14],
        iconAnchor: [7, 7],
      }),
      title: 'Tunja — sede principal',
      zIndexOffset: 2000,
    })
      .addTo(mapa)
      .bindPopup('<strong>Tunja</strong><br>Sede principal');

    /** Encuadra el mapa sobre los municipios visibles. */
    function encuadrar(visibles: string[]) {
      const puntos = municipios
        .filter((m) => visibles.includes(m.departamento))
        .map((m) => [m.lat, m.lng] as [number, number]);
      if (puntos.length > 1) mapa.fitBounds(L.latLngBounds(puntos).pad(0.12), { maxZoom: 10 });
      else if (puntos.length === 1) mapa.setView(puntos[0], 11);
    }

    encuadrar([...grupos.keys()]);

    // ---- Filtros ------------------------------------------------------------
    const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const filtro = boton.dataset.filtro!;
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));

        const visibles: string[] = [];
        grupos.forEach((grupo, departamento) => {
          if (filtro === 'todos' || filtro === departamento) {
            grupo.addTo(mapa);
            visibles.push(departamento);
          } else {
            mapa.removeLayer(grupo);
          }
        });
        encuadrar(visibles);
      });
    });

    // ---- Buscador -----------------------------------------------------------
    const formulario = document.getElementById('buscador-mapa') as HTMLFormElement | null;
    const campo = document.getElementById('buscar-municipio') as HTMLInputElement | null;
    const aviso = document.getElementById('aviso-mapa');

    function mostrarAviso(texto: string, ok: boolean) {
      if (!aviso) return;
      aviso.textContent = texto;
      aviso.classList.remove('hidden');
      aviso.style.color = ok ? 'var(--color-ok)' : 'var(--color-accent-text)';
    }

    formulario?.addEventListener('submit', (e) => {
      e.preventDefault();
      const valor = campo?.value.trim() ?? '';
      if (!valor) {
        mostrarAviso('Escribe el nombre de tu municipio.', false);
        return;
      }

      const ficha = fichas.get(normalizar(valor));
      if (!ficha) {
        mostrarAviso(
          `Por ahora no tenemos clientes registrados en "${valor}". Escríbenos y lo validamos.`,
          false,
        );
        return;
      }

      // Si estaba filtrado por otro departamento, se vuelven a mostrar todos.
      botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === 'todos')));
      grupos.forEach((grupo) => grupo.addTo(mapa));

      mapa.flyTo([ficha.lat, ficha.lng], 13, { duration: 0.8 });
      mapa.once('moveend', () => {
        L.popup()
          .setLatLng([ficha.lat, ficha.lng])
          .setContent(
            `<strong>${ficha.nombre}</strong><br>${ficha.departamento}<br>${formato.format(ficha.clientes)} clientes`,
          )
          .openOn(mapa);
      });
      mostrarAviso(`${ficha.nombre}: ${formato.format(ficha.clientes)} clientes atendidos.`, true);
    });

    campo?.addEventListener('input', () => aviso?.classList.add('hidden'));
  }
</script>
