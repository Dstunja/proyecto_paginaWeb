---
import LoaderDST from './LoaderDST.astro';
import { departamentos, totalMunicipios } from '../data/municipios';
import { empresa } from '../data/site';

/**
 * Mapa de cobertura: una pieza visual fija, no un mapa para explorar.
 *
 * Se dibuja un punto por cada municipio cubierto —los 87—, nunca uno por
 * cliente. Todos los puntos son del mismo tamaño: el mapa responde "¿llegamos
 * aquí?", que es una pregunta de sí o no, y un punto más gordo invitaba a leer
 * una jerarquía entre municipios que la sección no explica.
 *
 * El mapa no se arrastra ni hace zoom con la rueda; el encuadre es siempre el
 * mismo. Lo único interactivo es la ficha con el nombre del municipio que sale
 * al pasar el mouse o tocar un punto, más los filtros por departamento. La
 * búsqueda por municipio vive en BuscadorMunicipio.astro, encima de esta
 * tarjeta, y le pide al mapa que resalte el punto elegido.
 *
 * Los municipios salen de la base de datos real (src/data/clientes-municipio.ts)
 * y las coordenadas de la caché de src/data/coordenadas.json. El número de
 * clientes de cada municipio es información interna y no interviene en nada de
 * lo que se dibuja: ni en el tamaño de los puntos ni en ningún texto.
 */
const nombresDepartamentos = departamentos.map((d) => d.nombre);
const listaDepartamentos =
  nombresDepartamentos.slice(0, -1).join(', ') + ' y ' + nombresDepartamentos.at(-1);

/**
 * La dirección de la leyenda enlaza a `empresa.mapsUrl` (src/data/site.ts), que
 * se arma con la coordenada exacta de `__sede__` en src/data/coordenadas.json.
 * Se usa la constante compartida y no una URL propia para que este enlace y el
 * del mapa de la sede (MapaCobertura.astro) no puedan separarse.
 */
const direccionSede = `${empresa.direccion}, ${empresa.ciudad}`;
---

<!--
  `isolate` (isolation: isolate) no es decorativo: crea un contexto de
  apilamiento en la tarjeta. Leaflet posiciona sus paneles con z-index propios
  que llegan a 1000 (teselas 200, puntos 400 y 600, fichas 650, atribución
  1000), y sin contexto propio esos valores compiten en la raíz del documento,
  donde ganaban a la barra superior (z-100), al botón de WhatsApp (z-150), al
  menú móvil (z-160) y al aviso de cookies (z-180): el mapa se montaba encima al
  hacer scroll. Con el contexto, todo eso queda encerrado dentro de la tarjeta.
-->
<div class="glass-card isolate overflow-hidden">
  <!-- CONTROLES -->
  <div
    class="flex flex-col gap-4 border-b border-line px-5 py-4 tablet:flex-row tablet:items-center tablet:justify-between"
  >
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar municipios por departamento">
      <button type="button" class="filtro-mapa" data-filtro="todos" aria-pressed="true">
        Todos los municipios
      </button>
      {
        departamentos.map((dep) => (
          <button type="button" class="filtro-mapa" data-filtro={dep.nombre} aria-pressed="false">
            <span
              class="h-2.5 w-2.5 rounded-full"
              style={`background:${dep.color}`}
              aria-hidden="true"
            />
            {dep.nombre}
          </button>
        ))
      }
    </div>

    {/* Aquí vivía un segundo campo de búsqueda de municipios. Se quitó al
        agregar el buscador destacado "¿Llegamos a tu municipio?" justo encima
        de esta tarjeta (BuscadorMunicipio.astro): dos campos que preguntan lo
        mismo, uno debajo del otro, solo obligan a elegir cuál usar. Al buscar
        allá, este mapa resalta el punto (evento EVENTO_MUNICIPIO). */}
  </div>

  <!-- MAPA -->
  <!--
    Con los 87 municipios la zona cubierta es casi cuadrada: 1,29 grados de
    latitud por 1,18 de longitud. Por eso el mapa es alto y no una franja
    ancha; en una franja baja los puntos quedarían apretados en vertical y con
    mucho terreno vacío a los lados.

    En escritorio se le pone un ancho máximo y se centra, y el aire que queda
    se trata como marco —el mapa lleva esquinas redondeadas y un filete— para
    que se lea como una figura encuadrada y no como un mapa recortado. En móvil
    va a sangre y a ancho completo.

    El alto crece con la pantalla porque abajo de 900 px el mapa va a ancho
    completo: si se quedara bajo, la red saldría diminuta en el centro de una
    franja apaisada llena de terreno que no cubrimos.

    El límite de ancho va en este contenedor y no en el mapa, para que el aviso
    del buscador se centre sobre el mapa visible.
  -->
  <div class="tablet:px-6 tablet:py-6">
    <div class="relative mx-auto w-full tablet:max-w-[560px]">
      <div
        id="mapa-red"
        class="h-[440px] w-full overflow-hidden bg-fondo mob:h-[560px] tablet:h-[600px] tablet:rounded-2xl tablet:ring-1 tablet:ring-line"
        role="application"
        aria-label="Mapa de los municipios con cobertura"
      >
      </div>

      {/* Espera real: Leaflet se descarga, arma los 87 puntos y pide las teselas
          al servidor de mapas. Hasta que eso termina, aqui solo habria un
          rectangulo gris. La capa hereda las esquinas redondeadas del marco. */}
      <div class="dst-capa-carga tablet:rounded-2xl" data-cargando-mapa>
        <LoaderDST texto="Cargando el mapa…" />
      </div>

    </div>
  </div>

  <!-- LEYENDA -->
  <div
    class="flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-line px-5 py-4 text-[13.5px]"
  >
    <span class="inline-flex items-start gap-2.5 font-medium">
      <span class="punto-sede mt-[7px] shrink-0" aria-hidden="true"></span>
      <span class="flex flex-col gap-0.5">
        {/* La razón social va encima de la dirección como etiqueta de contexto:
            sin ella el punto pulsante es una dirección suelta y no se sabe de
            quién es la sede. Discreta a propósito —no compite con los títulos
            de la sección—, en el mismo estilo de kicker que ya usa el sitio. */}
        <span class="text-[11.5px] font-semibold tracking-[0.06em] text-muted uppercase">
          {empresa.razonSocial}
        </span>
        <span>Tunja, sede principal — punto pulsante en el mapa</span>
        <a
          class="font-semibold text-secondary-dark underline decoration-secondary-dark/40 underline-offset-2 transition-colors hover:decoration-secondary-dark"
          href={empresa.mapsUrl}
          target="_blank"
          rel="noopener"
        >
          {direccionSede}
        </a>
      </span>
    </span>
    {
      departamentos.map((dep) => (
        <span class="inline-flex items-center gap-2 text-muted">
          <span
            class="h-3 w-3 rounded-full border-2 border-white shadow-[0_0_0_1px_rgba(13,44,132,.2)]"
            style={`background:${dep.color}`}
            aria-hidden="true"
          />
          {dep.nombre}
        </span>
      ))
    }
    <span class="text-muted">
      Un punto por municipio &middot; cobertura en {totalMunicipios} municipios de {
        listaDepartamentos
      }
    </span>
  </div>
</div>

<style>
  /* Píldoras de filtro */
  .filtro-mapa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.5rem 1rem;
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-muted);
    transition: all 0.2s ease-out;
  }

  .filtro-mapa:hover {
    border-color: var(--color-secondary);
    color: var(--color-primary);
  }

  .filtro-mapa[aria-pressed='true'] {
    border-color: transparent;
    background: var(--color-primary);
    color: #fff;
  }

  /* Punto pulsante de la sede, en la leyenda y en el mapa */
  .punto-sede {
    position: relative;
    display: inline-block;
    height: 0.75rem;
    width: 0.75rem;
    border-radius: 9999px;
    background: var(--color-sede);
    box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.18);
  }

  .punto-sede::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    border: 2px solid var(--color-sede);
    animation: pulso-sede 1.8s ease-out infinite;
  }

  @keyframes pulso-sede {
    0% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    70%,
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }

  :global(.marcador-sede) {
    display: grid;
    place-items: center;
  }

  :global(.marcador-sede .nucleo) {
    position: relative;
    display: block;
    height: 14px;
    width: 14px;
    border-radius: 9999px;
    background: var(--color-sede);
    border: 3px solid #fff;
    box-shadow: 0 2px 6px rgba(3, 8, 25, 0.4);
  }

  :global(.marcador-sede .nucleo::after) {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 9999px;
    border: 2px solid var(--color-sede);
    animation: pulso-sede 1.8s ease-out infinite;
  }

  /* Ajustes de Leaflet al estilo del sitio */
  :global(#mapa-red.leaflet-container) {
    font-family: var(--font-body);
    background: var(--color-fondo);
  }

  /* Con el mapa a color, una sombra suave despega los puntos del fondo. */
  :global(#mapa-red .leaflet-overlay-pane path) {
    filter: drop-shadow(0 1px 2px rgba(3, 8, 25, 0.45));
  }

  /*
    Borde desvanecido del mapa de fondo.

    Las teselas de OpenStreetMap traen los nombres de los pueblos pintados
    encima, y siempre queda alguno justo sobre el borde del contenedor: cortado
    a filo se leía "Contratación" o "Charalá" partido por la mitad. Agrandar el
    margen del encuadre NO lo arregla —al fitBounds se le encoge la red, se ve
    más territorio alrededor y el corte le toca a otro pueblo—, así que el borde
    se apaga contra el fondo y esos nombres se desvanecen en vez de quedar
    rebanados.

    El degradado se pinta dentro del panel de teselas, que en Leaflet va en el
    z-index más bajo (200). Así los puntos de los municipios y la sede (400 y
    600), las fichas al pasar el mouse (650) y la atribución de OpenStreetMap
    (1000) quedan por encima y siguen nítidos. Y como el encuadre deja aire de
    sobra (ver `encuadrar()`), ningún punto de la red cae dentro del degradado.
  */
  :global(#mapa-red .leaflet-map-pane),
  :global(#mapa-red .leaflet-tile-pane) {
    /* Los paneles de Leaflet nacen sin tamaño; se les da el del mapa para poder
       anclar el degradado a sus cuatro bordes. No mueve nada más: todo lo que
       llevan dentro está posicionado en absoluto. */
    inset: 0;
  }

  :global(#mapa-red .leaflet-tile-pane::after) {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, var(--color-fondo), transparent 30px),
      linear-gradient(to top, var(--color-fondo), transparent 30px),
      linear-gradient(to right, var(--color-fondo), transparent 24px),
      linear-gradient(to left, var(--color-fondo), transparent 24px);
  }

  /* Sin arrastre ni zoom: el cursor no debe insinuar que el mapa se mueve. */
  :global(#mapa-red.leaflet-container),
  :global(#mapa-red .leaflet-tile-pane) {
    cursor: default;
  }

  /* Los puntos sí son clicables (abren la ficha del municipio). */
  :global(#mapa-red .leaflet-interactive) {
    cursor: pointer;
  }

  :global(#mapa-red .leaflet-popup-content-wrapper),
  :global(#mapa-red .leaflet-tooltip) {
    border-radius: 12px;
  }

  :global(#mapa-red .leaflet-popup-content),
  :global(#mapa-red .leaflet-tooltip) {
    font-size: 13.5px;
  }

  :global(#mapa-red .leaflet-popup-content) {
    margin: 12px 16px;
  }

  :global(#mapa-red .leaflet-tooltip) {
    padding: 8px 12px;
    border: 1px solid var(--color-line);
    box-shadow: 0 8px 20px rgba(13, 44, 132, 0.14);
  }

  :global(#mapa-red .leaflet-popup-content strong),
  :global(#mapa-red .leaflet-tooltip strong) {
    font-family: var(--font-display);
    color: var(--color-primary);
  }

  /*
    Distintivo "SEDE" del globo de Tunja.

    Hace falta porque cerca de Tunja hay DOS marcadores y son cosas distintas:
    el punto de Tunja como municipio, que es uno de los 87 y se dibuja en la
    cabecera municipal, y el punto pulsante de la sede, que está en la dirección
    real de la bodega (Cra 2 Este #58-79). Sin la etiqueta, los dos globos se
    leen igual.
  */
  :global(#mapa-red .leaflet-popup-content .etiqueta-sede) {
    display: inline-block;
    margin-right: 6px;
    border-radius: 4px;
    background: var(--color-sede);
    padding: 1px 5px;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #fff;
    vertical-align: 1px;
  }

  /* Departamento: debajo del municipio, más pequeño y en gris. */
  :global(#mapa-red .leaflet-popup-content .depto),
  :global(#mapa-red .leaflet-tooltip .depto) {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    color: var(--color-muted);
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { municipios, colorDepartamento, sede, type Municipio } from '../data/municipios';
  import { FONDO } from '../lib/mapa-base';
  import {
    EVENTO_MUNICIPIO,
    normalizarMunicipio,
    type DetalleMunicipioElegido,
  } from '../lib/municipios-busqueda';

  const contenedor = document.getElementById('mapa-red');

  if (contenedor) {
    // Encuadre fijo: el mapa es una ilustración de la red, no un mapa para
    // explorar. Se apagan arrastre, rueda, doble clic, pellizco y teclado para
    // que no compita con el scroll de la página ni se pueda dejar descuadrado.
    const mapa = L.map(contenedor, {
      center: [5.8, -73.6],
      zoom: 8,
      dragging: false,
      scrollWheelZoom: false,
      doubleClickZoom: false,
      touchZoom: false,
      boxZoom: false,
      keyboard: false,
      zoomControl: false,
      // Zoom fraccionado: con saltos de un nivel entero el encuadre se queda
      // corto y los 87 puntos se apelotonan en el centro con terreno vacío
      // alrededor.
      zoomSnap: 0.25,
    });

    // Fondo a color de OpenStreetMap (ver src/lib/mapa-base.ts).
    const teselas = L.tileLayer(FONDO.url, FONDO.opciones).addTo(mapa);

    /* La normalización es la MISMA que usa el buscador destacado de arriba
       (src/lib/municipios-busqueda.ts). Si cada uno tuviera su propia copia,
       bastaría con tocar una para que uno encontrara "chiquinquira" y el otro
       no, sin que nada avisara. */
    const normalizar = normalizarMunicipio;

    /**
     * Ficha que se muestra al pasar el mouse o al tocar el punto: el nombre del
     * municipio y, debajo y en gris, su departamento.
     *
     * A propósito no lleva el número de clientes: ese dato es interno y no debe
     * quedar visible en el sitio (ver el comentario de arriba).
     */
    const ficha = (municipio: Municipio) =>
      `<strong>${municipio.nombre}</strong><span class="depto">${municipio.departamento}</span>`;

    // ---- Retirada de la animacion de carga ----
    const capaCarga = document.querySelector<HTMLElement>('[data-cargando-mapa]');

    /** Se retira con un fundido de 250 ms y luego se quita del arbol. */
    const ocultarCarga = () => {
      if (!capaCarga || capaCarga.dataset.fuera === 'true') return;
      capaCarga.dataset.fuera = 'true';
      window.setTimeout(() => capaCarga.remove(), 260);
    };

    // Cuando terminan de llegar las teselas visibles el mapa ya se ve entero.
    teselas.on('load', ocultarCarga);
    // Red lenta o servidor de teselas caido: el mapa igual es utilizable con
    // los puntos y el fondo gris, asi que la capa nunca se queda pegada.
    window.setTimeout(ocultarCarga, 6000);

    /** Una capa por departamento, para poder filtrar. */
    const capas = new Map<string, L.LayerGroup>();
    /** Punto dibujado de cada municipio, para realzarlo al buscarlo. */
    const puntos = new Map<string, { marcador: L.CircleMarker; municipio: Municipio }>();

    /**
     * Encuadre único sobre toda la red, siempre el mismo. Los filtros solo
     * prenden y apagan puntos; el mapa nunca se mueve, así la sección no salta
     * al filtrar. Los globos se abren con `autoPan: false` por lo mismo.
     *
     * Sin animación a propósito: animado, el zoom nuevo tarda un momento en
     * quedar aplicado y se leería con el zoom viejo.
     *
     * Los márgenes son holgados y desiguales a propósito: apartan la red del
     * filete del contenedor para que ni un punto ni la ficha que abre al pasarle
     * el mouse queden pegados al borde. Arriba va el mayor, porque es donde la
     * red termina en punta —La Paz, Aguada, San Benito— y era donde más se
     * notaba el recorte; abajo lleva 10 px extra para la línea de atribución de
     * OpenStreetMap.
     *
     * Estos márgenes cuidan la red, no las etiquetas del mapa de fondo: de que
     * los nombres del borde no queden partidos se encarga el degradado de
     * `.leaflet-tile-pane` (ver el CSS de arriba).
     *
     * En pantallas angostas manda el ancho, así que a los lados el margen se
     * recorta —cada píxel que se le quite es escala que ganan los puntos—,
     * mientras que arriba y abajo sobra alto y el margen sale gratis.
     */
    const RED = L.latLngBounds(municipios.map((m) => [m.lat, m.lng] as [number, number]));

    function encuadrar() {
      const angosto = contenedor!.clientWidth < 420;
      const lados = angosto ? 12 : 30;
      const arriba = angosto ? 40 : 46;
      const abajo = (angosto ? 30 : 34) + 10;
      mapa.fitBounds(RED, {
        paddingTopLeft: [lados, arriba],
        paddingBottomRight: [lados, abajo],
        maxZoom: 10,
        animate: false,
      });
    }

    encuadrar();

    /**
     * Tamaño del punto: el mismo para los 87.
     *
     * Antes el radio crecía con el número de clientes del municipio. Se quitó a
     * propósito por dos razones. La primera es de lectura: el mapa responde
     * "¿llegamos aquí?", que es una pregunta de sí o no, y un punto más gordo
     * invitaba a leer una jerarquía que la sección no explica en ninguna parte.
     * La segunda es que ese tamaño dejaba ver, a ojo, cómo se reparte la
     * clientela entre municipios, que es información interna.
     */
    const RADIO = 7;
    const RADIO_HOVER = 10;

    for (const municipio of municipios) {
      const capa = capas.get(municipio.departamento) ?? L.layerGroup();
      capas.set(municipio.departamento, capa);

      const marcador = L.circleMarker([municipio.lat, municipio.lng], {
        radius: RADIO,
        // Aro blanco: es lo que separa un punto del fondo y de su vecino en el
        // racimo de Tunja. La sombra la pone el CSS del contenedor.
        color: '#ffffff',
        weight: 2,
        fillColor: colorDepartamento(municipio.departamento),
        fillOpacity: 0.9,
      });

      /* `autoPan: false` no es un detalle: por omisión Leaflet desplaza el mapa
         para que quepa el globo que acaba de abrirse, y como aquí el globo se
         abre al pasar el mouse, el encuadre se movería solo al recorrer la red.
         El encuadre de esta sección no se mueve nunca (ver `encuadrar()`). */
      marcador.bindPopup(ficha(municipio), { autoPan: false });

      // Al pasar el mouse el punto crece, se engorda el aro y se pone encima de
      // sus vecinos, y se abre su ficha.
      marcador.on('mouseover', () => {
        marcador.setStyle({ weight: 4 });
        marcador.setRadius(RADIO_HOVER);
        marcador.bringToFront();
        marcador.openPopup();
      });
      marcador.on('mouseout', () => {
        marcador.setStyle({ weight: 2 });
        marcador.setRadius(RADIO);
      });

      marcador.addTo(capa);
      puntos.set(normalizar(municipio.nombre), { marcador, municipio });
    }

    capas.forEach((capa) => capa.addTo(mapa));

    // Al cambiar el ancho de la ventana cambia la escala del encuadre. Los
    // radios ya no dependen de ella, así que basta con volver a encuadrar.
    mapa.on('resize', encuadrar);

    // Sede principal: punto pulsante, siempre encima del resto.
    L.marker([sede.lat, sede.lng], {
      icon: L.divIcon({
        className: 'marcador-sede',
        html: '<span class="nucleo"></span>',
        iconSize: [14, 14],
        iconAnchor: [7, 7],
      }),
      title: 'Tunja — sede principal',
      zIndexOffset: 1000,
    })
      .addTo(mapa)
      .bindPopup(
        '<strong>Tunja</strong><span class="depto"><span class="etiqueta-sede">SEDE</span>Boyacá · sede principal</span>',
        { autoPan: false },
      );

    // ---- Filtros ------------------------------------------------------------
    const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const filtro = boton.dataset.filtro!;
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));

        capas.forEach((capa, departamento) => {
          if (filtro === 'todos' || filtro === departamento) {
            capa.addTo(mapa);
          } else {
            mapa.removeLayer(capa);
          }
        });
      });
    });

    /**
     * Trae el punto al frente, le abre la ficha y lo engorda un momento.
     *
     * Vive aparte del formulario porque también lo dispara el buscador
     * destacado de arriba (BuscadorMunicipio.astro): allá se hace la búsqueda
     * y aquí solo se responde, sin repetir la lógica de encontrar el municipio.
     */
    function resaltar({ marcador }: { marcador: L.CircleMarker }) {
      // Si estaba filtrado por otro departamento, se vuelven a mostrar todos.
      botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === 'todos')));
      capas.forEach((capa) => capa.addTo(mapa));

      marcador.bringToFront();
      marcador.openPopup();

      // Realce temporal para que el punto buscado se distinga de los demás.
      // Va por encima del radio de hover para que se note aunque el mouse esté
      // sobre otro punto.
      marcador.setStyle({ weight: 4, radius: RADIO_HOVER + 3 });
      window.setTimeout(() => marcador.setStyle({ weight: 2, radius: RADIO }), 2500);
    }

    /* El buscador destacado de la cabecera avisa por `document` cuál municipio
       eligió la persona; el mapa se limita a señalarlo. Los dos componentes
       empaquetan su script por separado, así que el evento es lo único que
       comparten. */
    document.addEventListener(EVENTO_MUNICIPIO, (e) => {
      const detalle = (e as CustomEvent<DetalleMunicipioElegido>).detail;
      if (!detalle?.nombre) return;
      const encontrado = puntos.get(normalizarMunicipio(detalle.nombre));
      if (encontrado) resaltar(encontrado);
    });
  }
</script>
