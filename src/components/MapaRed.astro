---
import Icono from './Icono.astro';
import { departamentos, municipios, totalMunicipios } from '../data/municipios';

/**
 * Mapa de cobertura: un punto por municipio atendido.
 *
 * Los municipios y su número de clientes salen de la base de datos real
 * (src/data/clientes-municipio.ts) y las coordenadas de la caché de
 * src/data/coordenadas.json. El conteo de clientes no se dibuja sobre el mapa:
 * aparece al pasar el mouse o al tocar el punto, para que el mapa se lea
 * limpio.
 */
const nombresDepartamentos = departamentos.map((d) => d.nombre);
const listaDepartamentos =
  nombresDepartamentos.slice(0, -1).join(', ') + ' y ' + nombresDepartamentos.at(-1);
---

<div class="glass-card overflow-hidden">
  <!-- CONTROLES -->
  <div
    class="flex flex-col gap-4 border-b border-line px-5 py-4 tablet:flex-row tablet:items-center tablet:justify-between"
  >
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar municipios por departamento">
      <button type="button" class="filtro-mapa" data-filtro="todos" aria-pressed="true">
        Todos los municipios
      </button>
      {
        departamentos.map((dep) => (
          <button type="button" class="filtro-mapa" data-filtro={dep.nombre} aria-pressed="false">
            <span
              class="h-2.5 w-2.5 rounded-full"
              style={`background:${dep.color}`}
              aria-hidden="true"
            />
            {dep.nombre}
          </button>
        ))
      }
    </div>

    <form class="flex w-full gap-2 tablet:w-auto" id="buscador-mapa" role="search">
      <label class="sr-only" for="buscar-municipio">Buscar municipio</label>
      <input
        class="field !w-full !py-2.5 tablet:!w-[240px]"
        id="buscar-municipio"
        name="municipio"
        type="search"
        list="lista-municipios"
        placeholder="Busca tu municipio…"
        autocomplete="off"
      />
      <datalist id="lista-municipios">
        {municipios.map((m) => <option value={m.nombre} />)}
      </datalist>
      <button
        class="group flex shrink-0 items-center gap-2 rounded-full bg-primary px-5 py-2.5 font-semibold text-white transition-colors duration-200 hover:bg-primary-dark"
        type="submit"
      >
        <Icono nombre="search" class="h-[18px] w-[18px]" />
        <span class="sr-only mob:not-sr-only">Buscar</span>
      </button>
    </form>
  </div>

  <!-- MAPA -->
  <div class="relative">
    <div
      id="mapa-red"
      class="h-[440px] w-full bg-fondo tablet:h-[560px]"
      role="application"
      aria-label="Mapa de los municipios con cobertura"
    >
    </div>

    <p
      id="aviso-mapa"
      class="pointer-events-none absolute inset-x-4 top-4 z-[500] m-0 hidden rounded-xl bg-surface px-4 py-2.5 text-[14px] font-medium shadow-[0_8px_24px_rgba(13,44,132,.16)] tablet:inset-x-auto tablet:left-1/2 tablet:-translate-x-1/2"
      role="status"
    >
    </p>
  </div>

  <!-- LEYENDA -->
  <div
    class="flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-line px-5 py-4 text-[13.5px]"
  >
    <span class="inline-flex items-center gap-2.5 font-medium">
      <span class="punto-sede" aria-hidden="true"></span>
      Tunja, sede principal — punto pulsante en el mapa
    </span>
    {
      departamentos.map((dep) => (
        <span class="inline-flex items-center gap-2 text-muted">
          <span
            class="h-3 w-3 rounded-full border-2 border-white shadow-[0_0_0_1px_rgba(13,44,132,.2)]"
            style={`background:${dep.color}`}
            aria-hidden="true"
          />
          {dep.nombre}
        </span>
      ))
    }
    <span class="text-muted">
      Cobertura en {totalMunicipios} municipios de {listaDepartamentos}
    </span>
  </div>
</div>

<style>
  /* Píldoras de filtro */
  .filtro-mapa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.5rem 1rem;
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-muted);
    transition: all 0.2s ease-out;
  }

  .filtro-mapa:hover {
    border-color: var(--color-secondary);
    color: var(--color-primary);
  }

  .filtro-mapa[aria-pressed='true'] {
    border-color: transparent;
    background: var(--color-primary);
    color: #fff;
  }

  /* Punto pulsante de la sede, en la leyenda y en el mapa */
  .punto-sede {
    position: relative;
    display: inline-block;
    height: 0.75rem;
    width: 0.75rem;
    border-radius: 9999px;
    background: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(13, 44, 132, 0.18);
  }

  .punto-sede::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    border: 2px solid var(--color-primary);
    animation: pulso-sede 1.8s ease-out infinite;
  }

  @keyframes pulso-sede {
    0% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    70%,
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }

  :global(.marcador-sede) {
    display: grid;
    place-items: center;
  }

  :global(.marcador-sede .nucleo) {
    position: relative;
    display: block;
    height: 14px;
    width: 14px;
    border-radius: 9999px;
    background: var(--color-primary);
    border: 3px solid #fff;
    box-shadow: 0 2px 6px rgba(3, 8, 25, 0.4);
  }

  :global(.marcador-sede .nucleo::after) {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 9999px;
    border: 2px solid var(--color-primary);
    animation: pulso-sede 1.8s ease-out infinite;
  }

  /* Ajustes de Leaflet al estilo del sitio */
  :global(#mapa-red.leaflet-container) {
    font-family: var(--font-body);
    background: var(--color-fondo);
  }

  /* Con el mapa a color, una sombra suave despega los puntos del fondo. */
  :global(#mapa-red .leaflet-overlay-pane path) {
    filter: drop-shadow(0 1px 2px rgba(3, 8, 25, 0.45));
  }

  :global(#mapa-red .leaflet-control-zoom a) {
    color: var(--color-primary) !important;
    border-radius: 8px !important;
  }

  :global(#mapa-red .leaflet-popup-content-wrapper),
  :global(#mapa-red .leaflet-tooltip) {
    border-radius: 12px;
  }

  :global(#mapa-red .leaflet-popup-content),
  :global(#mapa-red .leaflet-tooltip) {
    font-size: 13.5px;
  }

  :global(#mapa-red .leaflet-popup-content) {
    margin: 12px 16px;
  }

  :global(#mapa-red .leaflet-tooltip) {
    padding: 8px 12px;
    border: 1px solid var(--color-line);
    box-shadow: 0 8px 20px rgba(13, 44, 132, 0.14);
  }

  :global(#mapa-red .leaflet-popup-content strong),
  :global(#mapa-red .leaflet-tooltip strong) {
    font-family: var(--font-display);
    color: var(--color-primary);
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { municipios, colorDepartamento, sede, type Municipio } from '../data/municipios';
  import { FONDO } from '../lib/mapa-base';

  const contenedor = document.getElementById('mapa-red');

  if (contenedor) {
    const formato = new Intl.NumberFormat('es-CO');

    const mapa = L.map(contenedor, {
      center: [5.8, -73.6],
      zoom: 8,
      // La rueda del mouse no debe secuestrar el scroll de la página.
      scrollWheelZoom: false,
      zoomControl: true,
    });

    // Fondo a color de OpenStreetMap (ver src/lib/mapa-base.ts).
    L.tileLayer(FONDO.url, FONDO.opciones).addTo(mapa);

    const normalizar = (texto: string) =>
      texto
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();

    /** Ficha que se muestra al pasar el mouse o al tocar el punto. */
    const ficha = (municipio: Municipio) =>
      `<strong>${municipio.nombre}</strong><br>${municipio.departamento}<br>${formato.format(municipio.clientes)} ${
        municipio.clientes === 1 ? 'cliente' : 'clientes'
      }`;

    /**
     * Tamaño del punto: crece un poco con la cantidad de clientes, entre 6 y
     * 12 px de radio. No pretende ser una escala exacta, solo dejar ver de un
     * vistazo dónde está el grueso de la red.
     */
    const radio = (clientes: number) => Math.min(12, Math.max(6, 5 + Math.sqrt(clientes) / 6));

    /** Una capa por departamento, para poder filtrar. */
    const capas = new Map<string, L.LayerGroup>();
    /** Punto de cada municipio, para centrarlo desde el buscador. */
    const puntos = new Map<string, { marcador: L.CircleMarker; municipio: Municipio }>();

    for (const municipio of municipios) {
      const capa = capas.get(municipio.departamento) ?? L.layerGroup();
      capas.set(municipio.departamento, capa);

      const marcador = L.circleMarker([municipio.lat, municipio.lng], {
        radius: radio(municipio.clientes),
        // Aro blanco grueso: sobre el mapa a color es lo que separa el punto
        // del fondo. La sombra la pone el CSS del contenedor.
        color: '#ffffff',
        weight: 3,
        fillColor: colorDepartamento(municipio.departamento),
        fillOpacity: 1,
      });

      marcador
        .bindTooltip(ficha(municipio), { direction: 'top', offset: [0, -10] })
        .bindPopup(ficha(municipio));

      // Al pasar el mouse el punto se agranda un poco.
      marcador.on('mouseover', () => marcador.setStyle({ weight: 5 }));
      marcador.on('mouseout', () => marcador.setStyle({ weight: 3 }));

      marcador.addTo(capa);
      puntos.set(normalizar(municipio.nombre), { marcador, municipio });
    }

    capas.forEach((capa) => capa.addTo(mapa));

    const fichaTunja = puntos.get(normalizar('Tunja'));

    // Sede principal: punto pulsante, siempre encima del resto.
    L.marker([sede.lat, sede.lng], {
      icon: L.divIcon({
        className: 'marcador-sede',
        html: '<span class="nucleo"></span>',
        iconSize: [14, 14],
        iconAnchor: [7, 7],
      }),
      title: 'Tunja — sede principal',
      zIndexOffset: 2000,
    })
      .addTo(mapa)
      .bindPopup(
        // El marcador de la sede tapa el punto de cobertura de Tunja, así que
        // su globo también muestra los clientes del municipio.
        `<strong>Tunja</strong><br>Sede principal${
          fichaTunja ? `<br>${formato.format(fichaTunja.municipio.clientes)} clientes` : ''
        }`,
      );

    /** Encuadra el mapa sobre los departamentos visibles. */
    function encuadrar(visibles: string[]) {
      const coordenadas = municipios
        .filter((m) => visibles.includes(m.departamento))
        .map((m) => [m.lat, m.lng] as [number, number]);
      if (coordenadas.length > 1) {
        mapa.fitBounds(L.latLngBounds(coordenadas).pad(0.12), { maxZoom: 10 });
      } else if (coordenadas.length === 1) {
        mapa.setView(coordenadas[0], 11);
      }
    }

    encuadrar([...capas.keys()]);

    // ---- Filtros ------------------------------------------------------------
    const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const filtro = boton.dataset.filtro!;
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));

        const visibles: string[] = [];
        capas.forEach((capa, departamento) => {
          if (filtro === 'todos' || filtro === departamento) {
            capa.addTo(mapa);
            visibles.push(departamento);
          } else {
            mapa.removeLayer(capa);
          }
        });
        encuadrar(visibles);
      });
    });

    // ---- Buscador -----------------------------------------------------------
    const formulario = document.getElementById('buscador-mapa') as HTMLFormElement | null;
    const campo = document.getElementById('buscar-municipio') as HTMLInputElement | null;
    const aviso = document.getElementById('aviso-mapa');

    function mostrarAviso(texto: string, ok: boolean) {
      if (!aviso) return;
      aviso.textContent = texto;
      aviso.classList.remove('hidden');
      aviso.style.color = ok ? 'var(--color-ok)' : 'var(--color-accent-text)';
    }

    formulario?.addEventListener('submit', (e) => {
      e.preventDefault();
      const valor = campo?.value.trim() ?? '';
      if (!valor) {
        mostrarAviso('Escribe el nombre de tu municipio.', false);
        return;
      }

      const encontrado = puntos.get(normalizar(valor));
      if (!encontrado) {
        mostrarAviso(
          `Por ahora no tenemos cobertura confirmada en "${valor}". Escríbenos y lo validamos.`,
          false,
        );
        return;
      }

      // Si estaba filtrado por otro departamento, se vuelven a mostrar todos.
      botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === 'todos')));
      capas.forEach((capa) => capa.addTo(mapa));

      const { marcador, municipio } = encontrado;
      mapa.flyTo(marcador.getLatLng(), 11, { duration: 0.8 });
      mapa.once('moveend', () => marcador.openPopup());

      // Realce temporal para que el punto buscado se distinga de los demás.
      marcador.setStyle({ weight: 5, radius: radio(municipio.clientes) + 3 });
      window.setTimeout(
        () => marcador.setStyle({ weight: 3, radius: radio(municipio.clientes) }),
        2500,
      );

      mostrarAviso(
        `Sí, llegamos a ${municipio.nombre}: ${formato.format(municipio.clientes)} clientes atendidos.`,
        true,
      );
    });

    campo?.addEventListener('input', () => aviso?.classList.add('hidden'));
  }
</script>
