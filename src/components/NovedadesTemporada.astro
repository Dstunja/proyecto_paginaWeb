---
/**
 * "Novedades y temporada": el ÚNICO bloque de novedades de producto del inicio.
 *
 * POR QUÉ UN SOLO BLOQUE
 * ----------------------
 * Antes había dos secciones seguidas —"Especiales del mes" (colaboraciones de
 * marca) y "Especiales de temporada" (Amor y Amistad, Halloween, Navidad)— con
 * títulos casi idénticos. La diferencia entre ellas es real pero es INTERNA:
 * una se cura a mano y la otra se prende y apaga por calendario. Para el
 * visitante las dos son lo mismo, "lo nuevo que hay ahora", y verlas separadas
 * solo lo obligaba a decidir cuál mirar.
 *
 * LOS DOS ARCHIVOS DE DATOS SIGUEN SEPARADOS
 * ------------------------------------------
 * Se fusionó la PRESENTACIÓN, no los datos:
 *
 *   - src/data/temporada.ts   temporadas comerciales del año, con su rango
 *                             'MM-DD'. La lógica de fechas no cambió: sigue
 *                             siendo `temporadaActiva()`.
 *   - src/data/especiales.ts  colaboraciones y ediciones especiales de marca,
 *                             elegidas a mano cada mes. La página /innovacion/
 *                             las sigue consumiendo por su lado, tal cual.
 *
 * Cada uno se edita por separado, como hasta ahora.
 *
 * ORDEN
 * -----
 * Primero los productos de la TEMPORADA vigente, que tienen fecha de
 * vencimiento y son los que hay que mover ya; después los especiales del mes,
 * que no dependen del calendario.
 *
 * Si no hay temporada activa Y no hay especiales cargados, el componente no
 * dibuja nada: la página queda igual que antes, sin títulos vacíos.
 */
import Icono from './Icono.astro';
import { ruta } from '../lib/rutas';
import { imagenOMarcador } from '../lib/imagenes';
import { especialesDelMes, periodoEspeciales } from '../data/especiales';
import { temporadaActiva, rangoLegible } from '../data/temporada';
import { empresa } from '../data/site';

const temporada = temporadaActiva();

/**
 * Una tarjeta, venga de donde venga. `etiqueta` es el distintivo naranja de la
 * esquina: dice de qué tipo de novedad se trata sin necesitar dos secciones.
 */
interface Tarjeta {
  nombre: string;
  marca: string;
  nota: string;
  etiqueta: string;
  distintivo: string;
  src: string;
  esMarcador: boolean;
}

const deTemporada: Tarjeta[] = (temporada?.productos ?? []).map((p) => ({
  nombre: p.nombre,
  marca: p.marca,
  nota: p.nota ?? '',
  etiqueta: temporada!.nombre,
  distintivo: 'tag',
  ...imagenOMarcador(p.imagen, p.nombre, 1000, 750),
}));

const deEspeciales: Tarjeta[] = especialesDelMes.map((p) => ({
  nombre: p.nombre,
  marca: p.marca,
  nota: p.descripcion,
  etiqueta: p.etiqueta ?? 'Especial del mes',
  distintivo: 'sparkles',
  ...imagenOMarcador(p.imagen, p.nombre, 1000, 750),
}));

/* La temporada va primero: tiene fecha de vencimiento. */
const tarjetas = [...deTemporada, ...deEspeciales];

/**
 * Píldoras de contexto de la cabecera: qué temporada corre y de qué mes son los
 * especiales. Solo se muestra la que tenga contenido detrás.
 */
const contexto = [
  temporada ? { icono: 'calendar', texto: `${temporada.nombre}: ${rangoLegible(temporada)}` } : null,
  deEspeciales.length > 0 ? { icono: 'sparkles', texto: periodoEspeciales } : null,
].filter((c): c is { icono: string; texto: string } => c !== null);

/**
 * Con más de tres tarjetas la sección pasa a carrusel horizontal: tres visibles
 * en escritorio, dos en tableta y una y "un poquito" de la siguiente en móvil,
 * para que se note que hay más. Nueve tarjetas grandes seguidas convertirían el
 * inicio en un catálogo.
 */
const esCarrusel = tarjetas.length > 3;

const columnas =
  tarjetas.length === 1
    ? 'max-w-[440px]'
    : tarjetas.length === 2
      ? 'mob:grid-cols-2'
      : 'mob:grid-cols-2 tablet:grid-cols-3';

/** Frase de arriba: cambia según haya temporada, especiales o las dos cosas. */
const bajada =
  deTemporada.length > 0 && deEspeciales.length > 0
    ? 'Lo de la temporada que está corriendo y las ediciones especiales que lanzaron nuestras marcas este mes. Pregúntale a tu asesor por la disponibilidad en tu zona.'
    : deTemporada.length > 0
      ? `${temporada!.descripcion} Pregúntale a tu asesor por la disponibilidad en tu zona.`
      : 'Las colaboraciones y ediciones especiales que lanzaron nuestras marcas este mes. Pregúntale a tu asesor por la disponibilidad en tu zona.';
---

{
  tarjetas.length > 0 && (
    <section
      id="novedades"
      class="section border-y border-line bg-accent-soft"
      data-seccion="novedades_temporada"
    >
      <div class="wrap">
        <div class="mb-12 flex flex-col gap-6 tablet:flex-row tablet:items-end tablet:justify-between">
          <div class="max-w-[54ch]">
            <span class="kicker">Novedades y temporada</span>
            <h2 class="text-[28px] tablet:text-[38px]">Lo nuevo que está sonando</h2>
            <p class="mt-3 mb-0 text-muted">{bajada}</p>
          </div>

          <div class="flex flex-wrap items-center gap-3 tablet:justify-end">
            {contexto.map((c) => (
              <p class="m-0 inline-flex shrink-0 items-center gap-2 rounded-full border border-accent/40 bg-surface px-4 py-2 font-display text-[13px] font-semibold text-accent-text">
                <Icono nombre={c.icono} class="h-4 w-4" interactivo={false} />
                {c.texto}
              </p>
            ))}

            {esCarrusel && (
              /* Flechas del carrusel. Van en la cabecera y no encima de las
                 tarjetas para no tapar las fotos. Se ocultan en móvil, donde
                 lo natural es deslizar. */
              <div class="hidden gap-2 mob:flex">
                <button
                  type="button"
                  class="flecha-carrusel"
                  data-prev
                  aria-label="Ver novedades anteriores"
                >
                  <Icono nombre="arrow-right" class="h-4 w-4 rotate-180" interactivo={false} />
                </button>
                <button
                  type="button"
                  class="flecha-carrusel"
                  data-next
                  aria-label="Ver más novedades"
                >
                  <Icono nombre="arrow-right" class="h-4 w-4" interactivo={false} />
                </button>
              </div>
            )}
          </div>
        </div>

        <div
          class:list={[
            esCarrusel
              ? /* Pista del carrusel. En móvil se sale del margen de la página
                   (-mx / px) para que las tarjetas lleguen al borde y se vea
                   asomar la siguiente. */
                'pista-carrusel -mx-6 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-6 pb-3 mob:-mx-8 mob:scroll-pl-8 mob:px-8 tablet:mx-0 tablet:gap-8 tablet:scroll-pl-0 tablet:px-0 motion-reduce:scroll-auto'
              : ['grid gap-6 tablet:gap-8', columnas],
          ]}
          data-carrusel={esCarrusel ? '' : undefined}
          role={esCarrusel ? 'region' : undefined}
          aria-label={esCarrusel ? 'Novedades y temporada' : undefined}
          tabindex={esCarrusel ? '0' : undefined}
        >
          {tarjetas.map((t) => (
            <article
              class:list={[
                'glass-card relative flex flex-col overflow-hidden',
                esCarrusel &&
                  'w-[84%] shrink-0 snap-start mob:w-[calc(50%-12px)] tablet:w-[calc((100%-64px)/3)]',
              ]}
            >
              {/* Filo naranja permanente: en las tarjetas del resto del sitio
                  este filo solo aparece al pasar el mouse, así que dejarlo
                  fijo aquí marca la diferencia sin cambiar el lenguaje. */}
              <span class="h-1 shrink-0 bg-accent" aria-hidden="true" />

              <div class="relative aspect-[4/3] overflow-hidden bg-surface-2">
                {/* Fondo: la misma foto desenfocada, para rellenar el hueco que
                    deja una foto vertical u horizontal sin recortarla. */}
                <div
                  class="absolute inset-0 scale-110 bg-cover bg-center opacity-60 blur-xl"
                  style={`background-image:url('${t.src}')`}
                  aria-hidden="true"
                />
                <img
                  src={t.src}
                  alt={t.esMarcador ? '' : `${t.nombre} — ${t.nota}`}
                  width="1000"
                  height="750"
                  loading="lazy"
                  class="relative h-full w-full object-contain p-3"
                />

                <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1.5 font-display text-[12px] font-semibold text-ink-dark shadow-[0_6px_16px_rgba(245,166,35,.4)]">
                  <Icono nombre={t.distintivo} class="h-3.5 w-3.5" interactivo={false} />
                  {t.etiqueta}
                </span>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <p class="m-0 text-[12px] font-semibold tracking-[0.12em] text-secondary-dark uppercase">
                  {t.marca}
                </p>
                <h3 class="mt-2 text-[18px]">{t.nombre}</h3>
                {t.nota && <p class="mt-2 mb-0 text-[14px] text-muted">{t.nota}</p>}
              </div>
            </article>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a class="btn btn-accent" href={ruta('/pedido/')}>
            Arma tu pedido
            <Icono nombre="arrow-right" class="h-[18px] w-[18px]" />
          </a>
          <a class="btn btn-secondary" href={empresa.whatsapp} target="_blank" rel="noopener">
            Preguntar por disponibilidad
            <Icono nombre="whatsapp" class="h-[18px] w-[18px]" />
          </a>
          <a
            class="group inline-flex items-center gap-2 font-display text-[15px] font-semibold text-primary transition-colors duration-200 hover:text-secondary-dark"
            href={ruta('/catalogo/')}
          >
            Ver todo el catálogo
            <Icono
              nombre="arrow-right"
              class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
              interactivo={false}
            />
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  /* La pista se desplaza sin mostrar barra: el movimiento ya lo anuncian las
     flechas y la tarjeta que asoma por el borde. */
  .pista-carrusel {
    scrollbar-width: none;
  }
  .pista-carrusel::-webkit-scrollbar {
    display: none;
  }

  /* Flechas: mismo lenguaje que los botones píldora, en versión redonda. */
  .flecha-carrusel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    border: 1px solid var(--color-primary);
    background: var(--color-surface);
    color: var(--color-primary);
    transition:
      background-color 0.2s ease-out,
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }
  .flecha-carrusel:hover:not(:disabled),
  .flecha-carrusel:focus-visible:not(:disabled) {
    background: var(--color-primary-soft);
    transform: translateY(-2px);
  }
  .flecha-carrusel:disabled {
    opacity: 0.35;
    cursor: default;
  }
</style>

<script>
  /**
   * Flechas del carrusel: cada clic avanza una tarjeta (ancho + separación)
   * y las flechas se apagan al llegar a cada extremo. El desplazamiento en sí
   * es del navegador (scroll-snap), así que deslizar con el dedo o con la
   * rueda funciona igual con o sin este script.
   */
  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((pista) => {
    const seccion = pista.closest('section');
    const prev = seccion?.querySelector<HTMLButtonElement>('[data-prev]');
    const next = seccion?.querySelector<HTMLButtonElement>('[data-next]');
    if (!prev || !next) return;

    const paso = () => {
      const tarjeta = pista.firstElementChild as HTMLElement | null;
      const separacion = parseFloat(getComputedStyle(pista).columnGap) || 0;
      return (tarjeta?.getBoundingClientRect().width ?? pista.clientWidth) + separacion;
    };

    const actualizar = () => {
      prev.disabled = pista.scrollLeft <= 2;
      next.disabled = pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 2;
    };

    prev.addEventListener('click', () => pista.scrollBy({ left: -paso(), behavior: 'smooth' }));
    next.addEventListener('click', () => pista.scrollBy({ left: paso(), behavior: 'smooth' }));
    pista.addEventListener('scroll', actualizar, { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();
  });
</script>
