---
/**
 * "Especiales de temporada": franja festiva del inicio con los productos de
 * la temporada vigente (Amor y Amistad, Halloween, Navidad...).
 *
 * Es una sección distinta de EspecialesMes.astro, que muestra las
 * colaboraciones y ediciones especiales de marca del mes. Esta se prende y se
 * apaga sola por fecha; aquella se cura a mano. Por eso los rótulos de las dos
 * son distintos: si ambas dijeran "Especiales del mes" el visitante no sabría
 * en qué se diferencian.
 *
 * Los datos y las fechas viven en src/data/temporada.ts. Si hoy no cae dentro
 * de ninguna temporada, el componente no renderiza nada: la página queda
 * exactamente igual que antes, sin huecos ni bloques vacíos.
 *
 * El acento es el naranja de marca (#F5A623), que en el sitio ya significa
 * "oferta destacada"; el resto sigue la paleta habitual.
 */
import Icono from './Icono.astro';
import { ruta } from '../lib/rutas';
import { imagenOMarcador } from '../lib/imagenes';
import { temporadaActiva, rangoLegible } from '../data/temporada';
import { empresa } from '../data/site';

const temporada = temporadaActiva();

const productos = temporada?.productos.map((p) => ({
  ...p,
  ...imagenOMarcador(p.imagen, p.nombre, 600, 450),
}));

// Con dos productos la rejilla de tres columnas dejaría un hueco a la derecha.
const columnas = (productos?.length ?? 0) >= 3 ? 'tablet:grid-cols-3' : 'tablet:grid-cols-2';
---

{
  temporada && productos && (
    <section
      id="especiales-de-temporada"
      class="section border-y border-accent/35 bg-[linear-gradient(180deg,rgba(245,166,35,.10),rgba(245,166,35,.02))]"
      data-seccion="especiales_mes"
    >
      <div class="wrap">
        <div class="mb-12 flex flex-col gap-6 tablet:flex-row tablet:items-end tablet:justify-between">
          <div class="max-w-[54ch]">
            <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent/45 bg-accent/15 px-4 py-1.5 font-display text-[12.5px] font-semibold tracking-[0.14em] text-accent-text uppercase">
              <Icono nombre="sparkles" class="h-4 w-4" interactivo={false} />
              Especiales de temporada
            </span>
            <h2 class="text-[28px] tablet:text-[38px]">{temporada.nombre}</h2>
            <p class="mt-3 text-muted">{temporada.descripcion}</p>
          </div>

          <p class="m-0 inline-flex shrink-0 items-center gap-2.5 self-start rounded-full border border-line bg-surface px-4 py-2.5 text-[13.5px] font-semibold text-ink tablet:self-auto">
            <Icono nombre="calendar" class="h-4 w-4 text-accent-text" interactivo={false} />
            Disponible del {rangoLegible(temporada)}
          </p>
        </div>

        <div class:list={['grid grid-cols-1 gap-6 mob:grid-cols-2', columnas]}>
          {productos.map((producto) => (
            <article class="group glass-card overflow-hidden">
              <div class="relative aspect-[4/3] overflow-hidden bg-surface-2">
                <img
                  src={producto.src}
                  alt={producto.esMarcador ? '' : producto.nombre}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
                <span class="absolute top-3.5 left-3.5 inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 font-display text-[12px] font-bold text-ink-dark shadow-[0_4px_14px_rgba(245,166,35,.35)]">
                  <Icono nombre="tag" class="h-3.5 w-3.5" interactivo={false} />
                  {producto.marca}
                </span>
              </div>
              <div class="p-6">
                <h3 class="m-0 text-[17px]">{producto.nombre}</h3>
                {producto.nota && <p class="mt-2 mb-0 text-[14px] text-muted">{producto.nota}</p>}
              </div>
            </article>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a class="btn btn-accent" href={ruta('/pedido/')}>
            Arma tu pedido
            <Icono nombre="arrow-right" class="h-[18px] w-[18px]" />
          </a>
          <a class="btn btn-secondary" href={empresa.whatsapp} target="_blank" rel="noopener">
            Preguntar por disponibilidad
            <Icono nombre="whatsapp" class="h-[18px] w-[18px]" />
          </a>
        </div>
      </div>
    </section>
  )
}
