---
import { testimonio } from '../data/site';
import Icono from './Icono.astro';
import { ruta } from '../lib/rutas';

const iniciales = testimonio.nombre
  .split(' ')
  .map((p) => p[0])
  .slice(0, 2)
  .join('');
---

<figure
  class="glass-card mt-10 grid grid-cols-1 items-center gap-10 px-8 py-10 text-ink tablet:grid-cols-[1.4fr_.6fr] tablet:px-12"
>
  <div>
    <div class="mb-4 flex gap-1" role="img" aria-label={`${testimonio.estrellas} de 5 estrellas`}>
      {
        Array.from({ length: 5 }).map((_, i) => (
          <Icono
            nombre="star"
            class={
              i < testimonio.estrellas
                ? 'h-[18px] w-[18px] text-accent [&_svg]:fill-current'
                : 'h-[18px] w-[18px] text-ink/25'
            }
            interactivo={false}
          />
        ))
      }
    </div>

    <blockquote class="m-0 font-display text-xl leading-snug font-semibold text-ink tablet:text-2xl">
      «{testimonio.texto}»
    </blockquote>

    <figcaption class="mt-5 text-sm text-muted">
      <span class="font-semibold text-ink">{testimonio.nombre}</span> ·
      {testimonio.negocio}, {testimonio.ciudad}
    </figcaption>
  </div>

  <div class="flex justify-start tablet:justify-end">
    {
      testimonio.foto ? (
        <img
          src={ruta(testimonio.foto)}
          alt={`${testimonio.nombre}, ${testimonio.negocio}`}
          class="h-32 w-32 rounded-full border-4 border-line object-cover"
        />
      ) : (
        /* EDITAR AQUÍ: al cargar la foto real en `testimonio.foto`
           (src/data/site.ts) se reemplazan estas iniciales. */
        <div class="flex h-32 w-32 items-center justify-center rounded-full border-4 border-line bg-secondary font-display text-4xl font-bold text-white">
          {iniciales}
        </div>
      )
    }
  </div>
</figure>
