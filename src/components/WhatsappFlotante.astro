---
import Icono from './Icono.astro';
import { esActual } from '../lib/rutas';
import { MENSAJE_PEDIDO, enlacePedido } from '../lib/whatsapp-pedido';

/**
 * En /pedido/ este botón no se muestra: ahí el mismo rincón lo ocupa el botón
 * "Ver mi pedido", y esa página ya lleva a WhatsApp por dos caminos (el envío
 * del pedido armado y el enlace para escribir directo sin lista).
 *
 * Va al WhatsApp de pedidos (ver src/lib/whatsapp-pedido.ts).
 */
const ocultar = esActual('/pedido/', Astro.url.pathname);
---

{
  !ocultar && (
    <a
      href={enlacePedido(MENSAJE_PEDIDO)}
      target="_blank"
      rel="noopener"
      class="group fixed right-6 bottom-6 z-[150] flex h-14 w-14 items-center justify-center rounded-full
             bg-whatsapp text-white shadow-[0_8px_20px_rgba(0,0,0,.2)]
             transition-all duration-200 hover:brightness-95 focus-visible:brightness-95"
      aria-label="Escríbenos por WhatsApp"
      data-whatsapp-flotante
    >
      <Icono nombre="whatsapp" class="h-7 w-7" />
    </a>
  )
}
