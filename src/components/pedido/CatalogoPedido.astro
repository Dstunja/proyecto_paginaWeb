---
/**
 * Catálogo del armador de pedidos: filtros, buscador y grilla de tarjetas.
 *
 * CÓMO LLEGAN LOS PRODUCTOS AL NAVEGADOR
 * --------------------------------------
 * En dos tiempos, y a propósito.
 *
 * 1. LA PRIMERA PANTALLA SE IMPRIME EN EL BUILD. Las secciones de las 34
 *    marcas y las primeras 24 tarjetas (la marca que abre desplegada) salen
 *    del servidor como HTML de verdad, con `vistaPorMarcas`. Se ven apenas
 *    llega el documento: sin esperar a que se descargue, se analice y se
 *    ejecute el JavaScript, y también si el JavaScript nunca llega -conexión
 *    mala, script bloqueado, navegador con JS desactivado-. Antes el
 *    contenedor salía vacío y la página no servía para nada hasta que
 *    arrancaba el script.
 *
 * 2. EL RESTO SE PINTA EN EL NAVEGADOR. Las 709 referencias no se imprimen
 *    como HTML: eso serían más de medio mega de marcado y unos 700 campos de
 *    formulario en el árbol de accesibilidad, cuando de entrada solo se ven
 *    unas pocas decenas. En su lugar se emite un bloque JSON (~20 KB
 *    comprimidos) y el script pinta lo que se esté mirando: la marca abierta,
 *    de a tandas.
 *
 * Las dos etapas usan las MISMAS plantillas (src/lib/plantillasCatalogo.ts),
 * así que el HTML del build y el que pinta el script son idénticos: cuando el
 * script arranca no repinta nada, adopta lo que ya está en pantalla y solo le
 * aplica el pedido guardado. Por eso no hay parpadeo ni salto de la grilla.
 *
 * Del producto solo viajan los campos que se usan. `codigoParcial`, `embalaje`
 * y `paginaPdf` son notas internas y se quedan en el servidor; el `codigo` SAP
 * viaja porque va en el mensaje que recibe el asesor, no porque se muestre.
 * `precio` viaja solo cuando la referencia lo tiene: hoy son 107 de las 709, y
 * las demás tarjetas simplemente no muestran renglón de precio.
 *
 * Sin JavaScript quedan el listado de marcas y las primeras tarjetas, pero no
 * el buscador, los filtros ni el carrito: esos controles se ocultan (no sirve
 * de nada un buscador que no busca) y en su lugar aparece un aviso con la
 * salida por WhatsApp.
 */
import { getImage } from 'astro:assets';
import { productos, MARCAS, CATEGORIAS, SUBCATEGORIAS } from '../../data/productos';
import { imagenSiExiste, logoMarcaImagen } from '../../lib/imagenes';
import { codigosSinProducto, precioSugerido } from '../../lib/precios';
import { ruta } from '../../lib/rutas';
import { TAMANO_TANDA } from '../../data/pedido';
import {
  agruparPorMarca,
  conteoSinFiltro,
  vistaPorMarcas,
  type EstadoCatalogo,
} from '../../lib/plantillasCatalogo';
import Icono from '../Icono.astro';
import LoaderDST from '../LoaderDST.astro';
import { empresa } from '../../data/site';

/**
 * Lo que se le manda al navegador de cada producto.
 *
 * `imagen` solo viaja cuando la referencia tiene foto propia Y el archivo
 * existe de verdad (ver `fotoDe`, que ya le antepone el `base`). El resto
 * llega sin el campo y la tarjeta cae en el logotipo de la marca. Conectar una
 * foto nueva es entonces solo dejar el archivo en src/assets/productos/ con el
 * código SAP por nombre y nombrarlo en `imagen` dentro de
 * src/data/productos.ts: aquí y en la tarjeta no hay que tocar nada.
 */
/**
 * Fotos oficiales del fabricante, descargadas de la tienda de Nutresa y
 * guardadas en src/assets/productos/ con el CODIGO SAP por nombre de archivo.
 *
 * Van por src/assets/ y no por public/ a proposito: los originales son de
 * 1000-1200 px y pesan entre 20 y 300 KB cada uno, pero en la tarjeta se ven a
 * menos de 200 px. Al pasar por `getImage` el navegador recibe un WebP de
 * 400 px -una fraccion del peso- y el original nunca se publica. Por public/
 * habria que servir los 466 archivos tal cual.
 */
const archivosFoto = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/productos/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const fotos: Record<string, string> = {};
for (const [rutaArchivo, modulo] of Object.entries(archivosFoto)) {
  const nombre = rutaArchivo.split('/').pop() as string;
  fotos[nombre] = (await getImage({ src: modulo.default, width: 400, format: 'webp' })).src;
}

/**
 * Resuelve el campo `imagen` de una referencia, que admite dos formas:
 *
 *  - nombre de archivo suelto ("1078187.png"): foto oficial en
 *    src/assets/productos/, optimizada arriba.
 *  - ruta absoluta ("/img/innovacion/...jpg"): las fotos que ya estaban en
 *    public/, de las referencias de innovacion.
 *
 * Devuelve null si el archivo no existe, y entonces la tarjeta cae en el
 * logotipo de la marca. Esa red de seguridad es la que evita que una ruta mal
 * escrita saque una imagen rota en el armador.
 */
function fotoDe(imagen: string | undefined): string | null {
  if (!imagen) return null;
  if (imagen.startsWith('/')) return imagenSiExiste(imagen);
  return fotos[imagen] ?? null;
}

const catalogo = productos.map((p) => {
  const imagen = fotoDe(p.imagen);
  // El precio se resuelve aquí, en el build: manda la corrección manual de
  // src/data/precios.ts y, si no hay, el PSP que el maestro trajo del deck
  // (ver `precioSugerido` en src/lib/precios.ts). Solo viaja al navegador el de
  // las referencias que lo tienen; las demás llegan sin el campo.
  const psp = precioSugerido(p);
  return {
    id: p.id,
    marca: p.marca,
    categoria: p.categoria,
    ...(p.subcategoria ? { subcategoria: p.subcategoria } : {}),
    nombre: p.nombre,
    presentacion: p.presentacion,
    codigo: p.codigo,
    ...(imagen ? { imagen } : {}),
    ...(psp !== null ? { psp } : {}),
  };
});

/** Cuántas referencias tienen precio sugerido: se dice bajo el buscador. */
const conPrecio = catalogo.filter((p) => 'psp' in p).length;

/* Aviso de mantenimiento, solo en consola durante `npm run build`: un código de
   src/data/precios.ts que no corresponda a ninguna referencia no rompe nada,
   pero conviene limpiarlo antes de que se acumulen. */
const sobrantes = codigosSinProducto(productos);
if (sobrantes.length > 0) {
  console.warn(
    `[precios] ${sobrantes.length} código(s) de src/data/precios.ts no existen en el catálogo: ${sobrantes.join(', ')}`,
  );
}

/**
 * Logotipo de cada marca, si ya está subido a src/assets/marcas/.
 * Es el respaldo de las referencias que todavía no tienen foto propia; si
 * tampoco hay logotipo, la tarjeta muestra las iniciales de la marca.
 *
 * Aquí las tarjetas las arma JavaScript en el navegador a partir de este
 * JSON, así que no se puede usar <Image> y hace falta una URL suelta. Con
 * `getImage` se consigue igual la copia optimizada en WebP: una sola por
 * marca, del tamaño del cuadro más grande donde aparece un logotipo en esta
 * pantalla (80x80, o 160 px para las pantallas de alta densidad), que sirve
 * también para el emblema de 32 px de la cabecera de cada marca.
 *
 * `escala` nunca pasa de 1: un archivo más pequeño que la caja se sirve tal
 * cual en vez de agrandarse, que es el mismo criterio de altoSeguroLogo.
 */
const LADO_LOGO = 160;

const logos = Object.fromEntries(
  await Promise.all(
    MARCAS.map(async (marca) => {
      const imagen = logoMarcaImagen(marca);
      if (!imagen) return [marca, null] as const;

      const escala = Math.min(1, LADO_LOGO / imagen.width, LADO_LOGO / imagen.height);
      const optimizada = await getImage({
        src: imagen,
        width: Math.round(imagen.width * escala),
        format: 'webp',
        quality: 90,
      });
      return [marca, optimizada.src] as const;
    }),
  ),
);

/** Solo las categorías que efectivamente tienen productos. */
const categoriasUsadas = CATEGORIAS.filter((c) => productos.some((p) => p.categoria === c));

/**
 * SUBCATEGORÍAS: EL SEGUNDO NIVEL DEL FILTRO
 * ------------------------------------------
 * Las 14 categorías son los chips de la barra; las subcategorías NO lo son.
 * Poner los dos niveles en la misma tira daría 65 chips en fila y borraría la
 * jerarquía, que es justamente lo que se quiso arreglar. Van entonces dentro
 * del panel de "Filtros", como un segundo nivel que solo aparece cuando ya se
 * eligió la categoría a la que pertenecen.
 *
 * Se imprimen los 14 grupos en el build y el script muestra el que toque. Es
 * marcado de sobra -51 casillas- pero evita tener que armar el panel con
 * plantillas en el navegador cada vez que se toca un chip, y deja el estado
 * inicial correcto sin esperar al script.
 */
const conteoSub = new Map<string, number>();
for (const p of productos) {
  if (p.subcategoria) {
    const clave = `${p.categoria}|${p.subcategoria}`;
    conteoSub.set(clave, (conteoSub.get(clave) ?? 0) + 1);
  }
}

/** Categorías con subcategorías, ya en el orden en que se ofrecen. */
const gruposSub = categoriasUsadas
  .map((c) => ({ categoria: c, subs: SUBCATEGORIAS[c] ?? [] }))
  .filter((g) => g.subs.length > 0);

/**
 * Cuántas referencias tiene cada marca, y las marcas que tienen alguna.
 *
 * El número va al lado del nombre en el panel de filtros: sirve para saber de
 * antemano si vale la pena marcarla, y de paso deja claro que el portafolio no
 * está repartido en partes iguales (Noel pesa mucho más que Copelia).
 */
const conteoMarca = new Map<string, number>();
for (const p of productos) conteoMarca.set(p.marca, (conteoMarca.get(p.marca) ?? 0) + 1);
const marcasUsadas = MARCAS.filter((m) => conteoMarca.has(m));

/**
 * LA PRIMERA PANTALLA, PINTADA EN EL BUILD
 * ----------------------------------------
 * Es exactamente el estado inicial que tendría el script recién arrancado: sin
 * pedido guardado (el localStorage no existe en el servidor), sin ninguna tanda
 * ampliada y con la primera marca del catálogo desplegada. Al coincidir campo
 * por campo con lo que el navegador pintaría, el script puede quedarse con este
 * HTML en vez de reemplazarlo.
 *
 * `ansiosas` deja las seis primeras fotos sin `loading="lazy"`: son las que
 * caen sobre la línea de flotación, así que diferirlas solo retrasaría la
 * imagen que mide el LCP.
 */
const porMarca = agruparPorMarca(catalogo);
const marcas = [...porMarca.keys()];
const primeraMarca = marcas[0];

const estadoInicial: EstadoCatalogo = {
  logos,
  enPedido: () => 0,
  cantidad: () => 1,
  visibles: () => TAMANO_TANDA,
  abierta: (marca) => marca === primeraMarca,
  ansiosas: 6,
};

const htmlInicial = vistaPorMarcas(porMarca, estadoInicial);
const conteoInicial = conteoSinFiltro(catalogo.length, marcas.length);
const productosVisibles = Math.min(porMarca.get(primeraMarca ?? '')?.length ?? 0, TAMANO_TANDA);

const mensajeSinJs = encodeURIComponent(
  'Hola, quiero hacer un pedido y necesito que un asesor me acompañe.',
);

/**
 * JSON dentro de un `<script>`: hay que neutralizar `<` para que un texto no
 * pueda cerrar la etiqueta antes de tiempo.
 */
const aJson = (valor: unknown) => JSON.stringify(valor).replace(/</g, '\\u003c');
---

{/*
  Marca el documento como "con JavaScript" antes de que se pinte nada más, para
  que los controles que solo funcionan con script no lleguen a verse en un
  navegador que lo tiene desactivado, y para que el aviso de "activando…" no le
  aparezca a quien nunca lo va a ver desaparecer. Va en línea y sin `type` a
  propósito: tiene que ejecutarse en el acto, no cuando llegue el módulo.

  El temporizador es la red de seguridad del caso feo: el JavaScript está
  activo pero el módulo del catálogo nunca llega (red caída a mitad, script
  bloqueado por la red de la tienda, error de sintaxis). Ahí el aviso se
  quedaría girando para siempre, así que a los diez segundos se convierte en
  una explicación con salida por WhatsApp. Las tarjetas ya impresas siguen ahí.
*/}
<script is:inline>
  document.documentElement.dataset.js = '1';
  setTimeout(function () {
    var aviso = document.querySelector('[data-cargando]');
    if (aviso) aviso.dataset.cargando = 'falló';
  }, 10000);
</script>

<style is:global>
  /*
   * Sin JavaScript: fuera el buscador, los filtros y el aviso de carga. Lo que
   * queda -las marcas y las primeras tarjetas- se lee perfectamente, y para lo
   * demás está el bloque <noscript>.
   */
  html:not([data-js]) [data-solo-js] {
    display: none !important;
  }

  /*
   * Los controles del pedido (cantidad, "Agregar") y el botón "Ver más" van
   * dentro de la grilla que imprime el build, así que sin JavaScript quedarían
   * a la vista sin hacer absolutamente nada. Es mejor no ofrecerlos: lo que
   * queda es un catálogo para mirar, que es justo lo que anuncia el <noscript>.
   */
  html:not([data-js]) [data-controles],
  html:not([data-js]) [data-mas-caja] {
    display: none !important;
  }

  /* El aviso de carga tiene dos textos y se muestra el que toque. */
  [data-cargando] [data-falla],
  [data-cargando='falló'] [data-espera] {
    display: none;
  }
  [data-cargando='falló'] [data-falla] {
    display: block;
  }

  /* Falló la carga: fuera el logotipo animado. Seguir girando al lado de un
     mensaje de error hace pensar que todavía está intentándolo. */
  [data-cargando='falló'] [data-loader] {
    display: none;
  }
</style>

<script type="application/json" id="datos-catalogo" set:html={aJson(catalogo)} is:inline></script>
<script type="application/json" id="datos-marcas" set:html={aJson(logos)} is:inline></script>

{/* ---- Filtros: quedan pegados bajo la barra fija al desplazar ----

     ORDEN DE LECTURA, DE LO MÁS USADO A LO MENOS USADO
     --------------------------------------------------
      1. BUSCADOR, siempre a la vista: es el atajo de quien ya sabe qué
         quiere ("saltín", "café 500").
      2. CATEGORÍAS en chips, también a la vista: es como se recorre el
         surtido de una tienda. Son 38, así que por defecto van en una sola
         fila que se desplaza de lado y el botón de la derecha las abre todas.
      3. MARCAS dentro del panel plegado. Son 34 y se llevaban una tira
         entera de la barra fija para el filtro que menos se usa; ahora se
         piden a propósito y el botón "Filtros" dice cuántas hay puestas.

     Sin JavaScript la barra entera desaparece (`data-solo-js`): no filtra
     nada, y unos controles muertos confunden más de lo que ayudan. La oculta
     una regla de CSS que depende del `data-js` que pone el script en línea de
     arriba, no el módulo del catálogo: así aparece en el primer pintado, sin
     el salto que daría la grilla si la barra se encendiera al terminar de
     cargar.
*/}
<div
  class="barra-fija sticky top-[var(--nav-h)] z-40 -mx-6 mb-8 px-6 py-4 mob:-mx-8 mob:px-8"
  data-filtros
  data-solo-js
>
  <div class="mx-auto flex w-full max-w-[var(--container-site)] flex-col gap-3">
    {/* --- 1. Buscador, con el acceso al panel de marcas al lado --- */}
    <div class="flex flex-col gap-3 tablet:flex-row tablet:items-center">
      <div class="relative flex-1">
        <span
          class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted"
          aria-hidden="true"
        >
          <Icono nombre="search" class="h-[18px] w-[18px]" interactivo={false} />
        </span>
        <label class="sr-only" for="buscador">
          Buscar producto por nombre, marca, categoría o presentación
        </label>
        <input
          id="buscador"
          type="search"
          class="field !pl-11"
          placeholder="Buscar por producto, marca o categoría…"
          autocomplete="off"
          data-buscador
        />
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <button
          type="button"
          class="chip-filtro group !py-2.5"
          aria-expanded="false"
          aria-controls="panel-marcas"
          data-abrir-panel
        >
          <Icono nombre="sliders" class="h-[17px] w-[17px]" interactivo={false} />
          <span>Filtros</span>
          {/* El número de marcas puestas; el script lo muestra y lo oculta. */}
          <span class="conteo-filtro hidden" data-conteo-marcas>0</span>
          <Icono
            nombre="chevron-down"
            class="h-4 w-4 transition-transform duration-300 group-aria-expanded:rotate-180"
            interactivo={false}
          />
        </button>

        {/* Un solo botón deja el catálogo como estaba: sin texto, sin
            categorías y sin marcas. Solo aparece cuando hay algo que quitar. */}
        <button type="button" class="chip-filtro hidden !py-2.5" data-limpiar>
          <Icono nombre="close" class="h-4 w-4" interactivo={false} />
          <span>Limpiar filtros</span>
        </button>
      </div>
    </div>

    {/* --- 2. Categorías: chips de selección múltiple --- */}
    <div class="flex items-start gap-2">
      <div
        class="tira-categorias"
        id="tira-categorias"
        data-abierta="no"
        role="group"
        aria-label="Filtrar por categoría"
        data-categorias
      >
        <button type="button" class="chip-filtro" data-categoria="" aria-pressed="true">
          Todas
        </button>
        {
          categoriasUsadas.map((c) => (
            <button type="button" class="chip-filtro" data-categoria={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>

      {/* Este botón hace dos cosas a la vez: abre la tira completa y lleva el
          contador de categorías activas, que si no quedaría fuera de vista
          apenas la tira se desplaza un poco. */}
      <button
        type="button"
        class="chip-filtro group"
        aria-expanded="false"
        aria-controls="tira-categorias"
        data-ver-categorias
      >
        <span>Categorías</span>
        <span class="conteo-filtro hidden" data-conteo-categorias>0</span>
        <Icono
          nombre="chevron-down"
          class="h-4 w-4 transition-transform duration-300 group-aria-expanded:rotate-180"
          interactivo={false}
        />
      </button>
    </div>

    {/* --- 3. Panel de filtros (subcategorías y marcas), plegado de entrada --- */}
    <div class="hidden" id="panel-marcas" data-panel-marcas>
      <div class="flex flex-col gap-3">
      {/* Subcategorías: el segundo nivel. Cada grupo está oculto hasta que se
          elige su categoría, y el bloque entero desaparece si ninguna de las
          categorías elegidas tiene subcategorías. */}
      <fieldset class="hidden rounded-card border border-line bg-fondo p-4" data-caja-subs>
        <legend class="sr-only">Afinar dentro de la categoría</legend>

        <div class="mb-3 flex items-center justify-between gap-3">
          <p
            class="m-0 font-display text-[12px] font-semibold tracking-[0.12em] text-muted uppercase"
          >
            Dentro de la categoría
          </p>
          <button
            type="button"
            class="hidden text-[13px] font-semibold text-secondary-dark underline"
            data-limpiar-subs
          >
            Quitar subcategorías
          </button>
        </div>

        <div class="flex flex-col gap-3">
          {
            gruposSub.map((g) => (
              <div class="hidden" data-grupo-sub={g.categoria}>
                <p class="m-0 mb-1.5 text-[13px] font-semibold">{g.categoria}</p>
                <div class="grid grid-cols-1 gap-1 mob:grid-cols-2 tablet:grid-cols-3">
                  {g.subs.map((s) => (
                    <label class="opcion-marca">
                      <input
                        type="checkbox"
                        value={s}
                        data-sub
                        data-sub-categoria={g.categoria}
                      />
                      <span class="truncate">{s}</span>
                      <span class="ml-auto text-[12px] font-normal text-muted">
                        {conteoSub.get(`${g.categoria}|${s}`)}
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="rounded-card border border-line bg-fondo p-4">
        <legend class="sr-only">Filtrar por marca</legend>

        <div class="mb-3 flex items-center justify-between gap-3">
          <p
            class="m-0 font-display text-[12px] font-semibold tracking-[0.12em] text-muted uppercase"
          >
            Marcas ({marcasUsadas.length})
          </p>
          <button
            type="button"
            class="hidden text-[13px] font-semibold text-secondary-dark underline"
            data-limpiar-marcas
          >
            Quitar marcas
          </button>
        </div>

        {/* Rejilla con tope de alto: el panel no puede empujar los resultados
            fuera de la pantalla, así que a partir de cierto punto se desplaza
            por dentro. */}
        <div
          class="grid max-h-[min(320px,38vh)] grid-cols-1 gap-1 overflow-y-auto mob:grid-cols-2 tablet:grid-cols-3 nav:grid-cols-4"
        >
          {
            marcasUsadas.map((m) => (
              <label class="opcion-marca">
                <input type="checkbox" value={m} data-marca />
                <span class="truncate">{m}</span>
                <span class="ml-auto text-[12px] font-normal text-muted">{conteoMarca.get(m)}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      </div>
    </div>
  </div>
</div>

<noscript>
  <div class="glass-card mb-10 p-6">
    <h2 class="m-0 text-lg">Estás viendo el catálogo sin JavaScript</h2>
    <p class="mt-3 text-muted">
      Abajo tienes las {marcas.length} marcas y las primeras {productosVisibles} referencias, pero el
      buscador, los filtros y el armador de pedidos necesitan JavaScript para funcionar. Actívalo
      para armar tu lista, mira <a
        class="font-semibold text-secondary-dark underline"
        href={ruta('/catalogo/')}>el catálogo de marcas</a
      > o{' '}
      <a
        class="font-semibold text-secondary-dark underline"
        href={`${empresa.whatsapp}?text=${mensajeSinJs}`}
        target="_blank"
        rel="noopener">escríbenos por WhatsApp</a
      > y un asesor te toma el pedido.
    </p>
  </div>
</noscript>

{/* ---- Resultados ---- */}
<div class="mb-6 flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
  <p class="m-0 text-[14.5px] text-muted" role="status" aria-live="polite" data-conteo>
    {conteoInicial}
  </p>

  {/* Cuántas referencias traen precio. Se dice una sola vez, aquí, en vez de
      repetir un "consultar" en las tarjetas que no lo tienen. */}
  {
    conPrecio > 0 && (
      <p class="m-0 text-[13.5px] text-muted">
        {conPrecio} de {catalogo.length} con precio sugerido de referencia.
      </p>
    )
  }
</div>

{/*
  Aviso del PASO 2: las tarjetas de abajo ya están, lo que falta es el resto
  del catálogo y los controles. Lo quita el script en cuanto termina de
  engancharse, y nunca se muestra si el navegador no tiene JavaScript.

  Va ENCIMA de la grilla y no debajo: debajo quedaría al final de las 34
  secciones de marca, a varias pantallas de distancia, y un aviso de "esto
  todavía está cargando" que hay que ir a buscar no le sirve a nadie.
*/}
<div
  class="mb-6 flex items-center gap-3 text-[14px] text-muted"
  data-cargando=""
  data-solo-js
  role="status"
  aria-live="polite"
>
  {/* OJO: este contenedor es un <div> y no un <p>. LoaderDST tiene un <div>
      por raíz, y el navegador cierra cualquier <p> al encontrarse uno: el
      logotipo terminaría fuera del aviso y el aviso, vacío y sin alto.

      El isotipo de la marca haciendo de indicador de espera (LoaderDST.astro),
      el mismo que usa el mapa del inicio. Va a 40 px y no a su tamaño natural
      porque aquí es un renglón, no una pantalla en blanco: debajo ya están
      impresas las primeras tarjetas y el aviso no debe empujarlas.

      `anuncia={false}`: este contenedor ya es la región viva, y su texto cambia si la
      carga falla. Dentro de ella el logotipo es decoración.

      Se esconde en el estado de fallo (ver la hoja de estilos de arriba): un
      logotipo girando junto a "no se pudieron cargar" se contradice. */}
  <span class="shrink-0" data-loader>
    <LoaderDST tamano={40} anuncia={false} />
  </span>
  <span data-espera>Cargando el resto del catálogo, el buscador y los filtros…</span>
  <span data-falla>
    No se pudieron cargar el buscador ni los filtros. Puedes seguir viendo las referencias de abajo
    o{' '}
    <a
      class="font-semibold text-secondary-dark underline"
      href={`${empresa.whatsapp}?text=${mensajeSinJs}`}
      target="_blank"
      rel="noopener">escribirnos por WhatsApp</a
    >.
  </span>
</div>

<div data-resultados class="min-h-[40vh]" set:html={htmlInicial} />

<script>
  import {
    alCambiarPedido,
    cantidadDe,
    guardarPedido,
    leerPedido,
    obtenerProducto,
    registrarProductos,
    sumarCantidad,
    type ProductoPedido,
  } from '../../lib/carrito';
  import { CANTIDAD_MAXIMA, TAMANO_TANDA } from '../../data/pedido';
  import {
    agruparPorMarca,
    conteoSinFiltro,
    grilla,
    unidades,
    vistaPorMarcas,
    type EstadoCatalogo,
  } from '../../lib/plantillasCatalogo';
  import { limpiarTermino, registrarEvento } from '../../lib/analitica';

  const contenedor = document.querySelector<HTMLElement>('[data-resultados]');
  const barra = document.querySelector<HTMLElement>('[data-filtros]');
  const buscador = document.querySelector<HTMLInputElement>('[data-buscador]');
  const tiraCategorias = document.querySelector<HTMLElement>('[data-categorias]');
  const panelMarcas = document.querySelector<HTMLElement>('[data-panel-marcas]');
  const botonPanel = document.querySelector<HTMLButtonElement>('[data-abrir-panel]');
  const botonCategorias = document.querySelector<HTMLButtonElement>('[data-ver-categorias]');
  const conteo = document.querySelector<HTMLElement>('[data-conteo]');

  if (
    contenedor &&
    barra &&
    buscador &&
    tiraCategorias &&
    panelMarcas &&
    botonPanel &&
    botonCategorias &&
    conteo
  ) {
    const leerJson = <T,>(id: string, porDefecto: T): T => {
      const nodo = document.getElementById(id);
      if (!nodo?.textContent) return porDefecto;
      try {
        return JSON.parse(nodo.textContent) as T;
      } catch {
        return porDefecto;
      }
    };

    const catalogo = leerJson<ProductoPedido[]>('datos-catalogo', []);
    const logos = leerJson<Record<string, string | null>>('datos-marcas', {});
    registrarProductos(catalogo);

    /** Texto normalizado (sin tildes) para que "saltin" encuentre "Saltín". */
    const normalizar = (v: string) =>
      v
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '') // quita las tildes que deja NFD
        .toLowerCase();

    const indice = new Map<string, string>();
    for (const p of catalogo) {
      indice.set(
        p.id,
        normalizar(
          `${p.marca} ${p.nombre} ${p.presentacion} ${p.categoria} ${p.subcategoria ?? ''}`,
        ),
      );
    }

    /** Marcas en el orden en que aparecen, con su listado de productos. */
    const porMarca = agruparPorMarca(catalogo);
    const marcas = [...porMarca.keys()];

    // --- Estado de la vista -------------------------------------------------
    let consulta = '';
    /**
     * Categorías y marcas elegidas, las dos de selección múltiple.
     *
     * Dentro de un mismo grupo las opciones SUMAN (café o galletas) y entre
     * grupos RESTRINGEN (café y de marca Sello Rojo): es lo que ya espera
     * quien ha comprado en cualquier tienda en línea. El conjunto vacío
     * significa "todas", así que no hace falta un valor centinela ni un
     * estado aparte para "sin filtrar".
     */
    const categoriasSel = new Set<string>();
    const marcasSel = new Set<string>();
    /**
     * Subcategorías elegidas, agrupadas por la categoría a la que pertenecen.
     *
     * Es un segundo nivel, no un filtro más al mismo nivel: una subcategoría
     * solo AFINA dentro de su categoría, y las demás categorías elegidas no se
     * ven afectadas. Con "Pastas › Largas" y "Café" puestos a la vez, pasan los
     * spaghetti y TODO el café, no solo el café que estuviera en una
     * subcategoría llamada "Largas".
     *
     * Se guardan por categoría en vez de en un conjunto plano para que esa
     * regla se lea directamente en el filtro, y para poder soltar de golpe las
     * subcategorías de una categoría cuando se apaga su chip.
     */
    const subsSel = new Map<string, Set<string>>();
    /**
     * Marcas desplegadas en la vista por secciones. Arranca con la primera, que
     * es justo la que el build dejó abierta en el HTML.
     */
    const abiertas = new Set<string>(marcas.slice(0, 1));
    /** Cuántas tarjetas se están mostrando en cada lista (clave: marca o ''). */
    const tandas = new Map<string, number>();
    /** Cantidad escrita en cada tarjeta, todavía sin agregar. */
    const cantidades = new Map<string, number>();

    let pedido = leerPedido();

    const cantidadEnTarjeta = (id: string) => cantidades.get(id) ?? 1;

    /**
     * El estado que leen las plantillas. Es el mismo objeto que arma el
     * frontmatter para el build, solo que aquí las respuestas salen del estado
     * vivo en vez de ser fijas.
     */
    const estado: EstadoCatalogo = {
      logos,
      enPedido: (id) => cantidadDe(pedido, id),
      cantidad: cantidadEnTarjeta,
      visibles: (clave) => tandas.get(clave) ?? TAMANO_TANDA,
      abierta: (marca) => abiertas.has(marca),
    };

    /** Cuántas subcategorías hay puestas, sumando todas las categorías. */
    const totalSubs = () => {
      let n = 0;
      for (const elegidas of subsSel.values()) n += elegidas.size;
      return n;
    };

    const filtrar = (): ProductoPedido[] => {
      const q = normalizar(consulta.trim());
      return catalogo.filter((p) => {
        if (marcasSel.size && !marcasSel.has(p.marca)) return false;
        if (categoriasSel.size && !categoriasSel.has(p.categoria)) return false;
        // El segundo nivel solo se aplica dentro de su propia categoría: si
        // esta no tiene subcategorías puestas, el producto pasa igual.
        const elegidas = subsSel.get(p.categoria);
        if (elegidas?.size && !elegidas.has(p.subcategoria ?? '')) return false;
        if (q && !indice.get(p.id)?.includes(q)) return false;
        return true;
      });
    };

    /** Sin ningún filtro el catálogo se recorre por marcas; con filtro, plano. */
    const hayFiltro = () =>
      Boolean(consulta.trim()) || categoriasSel.size > 0 || marcasSel.size > 0 || totalSubs() > 0;

    /**
     * Los filtros activos dichos en palabras: "con 2 categorías y 1 marca".
     *
     * Es el mismo dato que llevan los contadores de la barra, pero va en el
     * párrafo de resultados, que es la región `aria-live` del listado: quien
     * usa lector de pantalla se entera de lo que quedó aplicado sin tener que
     * recorrer los controles.
     */
    const descripcionFiltros = (): string => {
      const partes: string[] = [];
      const texto = consulta.trim();
      if (texto) partes.push(`el texto “${texto}”`);
      if (categoriasSel.size)
        partes.push(
          `${categoriasSel.size} ${categoriasSel.size === 1 ? 'categoría' : 'categorías'}`,
        );
      const subs = totalSubs();
      if (subs) partes.push(`${subs} ${subs === 1 ? 'subcategoría' : 'subcategorías'}`);
      if (marcasSel.size)
        partes.push(`${marcasSel.size} ${marcasSel.size === 1 ? 'marca' : 'marcas'}`);
      if (!partes.length) return '';
      const ultima = partes.pop() as string;
      return ` con ${partes.length ? `${partes.join(', ')} y ${ultima}` : ultima}`;
    };

    // --- Pintado ------------------------------------------------------------
    const render = () => {
      // Al reconstruir el HTML se pierde el foco del teclado: se anota qué
      // control estaba activo y se le devuelve al elemento equivalente.
      const activo = document.activeElement;
      const foco = activo instanceof HTMLElement ? activo.dataset.foco : undefined;

      if (hayFiltro()) {
        const lista = filtrar();
        conteo.textContent = lista.length
          ? `${lista.length} de ${catalogo.length} ${lista.length === 1 ? 'producto' : 'productos'}${descripcionFiltros()}.`
          : `Ningún producto coincide${descripcionFiltros()}.`;
        contenedor.innerHTML = lista.length
          ? grilla(lista, '', estado)
          : `<div class="glass-card p-8 text-center">
               <p class="m-0 text-muted">Prueba con otro nombre, otra categoría u otra marca.</p>
               <button type="button" class="btn btn-secondary mt-5" data-limpiar>Limpiar filtros</button>
             </div>`;
      } else {
        conteo.textContent = conteoSinFiltro(catalogo.length, marcas.length);
        contenedor.innerHTML = vistaPorMarcas(porMarca, estado);
      }

      if (foco) {
        contenedor.querySelector<HTMLElement>(`[data-foco="${CSS.escape(foco)}"]`)?.focus();
      }
    };

    /**
     * Refresca solo lo que depende del pedido (el aviso "En tu pedido" y el
     * borde de la tarjeta). Se evita repintar toda la grilla para no
     * interrumpir a quien está escribiendo una cantidad.
     */
    const refrescarEstados = () => {
      contenedor.querySelectorAll<HTMLElement>('[data-tarjeta]').forEach((tarjeta) => {
        const id = tarjeta.dataset.tarjeta ?? '';
        const n = cantidadDe(pedido, id);
        const aviso = tarjeta.querySelector<HTMLElement>('[data-en-pedido]');
        if (aviso) {
          aviso.textContent = `En tu pedido: ${unidades(n)}`;
          aviso.classList.toggle('hidden', n === 0);
        }
        tarjeta.classList.toggle('!border-secondary/60', n > 0);
      });
    };

    // --- Interacción --------------------------------------------------------
    const conteoMarcas = barra.querySelector<HTMLElement>('[data-conteo-marcas]');
    const conteoCategorias = barra.querySelector<HTMLElement>('[data-conteo-categorias]');
    const limpiarTodoBoton = barra.querySelector<HTMLButtonElement>('[data-limpiar]');
    const limpiarMarcasBoton = panelMarcas.querySelector<HTMLButtonElement>('[data-limpiar-marcas]');
    const cajaSubs = panelMarcas.querySelector<HTMLElement>('[data-caja-subs]');
    const limpiarSubsBoton = panelMarcas.querySelector<HTMLButtonElement>('[data-limpiar-subs]');

    /**
     * Muestra los grupos de subcategorías de las categorías elegidas y esconde
     * los demás; si ninguna de las elegidas tiene segundo nivel, se va la caja
     * entera. Así el panel nunca ofrece las 51 casillas de golpe: solo las que
     * afinan algo que ya está puesto.
     */
    const pintarSubs = () => {
      let visibles = 0;
      panelMarcas.querySelectorAll<HTMLElement>('[data-grupo-sub]').forEach((grupo) => {
        const mostrar = categoriasSel.has(grupo.dataset.grupoSub ?? '');
        grupo.classList.toggle('hidden', !mostrar);
        if (mostrar) visibles++;
      });
      cajaSubs?.classList.toggle('hidden', visibles === 0);
      limpiarSubsBoton?.classList.toggle('hidden', totalSubs() === 0);
    };

    /**
     * Deja la barra contando lo que hay puesto: los dos contadores, el azul
     * claro de las píldoras que abren algo y el botón de limpiar, que solo
     * aparece cuando hay algo que quitar.
     *
     * Va aparte y se llama después de cada cambio, en vez de repetir estas
     * cuatro decisiones dentro de cada manejador: los filtros se tocan desde
     * cinco sitios distintos (chips, casillas, buscador, "Limpiar filtros" y el
     * botón del listado vacío) y todos tienen que dejar la barra igual.
     */
    const sincronizarBarra = () => {
      const contador = (nodo: HTMLElement | null, n: number) => {
        if (!nodo) return;
        nodo.textContent = String(n);
        nodo.classList.toggle('hidden', n === 0);
      };
      // El botón "Filtros" cuenta todo lo que hay puesto DENTRO de su panel:
      // las marcas y las subcategorías. Si contara solo las marcas, quien
      // afinara por subcategoría y cerrara el panel no tendría en pantalla
      // ninguna señal de que ese filtro sigue aplicado.
      const enPanel = marcasSel.size + totalSubs();
      contador(conteoMarcas, enPanel);
      contador(conteoCategorias, categoriasSel.size);
      botonPanel.dataset.activo = enPanel ? 'si' : 'no';
      botonCategorias.dataset.activo = categoriasSel.size ? 'si' : 'no';
      limpiarMarcasBoton?.classList.toggle('hidden', marcasSel.size === 0);
      limpiarTodoBoton?.classList.toggle('hidden', !hayFiltro());
      pintarSubs();
    };

    /**
     * Lo que hay que hacer tras cualquier cambio de filtro. Las tandas se
     * reinician a propósito: si alguien venía de pedir "Ver más" tres veces y
     * escribe en el buscador, lo que espera son los primeros resultados de la
     * búsqueda nueva, no 96 tarjetas de la anterior.
     */
    const filtroCambio = () => {
      tandas.clear();
      sincronizarBarra();
      render();
    };

    /**
     * Búsqueda: el evento se manda cuando la persona deja de escribir, no en
     * cada tecla. Si no, "chocolate" llegaría a GA4 como diez búsquedas
     * distintas y el informe sería ilegible.
     */
    let temporizadorBusqueda: number | undefined;

    buscador.addEventListener('input', () => {
      consulta = buscador.value;
      filtroCambio();

      window.clearTimeout(temporizadorBusqueda);
      temporizadorBusqueda = window.setTimeout(() => {
        const termino = limpiarTermino(consulta);
        // Menos de tres letras no dice nada útil y son casi todo tecleo a medias.
        if (termino.length >= 3) registrarEvento('catalogo_buscar', { termino });
      }, 900);
    });

    /**
     * Suelta las subcategorías de una categoría -o de todas, sin argumento- y
     * desmarca sus casillas. El estado y el formulario tienen que quedar
     * iguales: una casilla marcada cuyo filtro ya se soltó es una mentira en
     * pantalla.
     */
    const olvidarSubs = (categoria?: string) => {
      if (categoria) subsSel.delete(categoria);
      else subsSel.clear();
      panelMarcas.querySelectorAll<HTMLInputElement>('[data-sub]').forEach((casilla) => {
        if (!categoria || casilla.dataset.subCategoria === categoria) casilla.checked = false;
      });
    };

    /** Deja los chips de categoría con el `aria-pressed` que corresponde. */
    const pintarChips = () => {
      tiraCategorias.querySelectorAll<HTMLButtonElement>('[data-categoria]').forEach((chip) => {
        const valor = chip.dataset.categoria ?? '';
        chip.setAttribute(
          'aria-pressed',
          // El chip "Todas" (valor vacío) se enciende justamente cuando no hay
          // ninguna categoría elegida: es el estado de "sin filtrar".
          String(valor ? categoriasSel.has(valor) : categoriasSel.size === 0),
        );
      });
    };

    tiraCategorias.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-categoria]');
      if (!chip) return;
      const categoria = chip.dataset.categoria ?? '';
      if (!categoria) {
        categoriasSel.clear();
        olvidarSubs();
      } else if (categoriasSel.has(categoria)) {
        categoriasSel.delete(categoria);
        // Al apagar la categoría se van con ella sus subcategorías: dejarlas
        // puestas escondería un filtro activo, porque su grupo desaparece del
        // panel y ya no habría forma de quitarlo.
        olvidarSubs(categoria);
      } else {
        categoriasSel.add(categoria);
      }
      pintarChips();
      filtroCambio();

      // El chip es de selección múltiple, así que no basta con mandar "la"
      // categoría como cuando esto era un desplegable de una sola: se manda la
      // que se acaba de tocar, si quedó puesta o quitada, y cuántas hay activas
      // en total. Así el informe distingue "entró a Galletas" de "quitó
      // Galletas y se quedó con otras tres".
      registrarEvento('catalogo_filtrar_categoria', {
        categoria: categoria || 'todas',
        accion: !categoria ? 'limpiar' : categoriasSel.has(categoria) ? 'poner' : 'quitar',
        activas: categoriasSel.size,
      });
    });

    panelMarcas.addEventListener('change', (e) => {
      const casilla = (e.target as HTMLElement).closest<HTMLInputElement>('[data-sub]');
      if (!casilla) return;
      const categoria = casilla.dataset.subCategoria ?? '';
      const elegidas = subsSel.get(categoria) ?? new Set<string>();
      if (casilla.checked) elegidas.add(casilla.value);
      else elegidas.delete(casilla.value);
      if (elegidas.size) subsSel.set(categoria, elegidas);
      else subsSel.delete(categoria);
      filtroCambio();

      // El segundo nivel no existía cuando se instrumentó el catálogo, pero es
      // un filtro real: sin este evento el informe mostraría a la gente
      // entrando a "Pastas" y no lo que hace después dentro.
      registrarEvento('catalogo_filtrar_subcategoria', {
        categoria,
        subcategoria: casilla.value,
        accion: casilla.checked ? 'poner' : 'quitar',
      });
    });

    panelMarcas.addEventListener('change', (e) => {
      const casilla = (e.target as HTMLElement).closest<HTMLInputElement>('[data-marca]');
      if (!casilla) return;
      if (casilla.checked) marcasSel.add(casilla.value);
      else marcasSel.delete(casilla.value);
      filtroCambio();

      registrarEvento('catalogo_filtrar_marca', {
        marca: casilla.value,
        accion: casilla.checked ? 'poner' : 'quitar',
        activas: marcasSel.size,
      });
    });

    /** Píldora que abre algo: el estado visible es su propio `aria-expanded`. */
    const alternar = (boton: HTMLButtonElement, abrir: (abierto: boolean) => void) => {
      boton.addEventListener('click', () => {
        const abierto = boton.getAttribute('aria-expanded') === 'true';
        boton.setAttribute('aria-expanded', String(!abierto));
        abrir(!abierto);
      });
    };

    alternar(botonPanel, (abierto) => panelMarcas.classList.toggle('hidden', !abierto));
    alternar(botonCategorias, (abierta) => {
      tiraCategorias.dataset.abierta = abierta ? 'si' : 'no';
    });

    /** Quita solo las marcas, sin tocar el texto ni las categorías. */
    const limpiarMarcas = () => {
      marcasSel.clear();
      panelMarcas.querySelectorAll<HTMLInputElement>('[data-marca]').forEach((casilla) => {
        casilla.checked = false;
      });
      filtroCambio();
    };

    /** Deja el catálogo como al entrar: sin texto, sin categorías, sin marcas. */
    const limpiarTodo = () => {
      consulta = '';
      buscador.value = '';
      categoriasSel.clear();
      marcasSel.clear();
      olvidarSubs();
      pintarChips();
      panelMarcas.querySelectorAll<HTMLInputElement>('[data-marca]').forEach((casilla) => {
        casilla.checked = false;
      });
      filtroCambio();
    };

    limpiarMarcasBoton?.addEventListener('click', limpiarMarcas);
    limpiarSubsBoton?.addEventListener('click', () => {
      olvidarSubs();
      filtroCambio();
    });
    limpiarTodoBoton?.addEventListener('click', () => {
      limpiarTodo();
      buscador.focus();
    });

    contenedor.addEventListener('click', (e) => {
      const objetivo = e.target as HTMLElement;

      const seccion = objetivo.closest<HTMLButtonElement>('[data-seccion]');
      if (seccion) {
        const marca = seccion.dataset.seccion ?? '';
        if (abiertas.has(marca)) abiertas.delete(marca);
        else abiertas.add(marca);
        render();
        return;
      }

      const verMas = objetivo.closest<HTMLButtonElement>('[data-mas]');
      if (verMas) {
        const clave = verMas.dataset.mas ?? '';
        tandas.set(clave, (tandas.get(clave) ?? TAMANO_TANDA) + TAMANO_TANDA);
        render();
        return;
      }

      if (objetivo.closest('[data-limpiar]')) {
        limpiarTodo();
        buscador.focus();
        return;
      }

      const tarjeta = objetivo.closest<HTMLElement>('[data-tarjeta]');
      if (!tarjeta) return;
      const id = tarjeta.dataset.tarjeta ?? '';
      const campo = tarjeta.querySelector<HTMLInputElement>('[data-cantidad]');

      const paso = objetivo.closest<HTMLButtonElement>('[data-paso]');
      if (paso && campo) {
        const delta = Number(paso.dataset.paso);
        const nueva = Math.min(Math.max(cantidadEnTarjeta(id) + delta, 1), CANTIDAD_MAXIMA);
        cantidades.set(id, nueva);
        campo.value = String(nueva);
        actualizarPasos(tarjeta, nueva);
        return;
      }

      if (objetivo.closest('[data-agregar]')) {
        pedido = sumarCantidad(pedido, id, cantidadEnTarjeta(id));
        guardarPedido(pedido);

        // Que referencias se agregan mas. No viaja ningun dato del cliente.
        const producto = obtenerProducto(id);
        if (producto) {
          registrarEvento('pedido_agregar', {
            codigo_sap: producto.codigo,
            marca: producto.marca,
          });
        }
        // La tarjeta vuelve a 1 para que agregar dos veces no repita la última
        // cantidad escrita sin querer.
        cantidades.set(id, 1);
        if (campo) campo.value = '1';
        actualizarPasos(tarjeta, 1);
      }
    });

    /** Habilita o deshabilita − y + según el valor del campo. */
    const actualizarPasos = (tarjeta: HTMLElement, valor: number) => {
      const menos = tarjeta.querySelector<HTMLButtonElement>('[data-paso="-1"]');
      const mas = tarjeta.querySelector<HTMLButtonElement>('[data-paso="1"]');
      if (menos) menos.disabled = valor <= 1;
      if (mas) mas.disabled = valor >= CANTIDAD_MAXIMA;
    };

    contenedor.addEventListener('input', (e) => {
      const campo = (e.target as HTMLElement).closest<HTMLInputElement>('[data-cantidad]');
      const tarjeta = campo?.closest<HTMLElement>('[data-tarjeta]');
      if (!campo || !tarjeta) return;
      const id = tarjeta.dataset.tarjeta ?? '';
      const valor = Math.min(Math.max(Math.floor(Number(campo.value)) || 1, 1), CANTIDAD_MAXIMA);
      cantidades.set(id, valor);
      actualizarPasos(tarjeta, valor);
    });

    // Al salir del campo se corrige lo que se haya escrito de más o de menos.
    contenedor.addEventListener(
      'blur',
      (e) => {
        const campo = (e.target as HTMLElement).closest<HTMLInputElement>('[data-cantidad]');
        const tarjeta = campo?.closest<HTMLElement>('[data-tarjeta]');
        if (!campo || !tarjeta) return;
        campo.value = String(cantidadEnTarjeta(tarjeta.dataset.tarjeta ?? ''));
      },
      true,
    );

    alCambiarPedido((nuevo) => {
      pedido = nuevo;
      refrescarEstados();
    });

    /*
     * ARRANQUE: adoptar, no repintar.
     *
     * La grilla que se está viendo ya salió del build con estas mismas
     * plantillas y este mismo estado inicial, así que volver a pintarla solo
     * produciría un parpadeo y tiraría a la basura las imágenes ya
     * descargadas. Lo único que el servidor no podía saber es el pedido
     * guardado en este navegador, y de eso se encarga `refrescarEstados`.
     *
     * `render()` no se llama aquí: la primera vez que corre es cuando el
     * visitante toca un filtro, abre otra marca o pide "Ver más".
     */
    sincronizarBarra();
    refrescarEstados();
    document.querySelector('[data-cargando]')?.remove();
  }
</script>
