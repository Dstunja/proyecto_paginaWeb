---
// Tipografía de marca, self-hosted (nada de Google Fonts por CDN).
// Montserrat variable cubre SemiBold (600) para subtítulos y Bold (700) para
// títulos con un solo archivo; Poppins Regular (400) es la tipografía de cuerpo.
import '@fontsource-variable/montserrat'; // títulos (Bold / SemiBold)
import '@fontsource/poppins/400.css'; // cuerpo
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappFlotante from '../components/WhatsappFlotante.astro';
import Analitica from '../components/Analitica.astro';
import AnaliticaEnlaces from '../components/AnaliticaEnlaces.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import LoaderDST from '../components/LoaderDST.astro';
import { empresa, redes } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Imagen Open Graph relativa a la raíz del sitio. */
  ogImage?: string;
}

const { title, description, ogImage = '/og.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL;
const publico = (archivo: string) => `${base}${base.endsWith('/') ? '' : '/'}${archivo}`;
const ogUrl = new URL(publico(ogImage.replace(/^\//, '')), Astro.site).href;

// Datos estructurados: ayudan a que Google muestre la ficha del negocio.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: empresa.razonSocial,
  alternateName: empresa.nombre,
  description: empresa.descripcion,
  url: new URL(base, Astro.site).href,
  telephone: empresa.telefonoE164,
  email: empresa.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: empresa.direccion,
    addressLocality: empresa.ciudad,
    addressRegion: empresa.departamento,
    addressCountry: empresa.pais,
  },
  areaServed: ['Boyacá', 'Santander', 'Cundinamarca'],
  sameAs: redes.map((r) => r.url),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#050d28" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={publico('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={publico('apple-touch-icon.png')} />
    <link rel="sitemap" href={publico('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={empresa.nombre} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {/*
      Interruptor del revelado al hacer scroll (ver src/lib/revelado.ts).

      Va aquí, en el <head> y sin `type="module"`, para que se ejecute ANTES de
      que se pinte el <body>: el CSS esconde lo que se va a revelar solo cuando
      esta clase está puesta, así que ponerla más tarde haría que el contenido
      apareciera y se ocultara de golpe.

      La clase se añade únicamente si el navegador tiene IntersectionObserver y
      el sistema no pide menos movimiento. Si el usuario activa "reducir
      movimiento", si el navegador es viejo o si no hay JavaScript, la clase no
      llega, el CSS no aplica y todo el contenido se ve directamente, sin
      fundido ni desplazamiento.
    */}
    <script is:inline>
      if (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        document.documentElement.classList.add('js-revelado');
      }
    </script>

    {/*
      Cortina de carga entre paginas (el <div id="dst-cortina"> de abajo y sus
      estilos en global.css).

      Va aqui, en el <head> y sin `type="module"`, por lo mismo que el
      interruptor de arriba: la clase tiene que estar puesta ANTES de que se
      pinte el <body>, o la cortina apareceria un fotograma tarde, justo el
      parpadeo que viene a quitar.

      Sin JavaScript la clase no llega, el CSS no aplica y la cortina no se ve
      nunca: la pagina se usa con normalidad en vez de quedarse tapada.
    */}
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        raiz.classList.add('js-cortina');
        raiz.classList.add('dst-con-cortina');

        var APARICION = performance.now();
        var MINIMO = 400; // lo minimo que se deja ver la animacion
        var FUNDIDO = 250; // lo que tarda el desvanecido (global.css)
        var TOPE = 5000; // si `load` no llega, el sitio no se queda tapado
        var quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var salvavidas;
        var fuera = false;

        function retirar(deGolpe) {
          if (fuera) return;
          fuera = true;
          clearTimeout(salvavidas);
          raiz.classList.remove('dst-con-cortina');
          var capa = document.getElementById('dst-cortina');
          if (!capa) return;
          if (deGolpe) {
            capa.hidden = true;
            return;
          }
          capa.setAttribute('data-fuera', 'true');
          setTimeout(function () {
            capa.hidden = true;
          }, FUNDIDO);
        }

        function mostrar() {
          var capa = document.getElementById('dst-cortina');
          if (!capa) return;
          fuera = false;
          capa.removeAttribute('data-fuera');
          capa.hidden = false;
          raiz.classList.add('dst-con-cortina');
          // Si la navegacion no llega a ocurrir (el usuario la cancela, o el
          // enlace acaba siendo una descarga), la cortina no se queda puesta.
          clearTimeout(salvavidas);
          salvavidas = setTimeout(function () {
            retirar(false);
          }, TOPE);
        }

        function alTerminarLaCarga() {
          // Con "reducir movimiento" no se hace esperar a nadie: fuera ya.
          var falta = quieto ? 0 : Math.max(0, MINIMO - (performance.now() - APARICION));
          setTimeout(function () {
            retirar(quieto);
          }, falta);
        }

        if (document.readyState === 'complete') alTerminarLaCarga();
        else addEventListener('load', alTerminarLaCarga, { once: true });

        salvavidas = setTimeout(function () {
          retirar(false);
        }, TOPE);

        // Volver con "atras" desde la cache del navegador: la pagina reaparece
        // con la cortina tal como la dejamos al salir, asi que se quita ya.
        addEventListener('pageshow', function (evento) {
          if (evento.persisted) retirar(true);
        });

        // Al pulsar un enlace interno, tapar ANTES de que el navegador cambie
        // de pagina. En fase de burbuja, para no adelantarse a los manejadores
        // que cancelan el clic (el menu del encabezado, el panel del pedido).
        document.addEventListener('click', function (evento) {
          if (evento.defaultPrevented || evento.button !== 0) return;
          if (evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;

          var enlace = evento.target.closest && evento.target.closest('a[href]');
          if (!enlace || enlace.hasAttribute('download')) return;
          if (enlace.target && enlace.target !== '_self') return;

          var destino;
          try {
            destino = new URL(enlace.href, location.href);
          } catch (e) {
            return;
          }

          // Deja fuera mailto:, tel: y WhatsApp: no cambian de pagina.
          if (destino.origin !== location.origin) return;
          // Un ancla dentro de la misma pagina tampoco navega a ninguna parte.
          if (destino.pathname === location.pathname && destino.search === location.search) return;

          mostrar();
        });
      })();
    </script>

    {/* Estadisticas de uso. No se inyecta nada sin PUBLIC_GA_ID ni en desarrollo. */}
    <Analitica />
  </head>

  <body>
    {/*
      Cortina de carga: tapa el hueco en blanco entre una pagina y la
      siguiente. Se pinta lo primero para que no haya un fotograma sin ella, y
      el script del <head> la retira tras `window.load`.

      `aria-hidden`: es decoracion. El contenido de la pagina ya esta en el
      DOM y un lector de pantalla lo recorre sin esperar a nadie, asi que
      anunciar "Cargando..." en cada pagina seria ruido de mas.
    */}
    <div id="dst-cortina" aria-hidden="true">
      <LoaderDST tamano={150} texto={empresa.nombre} anuncia={false} />
    </div>

    <a
      href="#main"
      class="absolute -left-[999px] top-3 z-[200] rounded-full bg-secondary px-5 py-2.5 font-display text-sm font-semibold text-white shadow-[0_8px_24px_rgba(30,136,229,.4)] focus:left-3"
      >Saltar al contenido</a
    >

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <WhatsappFlotante />
    <AvisoCookies />
    <AnaliticaEnlaces />

    {/* Revelado al hacer scroll y capa de interacción (parallax del hero,
        botones magnéticos), en un solo sitio para todo el sitio. Los dos
        módulos comprueban por su cuenta la clase `js-revelado`, así que con
        "reducir movimiento" activado no enganchan nada. */}
    <script>
      import '../lib/revelado';
      import '../lib/interacciones';
    </script>
  </body>
</html>
