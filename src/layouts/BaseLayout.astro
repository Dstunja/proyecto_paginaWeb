---
// Tipografía de marca, self-hosted (nada de Google Fonts por CDN).
// Montserrat variable cubre SemiBold (600) para subtítulos y Bold (700) para
// títulos con un solo archivo; Poppins Regular (400) es la tipografía de cuerpo.
import '@fontsource-variable/montserrat'; // títulos (Bold / SemiBold)
import '@fontsource/poppins/400.css'; // cuerpo
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappFlotante from '../components/WhatsappFlotante.astro';
import Analitica from '../components/Analitica.astro';
import AnaliticaEnlaces from '../components/AnaliticaEnlaces.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import { empresa, redes } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Imagen Open Graph relativa a la raíz del sitio. */
  ogImage?: string;
}

const { title, description, ogImage = '/og.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL;
const publico = (archivo: string) => `${base}${base.endsWith('/') ? '' : '/'}${archivo}`;
const ogUrl = new URL(publico(ogImage.replace(/^\//, '')), Astro.site).href;

// Datos estructurados: ayudan a que Google muestre la ficha del negocio.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: empresa.razonSocial,
  alternateName: empresa.nombre,
  description: empresa.descripcion,
  url: new URL(base, Astro.site).href,
  telephone: empresa.telefonoE164,
  email: empresa.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: empresa.direccion,
    addressLocality: empresa.ciudad,
    addressRegion: empresa.departamento,
    addressCountry: empresa.pais,
  },
  areaServed: ['Boyacá', 'Santander', 'Cundinamarca'],
  sameAs: redes.map((r) => r.url),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#050d28" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={publico('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={publico('apple-touch-icon.png')} />
    <link rel="sitemap" href={publico('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={empresa.nombre} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {/*
      Interruptor del revelado al hacer scroll (ver src/lib/revelado.ts).

      Va aquí, en el <head> y sin `type="module"`, para que se ejecute ANTES de
      que se pinte el <body>: el CSS esconde lo que se va a revelar solo cuando
      esta clase está puesta, así que ponerla más tarde haría que el contenido
      apareciera y se ocultara de golpe.

      La clase se añade únicamente si el navegador tiene IntersectionObserver y
      el sistema no pide menos movimiento. Si el usuario activa "reducir
      movimiento", si el navegador es viejo o si no hay JavaScript, la clase no
      llega, el CSS no aplica y todo el contenido se ve directamente, sin
      fundido ni desplazamiento.
    */}
    <script is:inline>
      if (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        document.documentElement.classList.add('js-revelado');
      }
    </script>

    {/* Estadisticas de uso. No se inyecta nada sin PUBLIC_GA_ID ni en desarrollo. */}
    <Analitica />
  </head>

  <body>
    <a
      href="#main"
      class="absolute -left-[999px] top-3 z-[200] rounded-full bg-secondary px-5 py-2.5 font-display text-sm font-semibold text-white shadow-[0_8px_24px_rgba(30,136,229,.4)] focus:left-3"
      >Saltar al contenido</a
    >

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <WhatsappFlotante />
    <AvisoCookies />
    <AnaliticaEnlaces />

    {/* Revelado al hacer scroll y capa de interacción (parallax del hero,
        botones magnéticos), en un solo sitio para todo el sitio. Los dos
        módulos comprueban por su cuenta la clase `js-revelado`, así que con
        "reducir movimiento" activado no enganchan nada. */}
    <script>
      import '../lib/revelado';
      import '../lib/interacciones';
    </script>
  </body>
</html>
