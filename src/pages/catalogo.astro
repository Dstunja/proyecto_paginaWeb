---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ruta } from '../lib/rutas';
import { logoMarca } from '../lib/imagenes';
import PageHero from '../components/PageHero.astro';
import Icono from '../components/Icono.astro';
import { empresa } from '../data/site';
import { productos } from '../data/productos';

/**
 * EDITAR AQUÍ: clasificación y portafolio real.
 * Estas categorías agrupan las marcas que ya aparecían en el prototipo.
 * Cuando exista el listado oficial (con referencias y presentaciones),
 * reemplazar este arreglo o alimentarlo desde un archivo de datos.
 */
const categorias = [
  {
    icono: 'cookie',
    nombre: 'Galletas y pasabocas',
    marcas: ['Noel', 'Ducales', 'Saltín Noel', 'Dux'],
    texto: 'Galletas dulces y saladas para el día a día de la tienda.',
  },
  {
    icono: 'candy',
    nombre: 'Chocolates y bebidas',
    marcas: ['Jet', 'Jumbo', 'Corona', 'Choco Listo'],
    texto: 'Chocolatinas, chocolate de mesa y bebidas achocolatadas.',
  },
  {
    icono: 'coffee',
    nombre: 'Café',
    marcas: ['Sello Rojo', 'La Bastilla', 'Matiz'],
    texto: 'Café molido y soluble para consumo en casa y para negocio.',
  },
  {
    icono: 'beef',
    nombre: 'Cárnicos',
    marcas: ['Zenú', 'Rica'],
    texto: 'Línea de cárnicos con manejo de cadena de frío en toda la ruta.',
  },
  {
    icono: 'nut',
    nombre: 'Nueces y otros',
    marcas: ['La Especial', 'Nutresa'],
    texto: 'Frutos secos y demás referencias del portafolio del grupo.',
  },
];

/**
 * Logo de cada marca, si ya está subido.
 *
 * EDITAR AQUÍ: los logos van en public/img/marcas/ con el nombre de la marca
 * en minúsculas y con guiones: 'Saltín Noel' -> saltin-noel.png
 * (también sirven .svg, .webp o .jpg). Mientras el archivo no exista, la marca
 * se sigue mostrando como píldora de texto, sin imágenes rotas.
 */
const categoriasConLogos = categorias.map((cat) => ({
  ...cat,
  marcas: cat.marcas.map((marca) => ({ nombre: marca, logo: logoMarca(marca) })),
}));

const mensajeWhatsapp = encodeURIComponent(
  'Hola, quiero recibir el catálogo de productos y hablar con un asesor comercial.',
);
---

<BaseLayout
  title="Catálogo — Distribuciones Santiago de Tunja"
  description="Portafolio de marcas de Grupo Nutresa que distribuimos en Boyacá, Santander y Cundinamarca: galletas, chocolates, café, cárnicos y más."
>
  <PageHero
    kicker="Portafolio"
    titulo="Las marcas que llevamos a tu negocio"
    texto="Distribuimos el portafolio de Grupo Nutresa en 87 municipios. Pide el catálogo completo con precios y presentaciones a través de tu asesor."
  />

  <section class="section">
    <div class="wrap">
      <div class="grid grid-cols-1 gap-6 mob:grid-cols-2 tablet:grid-cols-3">
        {
          categoriasConLogos.map((cat) => (
            <div class="group glass-card flex flex-col p-8">
              <span class="icono-chip mb-5 h-12 w-12">
                <Icono nombre={cat.icono} class="h-6 w-6" interactivo={false} />
              </span>
              <h2 class="mb-3 text-lg">{cat.nombre}</h2>
              <p class="m-0 text-[14.5px] text-muted">{cat.texto}</p>
              <ul class="m-0 mt-5 flex list-none flex-wrap items-center gap-2.5 p-0">
                {cat.marcas.map((marca) =>
                  marca.logo ? (
                    <li class="flex h-11 items-center rounded-xl border border-line bg-surface px-3 transition-all duration-200 hover:border-secondary/50 hover:shadow-[0_6px_18px_rgba(13,44,132,.1)]">
                      <img
                        src={marca.logo}
                        alt={marca.nombre}
                        loading="lazy"
                        class="h-9 w-auto max-w-[110px] object-contain"
                      />
                    </li>
                  ) : (
                    <li class="glass rounded-full px-3.5 py-1.5 text-[13px] font-semibold text-ink transition-colors duration-200 hover:bg-secondary hover:text-white">
                      {marca.nombre}
                    </li>
                  ),
                )}
              </ul>
            </div>
          ))
        }
      </div>

      <div
        class="glass-card mt-14 grid grid-cols-1 items-center gap-10 p-9 text-ink tablet:grid-cols-[1.2fr_.8fr] tablet:p-12"
      >
        <div>
          <h2 class="text-[26px] tablet:text-[32px]">¿Listo para pedir?</h2>
          <p class="mt-3 max-w-[52ch] text-muted">
            Arma tu pedido con las {productos.length} referencias del portafolio y envíaselo a tu
            asesor por WhatsApp; él confirma precios, disponibilidad y condiciones de entrega para
            tu municipio.
          </p>
        </div>
        <div class="flex flex-wrap gap-3.5">
          {/* Desde las marcas, el paso natural es elegir las referencias. */}
          <a class="btn btn-accent" href={ruta('/pedido/')}>
            Arma tu pedido
            <Icono nombre="shopping-cart" class="h-[18px] w-[18px]" />
          </a>
          <a
            class="btn btn-secondary"
            href={`${empresa.whatsapp}?text=${mensajeWhatsapp}`}
            target="_blank"
            rel="noopener"
          >
            Pedir catálogo
            <Icono nombre="whatsapp" class="h-[18px] w-[18px]" />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
