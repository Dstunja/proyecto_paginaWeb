---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ruta } from '../lib/rutas';
import PageHero from '../components/PageHero.astro';
import MapaCobertura from '../components/MapaCobertura.astro';
import FormularioMailto from '../components/FormularioMailto.astro';
import Icono from '../components/Icono.astro';
import { empresa, televentas } from '../data/site';
import { enlaceTeleventas, MENSAJE_PEDIDO } from '../lib/televentas';
import EnlaceUbicacion from '../components/EnlaceUbicacion.astro';

// EDITAR AQUÍ: horario real de atención.
const horario = [
  { dia: 'Lunes a viernes', horas: '7:30 a. m. – 5:30 p. m.' },
  { dia: 'Sábados', horas: '8:00 a. m. – 12:00 m.' },
  { dia: 'Domingos y festivos', horas: 'Cerrado' },
];

// La tarjeta de Televentas va aparte, antes de estos dos, porque lleva a cada
// asesora con sus botones (ver `televentas` en src/data/site.ts). El teléfono
// de aquí es la línea de la OFICINA: son números distintos a propósito.
const canales = [
  {
    icono: 'phone',
    titulo: 'Teléfono',
    valor: empresa.telefono,
    href: `tel:${empresa.telefonoE164}`,
    externo: false,
    nota: 'Atención en horario de oficina.',
  },
  {
    icono: 'mail',
    titulo: 'Correo',
    valor: empresa.email,
    href: `mailto:${empresa.email}`,
    externo: false,
    nota: 'Para cotizaciones, facturación y temas administrativos.',
  },
];
---

<BaseLayout
  title="Contáctanos — Distribuciones Santiago de Tunja"
  description="Escríbenos por WhatsApp, teléfono o correo. Sede principal en Tunja, Boyacá. Atendemos Boyacá, Santander y Cundinamarca."
>
  <PageHero
    kicker="Contacto"
    titulo="Hablemos"
    texto="Estamos en Tunja y atendemos 87 municipios. Escoge el canal que más te sirva y te respondemos."
  />

  <!-- CANALES -->
  <section class="section">
    <div class="wrap">
      <div class="grid grid-cols-1 gap-6 tablet:grid-cols-3" data-revelar-grupo>
        {/* Televentas: una fila por asesora, cada una con su WhatsApp y su
            llamada. Aquí el cliente elige a quién escribir, así que estos
            enlaces NO se reparten; `data-asesora` deja guardada la elegida
            para que el botón flotante y el pedido armado vayan a la misma
            (ver src/lib/televentas.ts). */}
        <div class="group glass-card p-8" data-tarjeta-televentas>
          <span class="icono-chip mb-5 h-12 w-12">
            <Icono nombre="whatsapp" class="h-6 w-6" interactivo={false} />
          </span>
          <h2 class="mb-2 text-lg">WhatsApp Televentas</h2>
          <p class="mt-0 mb-4 text-[14.5px] text-muted">
            La vía más rápida para pedidos y asesoría comercial.
          </p>
          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {
              televentas.map((asesora) => (
                <li class="rounded-xl border border-line bg-fondo p-4">
                  <p class="m-0 font-display text-[15px] font-semibold text-ink">{asesora.nombre}</p>
                  <p class="m-0 text-[14.5px] text-muted">{asesora.telefono}</p>
                  {/* `pr-6` en móvil deja libre la franja del botón flotante
                      de WhatsApp (fijo a 24 px del borde, 56 px de ancho):
                      como no se mueve al desplazar, un botón que invada esa
                      franja queda tapado en algún momento, esté donde esté
                      la tarjeta. Si no caben los dos en la fila, "Llamar"
                      baja a la siguiente. En tableta la tarjeta va en la
                      columna izquierda y la reserva ya no hace falta. */}
                  <div class="mt-3 flex flex-wrap gap-2 pr-6 tablet:pr-0">
                    <a
                      class="btn btn-whatsapp px-3 py-1.5 text-[13px]"
                      href={enlaceTeleventas(asesora, MENSAJE_PEDIDO)}
                      target="_blank"
                      rel="noopener"
                      data-asesora={asesora.nombre}
                      aria-label={`Escribir a ${asesora.nombre} por WhatsApp`}
                    >
                      <Icono nombre="whatsapp" class="h-4 w-4" interactivo={false} />
                      WhatsApp
                    </a>
                    <a
                      class="btn btn-secondary px-3 py-1.5 text-[13px]"
                      href={`tel:${asesora.telefonoE164}`}
                      data-asesora={asesora.nombre}
                      aria-label={`Llamar a ${asesora.nombre}`}
                    >
                      <Icono nombre="phone" class="h-4 w-4" interactivo={false} />
                      Llamar
                    </a>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        {
          canales.map((canal) => (
            <div class="group glass-card p-8">
              <span class="icono-chip mb-5 h-12 w-12">
                <Icono nombre={canal.icono} class="h-6 w-6" interactivo={false} />
              </span>
              <h2 class="mb-2 text-lg">{canal.titulo}</h2>
              {/* El correo es una sola "palabra" de 33 caracteres y no cabía
                  en la tarjeta ni en móvil ni en tableta. El <wbr> antes de
                  la arroba deja partirlo en "informacioncomercialdst" /
                  "@gmail.com"; `wrap-anywhere` es el último recurso si ni la
                  primera parte cabe. */}
              <a
                class="text-[15px] font-semibold wrap-anywhere text-accent-text underline"
                href={canal.href}
                {...canal.externo ? { target: '_blank', rel: 'noopener' } : {}}
                data-valor-canal
              >
                {canal.valor.split('@').map((parte, i) => (i > 0 ? <><wbr />@{parte}</> : parte))}
              </a>
              <p class="mt-3 mb-0 text-[14.5px] text-muted">{canal.nota}</p>
            </div>
          ))
        }
      </div>

      <div
        class="mt-11 grid grid-cols-1 items-start gap-14 tablet:grid-cols-[1.1fr_.9fr]"
        data-revelar-grupo="fundido"
      >
        <MapaCobertura enGrid={false} titulo="Nuestra sede" />

        <div class="glass-card p-8">
          <h2 class="mb-4 text-lg">Horario de atención</h2>
          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {
              horario.map((h) => (
                <li class="flex items-baseline justify-between border-b border-line pb-3 text-[14.5px]">
                  <span class="font-medium">{h.dia}</span>
                  <span class="text-muted">{h.horas}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 mb-0 text-[14.5px] text-muted">
            <EnlaceUbicacion
              >{empresa.direccion}, {empresa.ciudad}, {empresa.departamento}</EnlaceUbicacion
            >.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMULARIO -->
  <section class="section border-t border-line bg-fondo">
    <div class="wrap grid grid-cols-1 items-start gap-14 tablet:grid-cols-[.9fr_1.1fr]">
      <div data-revelar="fundido">
        <span class="kicker">Escríbenos</span>
        <h2 class="text-[28px] tablet:text-[38px]">Cuéntanos qué necesitas</h2>
        <p class="mt-3 text-muted">
          Si eres tendero o negocio y quieres ser atendido por nuestra ruta, déjanos tus datos y un
          asesor de tu zona te contacta.
        </p>
        <p class="mt-4 text-[14.5px] text-muted">
          ¿Es una petición, queja o reclamo formal? Usa el{' '}
          <a class="font-semibold text-secondary-dark underline" href={ruta('/pqrs/')}>formulario de PQRS</a>.
        </p>
      </div>

      <div class="glass-card p-8">
        <FormularioMailto asunto="Contacto desde dstunja.com" boton="Enviar mensaje">
          <div>
            <label class="field-label" for="nombre-contacto">Nombre completo *</label>
            <input class="field" id="nombre-contacto" name="nombre-contacto" type="text" required />
          </div>
          <div class="grid grid-cols-1 gap-5 mob:grid-cols-2">
            <div>
              <label class="field-label" for="correo-contacto">Correo *</label>
              <input
                class="field"
                id="correo-contacto"
                name="correo-contacto"
                type="email"
                required
              />
            </div>
            <div>
              <label class="field-label" for="telefono-contacto">Teléfono</label>
              <input class="field" id="telefono-contacto" name="telefono-contacto" type="tel" />
            </div>
          </div>
          <div>
            <label class="field-label" for="municipio-contacto">Municipio</label>
            <input
              class="field"
              id="municipio-contacto"
              name="municipio-contacto"
              type="text"
              placeholder="Ej. Duitama"
            />
          </div>
          <div>
            <label class="field-label" for="mensaje-contacto">Mensaje *</label>
            <textarea
              class="field"
              id="mensaje-contacto"
              name="mensaje-contacto"
              rows="5"
              required></textarea>
          </div>
        </FormularioMailto>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { enlazarTeleventas } from '../lib/televentas';

  enlazarTeleventas();
</script>
