---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FormularioEmpleo from '../components/FormularioEmpleo.astro';
import Icono from '../components/Icono.astro';
import { ruta } from '../lib/rutas';
import { imagenOMarcador } from '../lib/imagenes';
import { contactoEmpleo } from '../data/vacantes';
import { cargarVacantes, urlVacantes } from '../lib/empleos/vacantes-fuente';
import { atributosFlyer } from '../lib/empleos/flyer.mjs';

/**
 * Las vacantes las publica Talento Humano en Control360 (C360_VACANTES_URL); si
 * no se pueden leer, salen de src/data/vacantes.ts. En Vercel esta página va
 * con ISR y se regenera en segundos cuando Control360 avisa (o a los 5 minutos,
 * si el aviso se pierde); en GitHub Pages se arma en el build. Ver
 * src/lib/empleos/isr.mjs.
 * Ver src/lib/empleos/vacantes-fuente.ts. La misma lista la usan la página de
 * detalle (/empleos/<slug>/), el formulario y /api/empleos/vacantes.json.
 *
 * Cada tarjeta lleva la foto de la vacante; mientras no exista el archivo en
 * public/img/empleos/, `imagenOMarcador` devuelve un marcador de posición con
 * el nombre del cargo para que la rejilla no se vea rota.
 */
const { vacantes } = await cargarVacantes();
// Respaldo en el navegador: la URL PÚBLICA de Control360 (sin secreto), para
// que src/lib/empleos/vacantes-vivas.ts esconda una tarjeta que se cerró
// después de generar esta copia. Sin la variable no hay respaldo.
const urlVivas = urlVacantes() ?? undefined;
// En Vercel, el flyer de Control360 pasa por /_vercel/image: la tarjeta mide
// como mucho ~400 px, así que basta con 828 px (2x). Ver src/lib/empleos/flyer.mjs.
const enVercel = Boolean(process.env.VERCEL);
const tarjetas = vacantes.map((vacante) => {
  const { src, esMarcador } = imagenOMarcador(vacante.imagen, vacante.cargo, 800, 600);
  return { ...vacante, esMarcador, ...atributosFlyer(src, { enVercel, anchoMaximo: 828 }) };
});

const proceso = [
  {
    icono: 'file-text',
    titulo: 'Envías tu hoja de vida',
    texto: 'Por el formulario de esta página o por WhatsApp.',
  },
  {
    icono: 'user-check',
    titulo: 'Revisamos tu perfil',
    texto: 'Contactamos a quienes se ajustan a la vacante.',
  },
  {
    icono: 'message-square',
    titulo: 'Entrevista',
    texto: 'Presencial en Tunja o virtual, según el cargo.',
  },
  { icono: 'briefcase', titulo: 'Contratación', texto: 'Exámenes, documentos y vinculación.' },
];
---

<BaseLayout
  title="Empleos — Distribuciones Santiago de Tunja"
  description="Trabaja con nosotros: vacantes en logística, distribución y comercial en Boyacá, Santander y Cundinamarca. Envía tu hoja de vida."
>
  <PageHero
    kicker="Trabaja con nosotros"
    titulo="Únete a nuestro equipo"
    texto="Somos una empresa en crecimiento en el sector logístico y de distribución. Estas son las oportunidades abiertas."
  />

  <!-- VACANTES -->
  <section class="section">
    <div class="wrap">
      <div class="mb-14 max-w-[56ch]" data-revelar>
        <span class="kicker">Vacantes</span>
        <h2 class="text-[28px] tablet:text-[38px]">Oportunidades abiertas</h2>
      </div>

      {
        vacantes.length === 0 ? (
          <p class="glass-card p-8 text-muted">
            En este momento no tenemos vacantes abiertas. Puedes dejarnos tu hoja de vida en el
            formulario de abajo y te contactamos cuando se abra un proceso.
          </p>
        ) : (
          <div
            class="grid grid-cols-1 gap-6 mob:grid-cols-2 tablet:grid-cols-3"
            data-revelar-grupo
            data-vacantes-vivas={urlVivas}
          >
            {tarjetas.map((vacante) => (
              <article class="group glass-card flex flex-col overflow-hidden" data-vacante-slug={vacante.slug}>
                <a
                  href={ruta(`/empleos/${vacante.slug}/`)}
                  class="block overflow-hidden bg-primary-soft"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <img
                    src={vacante.src}
                    srcset={vacante.srcset}
                    sizes={vacante.srcset ? '(min-width: 900px) 30vw, (min-width: 520px) 45vw, calc(100vw - 32px)' : undefined}
                    alt=""
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </a>

                <div class="flex flex-1 flex-col p-7">
                  <p class="m-0 text-[12.5px] font-semibold tracking-[0.08em] text-accent-text uppercase">
                    {vacante.ciudad} · {vacante.tipo}
                  </p>
                  <h3 class="mt-2 mb-0 text-lg">
                    <a class="inline-flex min-h-11 items-center hover:text-secondary-dark" href={ruta(`/empleos/${vacante.slug}/`)}>
                      {vacante.cargo}
                    </a>
                  </h3>
                  <p class="mt-3 mb-0 text-[14.5px] text-muted">{vacante.resumen}</p>
                  {
                    (vacante.salario || vacante.jornada) && (
                      <p class="mt-3 mb-0 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13.5px] font-semibold text-ink">
                        {vacante.salario && (
                          <span class="inline-flex items-center gap-1.5">
                            <Icono nombre="tag" class="h-4 w-4 text-secondary" interactivo={false} />
                            {vacante.salario}
                          </span>
                        )}
                        {vacante.jornada && (
                          <span class="inline-flex items-center gap-1.5 text-muted">
                            <Icono nombre="clock" class="h-4 w-4" interactivo={false} />
                            {vacante.jornada}
                          </span>
                        )}
                      </p>
                    )
                  }

                  {/* `min-h-11`: 44 px de zona táctil en cada enlace (D6). */}
                  <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1 pt-1">
                    <a
                      class="group/enlace inline-flex min-h-11 items-center gap-1.5 text-[14.5px] font-semibold text-secondary-dark"
                      href={ruta(`/empleos/${vacante.slug}/`)}
                    >
                      Ver detalle
                      <Icono nombre="arrow-right" class="h-4 w-4" />
                    </a>
                    <a
                      class="inline-flex min-h-11 items-center text-[14.5px] font-semibold text-muted underline transition-colors duration-200 hover:text-primary"
                      href="#postular"
                      data-postular={vacante.cargo}
                    >
                      Postularme
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- PROCESO -->
  <section class="section border-y border-line bg-fondo">
    <div class="wrap">
      <div class="mb-14 max-w-[56ch]" data-revelar>
        <span class="kicker">Cómo es el proceso</span>
        <h2 class="text-[28px] tablet:text-[38px]">De la hoja de vida al primer día</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 mob:grid-cols-2 tablet:grid-cols-4" data-revelar-grupo>
        {
          proceso.map((paso, i) => (
            <div class="group glass-card p-8">
              <span class="icono-chip mb-5 h-12 w-12">
                <Icono nombre={paso.icono} class="h-6 w-6" interactivo={false} />
              </span>
              <div class="mb-1.5 font-display text-sm font-semibold text-accent-text">
                0{i + 1}
              </div>
              <h3 class="mb-2 text-base">{paso.titulo}</h3>
              <p class="m-0 text-[14.5px] text-muted">{paso.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- POSTULACIÓN -->
  <section id="postular" class="section">
    <div class="wrap grid grid-cols-1 items-start gap-14 tablet:grid-cols-[.9fr_1.1fr]">
      <div data-revelar="fundido">
        <span class="kicker">Postulación</span>
        <h2 class="text-[28px] tablet:text-[38px]">Déjanos tus datos</h2>
        <p class="mt-3 text-muted">
          Completa el formulario y adjunta tu hoja de vida en PDF, DOC o DOCX. La recibe
          directamente nuestro equipo de Talento Humano. También puedes escribirnos por WhatsApp
          si prefieres.
        </p>
        <p class="mt-4 text-[14.5px] text-muted">
          También puedes escribirnos directamente a{' '}
          <a
            class="font-semibold text-secondary-dark underline"
            href={`mailto:${contactoEmpleo.email}`}
          >
            {contactoEmpleo.email}
          </a>{' '}
          o al {contactoEmpleo.whatsapp.texto}.
        </p>
        <p class="mt-4 text-[14.5px] text-muted">
          Tus datos y tu hoja de vida se tratan únicamente para fines de selección de personal,
          conforme a la Ley 1581 de 2012. En el formulario te pediremos tu autorización.
        </p>
      </div>

      {/*
        El formulario envía la postulación con la hoja de vida adjunta a
        POST /api/empleos/postular; la lista de cargos del select y la del
        servidor son la misma (src/lib/empleos/cargos.ts). Ver
        docs/EMPLEOS-POSTULACION.md.
      */}
      <div class="glass-card p-8">
        <FormularioEmpleo />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { registrarEvento } from '../lib/analitica';
  import { esconderVacantesCerradas } from '../lib/empleos/vacantes-vivas';

  // Defensa en profundidad: si esta copia de la página quedó vieja (el aviso de
  // Control360 no llegó), se esconden las tarjetas que ya se cerraron.
  void esconderVacantesCerradas();

  const select = () => document.getElementById('cargo-empleo') as HTMLSelectElement | null;

  /** Elige una opción del select solo si ese cargo existe en la lista. */
  function elegirCargo(cargo: string) {
    const campo = select();
    if (!campo) return;
    const existe = Array.from(campo.options).some((o) => o.value === cargo);
    if (!existe) return;
    campo.value = cargo;
    // Cambiar `value` por código no dispara `change`, y el formulario escucha
    // ese evento para pintar las preguntas de filtro de la vacante elegida.
    campo.dispatchEvent(new Event('change', { bubbles: true }));
  }

  // Al pulsar "Postularme a esta vacante" el formulario queda con ese cargo elegido.
  document.querySelectorAll<HTMLAnchorElement>('[data-postular]').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      const cargo = enlace.dataset.postular;
      if (!cargo) return;
      elegirCargo(cargo);
      registrarEvento('vacante_postular', { vacante: cargo });
    });
  });

  // Al llegar desde la página de detalle (/empleos/?cargo=...#postular) el
  // formulario aparece con la vacante ya seleccionada.
  const cargoEnUrl = new URLSearchParams(window.location.search).get('cargo');
  if (cargoEnUrl) elegirCargo(cargoEnUrl);
</script>
