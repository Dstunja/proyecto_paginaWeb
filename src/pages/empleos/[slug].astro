---
import VacanteDetalle from '../../components/VacanteDetalle.astro';
import VacanteCerrada from '../../components/VacanteCerrada.astro';
import type { Vacante } from '../../data/vacantes';
import { cargarVacantes } from '../../lib/empleos/vacantes-fuente';

/**
 * /empleos/<slug>/ — el detalle de una vacante, o "ya se cerró".
 *
 * DOS MODOS, MISMO ARCHIVO (ver src/lib/empleos/isr.mjs):
 *   - En Vercel se renderiza bajo demanda con ISR: el slug sale de la URL y se
 *     busca entre las vacantes que Control360 tiene abiertas EN ESE MOMENTO. Si
 *     ya no está (RRHH la cerró, venció o el enlace es viejo), sale la página
 *     amable de VacanteCerrada.astro con 404, nunca un 500.
 *     `getStaticPaths` no se usa en este modo.
 *   - En GitHub Pages se prerenderiza: `getStaticPaths` arma una página por
 *     vacante abierta en el build, como siempre.
 */
export async function getStaticPaths() {
  // Una página por vacante: las de Control360 o, si no se leyeron, las estáticas.
  const { vacantes } = await cargarVacantes();
  return vacantes.map((vacante) => ({
    params: { slug: vacante.slug },
    props: { vacante },
  }));
}

// La misma lista que armó las rutas, para "Otras convocatorias".
const { vacantes } = await cargarVacantes();
const slug = String(Astro.params.slug ?? '');
const vacante: Vacante | undefined =
  (Astro.props as { vacante?: Vacante }).vacante ?? vacantes.find((v) => v.slug === slug);

if (!vacante) Astro.response.status = 404;
---

{vacante ? <VacanteDetalle vacante={vacante} vacantes={vacantes} /> : <VacanteCerrada />}
