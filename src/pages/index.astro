---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ruta } from '../lib/rutas';
import { altoSeguroLogo, logoMarcaImagen } from '../lib/imagenes';
import MapaRed from '../components/MapaRed.astro';
import BuscadorMunicipio from '../components/BuscadorMunicipio.astro';
import NovedadesTemporada from '../components/NovedadesTemporada.astro';
import BotonPideky from '../components/BotonPideky.astro';
import Icono from '../components/Icono.astro';
import Resenas from '../components/Resenas.astro';
import AnaliticaSecciones from '../components/AnaliticaSecciones.astro';
import {
  cifras,
  marcasDeLaFranja,
  beneficios,
  empresa,
  CLIENTES_TEXTO,
  PIDEKY_URL,
  HERO_IMAGEN,
  HERO_IMAGEN_ALT,
  resumenCobertura,
} from '../data/site';
// De municipios.ts sale el dato real (cuántos municipios cubre cada
// departamento y su color); las cifras de clientes que se muestran son las
// comunicadas y salen de resumenCobertura (ver src/data/site.ts).
import { departamentos } from '../data/municipios';

const formatoNumero = new Intl.NumberFormat('es-CO');

/**
 * EDITAR AQUÍ (src/data/site.ts, PIDEKY_URL): mientras esa variable esté vacía,
 * la tarjeta de Pideky de "Haz tu pedido" no se dibuja y la sección queda con
 * los canales que sí funcionan. Anunciar un canal cuyo botón no lleva a ninguna
 * parte cuesta más confianza de la que gana. Al llenar la URL, la tarjeta
 * reaparece sola y la rejilla vuelve a dos columnas.
 */
const hayPideky = PIDEKY_URL.trim() !== '';

/* Franja "Marcas que distribuimos".

   Solo entran las marcas que ya tienen su logotipo en src/assets/marcas/: la
   lista de src/data/site.ts se filtra contra los archivos reales, así que una
   marca sin archivo (o con el archivo renombrado) simplemente no aparece, en
   vez de mostrarse como texto suelto o como imagen rota.

   Cada logo se muestra a un tamaño calculado, no impuesto por el CSS (ver
   altoSeguroLogo en src/lib/imagenes.ts): ninguno se agranda por encima de la
   resolución que da su archivo. Por eso Corona, el archivo más pequeño, se ve
   un punto más bajo que el resto, y La Especial, que es muy alargada, se ve
   más baja todavía: es preferible a verlas borrosas en una pantalla retina. */
const ALTO_FRANJA = 40;
const ANCHO_MAXIMO_FRANJA = 130;

const logosDeLaFranja = marcasDeLaFranja.flatMap((nombre) => {
  const imagen = logoMarcaImagen(nombre);
  if (!imagen) return []; // marca sin archivo de logo: fuera de la franja

  // Solo se pasa el alto: <Image> deriva el ancho de la relación de aspecto
  // real del archivo, así el atributo width y la imagen generada coinciden.
  return [{ nombre, imagen, alto: altoSeguroLogo(imagen, ALTO_FRANJA, ANCHO_MAXIMO_FRANJA) }];
});
---

<BaseLayout
  title="Distribuciones Santiago de Tunja — Distribuidor Nutresa en Boyacá, Santander y Cundinamarca"
  description="Distribuidor oficial de Grupo Nutresa en Boyacá, Santander y Cundinamarca. 21 años de experiencia, 87 municipios cubiertos y más de 7.000 clientes atendidos."
>
  <!-- HERO -->
  <section class="relative overflow-hidden pt-14 pb-0 tablet:pt-24" data-seccion="hero">
    <div class="wrap">
      <div class="grid grid-cols-1 items-center gap-14 tablet:grid-cols-[1.05fr_.95fr] tablet:gap-16">
        <div>
          <p class="glass mb-7 inline-flex items-center gap-2.5 rounded-full px-4 py-2 text-[13px] font-semibold text-ink">
            <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-verde opacity-75"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-verde"></span>
            </span>
            Aliado comercial de Grupo Nutresa
          </p>
          <h1 class="text-[38px] mob:text-[46px] tablet:text-[60px]">
            Las marcas que mueven tu negocio,{' '}
            <span class="text-accent-strong">más cerca de ti.</span>
          </h1>
          <p class="mt-7 max-w-[48ch] text-lg text-muted tablet:text-xl">
            Distribuimos productos de consumo masivo a negocios de Boyacá, Santander y
            Cundinamarca, con entregas semanales y asesoría cercana.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a class="btn btn-whatsapp" href={empresa.whatsapp} target="_blank" rel="noopener">
              Haz tu pedido
              <Icono nombre="whatsapp" class="h-[18px] w-[18px]" />
            </a>
            <a class="btn btn-secondary" href={ruta('/catalogo/')}>Conoce nuestro portafolio</a>
          </div>
        </div>

        {
          /* EDITAR AQUÍ: reemplazar cuando se suba la foto real de
             [bodega/equipo/flota]. No se toca este bloque: la ruta y el texto
             alternativo salen de HERO_IMAGEN y HERO_IMAGEN_ALT en
             src/data/site.ts. El object-cover recorta cualquier foto al mismo
             formato 5:4, así que sirve tanto horizontal como vertical. */
          HERO_IMAGEN ? (
            <img
              src={ruta(HERO_IMAGEN)}
              alt={HERO_IMAGEN_ALT}
              class="aspect-[5/4] w-full rounded-[28px] object-cover shadow-[0_28px_60px_rgba(13,44,132,.22)]"
            />
          ) : (
            /* Sin foto todavía: panel de marca. Al definir HERO_IMAGEN en
               src/data/site.ts se reemplaza por la foto real. */
            <div class="sobre-oscuro relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-[28px] bg-gradient-to-br from-primary to-primary-dark shadow-[0_28px_60px_rgba(13,44,132,.22)]">
              <div class="absolute -top-20 -right-16 h-72 w-72 rounded-full bg-secondary/25 blur-2xl" />
              <div class="absolute -bottom-24 -left-12 h-64 w-64 rounded-full bg-accent/10 blur-2xl" />
              <div class="relative flex flex-col items-center gap-6 px-8 text-center">
                <img
                  src={ruta('/LOGO-removebg-preview.png')}
                  alt=""
                  width="183"
                  height="180"
                  class="h-28 w-28 object-contain drop-shadow-[0_10px_28px_rgba(0,0,0,.45)]"
                />
                <p class="max-w-[26ch] font-display text-xl font-semibold text-ink">
                  Llevamos las mejores marcas del país a tu tienda
                </p>
                <p class="text-sm tracking-[0.08em] text-muted uppercase">
                  Boyacá · Santander · Cundinamarca
                </p>
              </div>
            </div>
          )
        }
      </div>

      <!-- BARRA DE CIFRAS -->
      <div
        class="sobre-oscuro mt-20 rounded-[24px] bg-primary px-6 py-9 shadow-[0_18px_44px_rgba(13,44,132,.22)] tablet:px-10"
        data-seccion="cifras"
      >
        <dl class="grid grid-cols-2 gap-y-9 tablet:grid-cols-4">
          {
            cifras.map((cifra, i) => (
              <div
                class:list={[
                  'group flex items-center justify-center gap-4 px-2 text-ink',
                  i > 0 && 'mob:border-l mob:border-line',
                ]}
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-accent/15 text-accent transition-all duration-300 group-hover:scale-105 group-hover:bg-accent group-hover:text-ink-dark">
                  <Icono nombre={cifra.icono} class="h-5 w-5" />
                </span>
                <div>
                  <dd class="font-display text-[30px] leading-none font-bold" data-contador>
                    {cifra.valor}
                  </dd>
                  <dt class="mt-1.5 text-[12.5px] text-muted">{cifra.etiqueta}</dt>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- NOVEDADES Y TEMPORADA: un solo bloque con la temporada vigente
       (src/data/temporada.ts, activada por fecha) seguida de las
       colaboraciones del mes (src/data/especiales.ts, curadas a mano). -->
  <NovedadesTemporada />

  <!-- MARCAS -->
  <div class="border-y border-line bg-fondo py-16" data-seccion="marcas">
    <div class="wrap">
      <p class="mb-8 text-center text-[12.5px] font-semibold tracking-[0.14em] text-muted uppercase">
        Marcas que distribuimos
      </p>
      <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-x-10 gap-y-6 p-0">
        {
          logosDeLaFranja.map((marca) => (
            <li class="flex items-center justify-center" style={`height:${ALTO_FRANJA}px`}>
              <Image
                src={marca.imagen}
                alt={`Logotipo de ${marca.nombre}`}
                height={marca.alto}
                densities={[1, 2]}
                format="webp"
                quality={90}
                loading="lazy"
                decoding="async"
                class="logo-marca logo-marca-franja"
              />
            </li>
          ))
        }
      </ul>
      {/* EDITAR AQUÍ: para sumar una marca a esta franja, deja su logotipo en
          src/assets/marcas/ (nombre en minúsculas y con guiones) y agrégala a
          `marcasDeLaFranja` en src/data/site.ts. */}
    </div>
  </div>

  <!-- COBERTURA -->
  <section id="cobertura" class="section border-y border-line bg-fondo" data-seccion="cobertura">
    <div class="wrap">
      <div class="mb-10 flex flex-col gap-8 tablet:flex-row tablet:items-end tablet:justify-between">
        <div class="max-w-[52ch]">
          <span class="kicker">Nuestra red</span>
          <h2 class="text-[28px] tablet:text-[38px]">Cobertura nacional</h2>
          {/* La cifra sale de CLIENTES_TEXTO (src/data/site.ts), la misma que
              muestra la barra del hero: son el mismo dato y no pueden diferir. */}
          <p class="mt-3 text-muted">
            Atendemos {CLIENTES_TEXTO} clientes en 87 municipios de tres departamentos. En el mapa
            marcamos los municipios donde se concentra la red.
          </p>
        </div>

        <dl class="flex flex-wrap gap-x-9 gap-y-4">
          {
            departamentos.map((dep) => (
              <div>
                <dt class="flex items-center gap-2 text-[13px] font-medium text-muted">
                  <span
                    class="h-2.5 w-2.5 rounded-full"
                    style={`background:${dep.color}`}
                    aria-hidden="true"
                  />
                  {dep.nombre}
                </dt>
                <dd class="mt-1 font-display text-[30px] leading-none font-bold text-primary">
                  {dep.total}
                </dd>
                {/* Aquí iba el conteo de clientes por departamento, sacado de
                    src/data/clientes-municipio.ts. Se quitó porque sumaba una
                    cifra distinta de la que publica el sitio (CLIENTES_TEXTO) y
                    dos números que no cuadran se leen como un error. El dato
                    sigue siendo interno y alimenta el tamaño de los puntos del
                    mapa. */}
                <dd class="mt-1 m-0 text-[12.5px] text-muted">
                  {formatoNumero.format(resumenCobertura.clientesPorDepartamento[dep.nombre])} clientes
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      {/* La pregunta que trae a la mayoría de visitantes nuevos, resuelta antes
          del mapa. Al elegir un municipio, el mapa resalta su punto. */}
      <BuscadorMunicipio />

      <MapaRed />
    </div>
  </section>

  <!-- PARA TU NEGOCIO -->
  <section class="section" data-seccion="para_tu_negocio">
    <div class="wrap">
      <div class="mb-14 max-w-[56ch]">
        <span class="kicker">Para tu negocio</span>
        <h2 class="text-[28px] tablet:text-[38px]">Impulsa tu negocio con nuestro respaldo</h2>
        <p class="mt-4 text-lg text-muted">
          Soluciones integrales para hacer crecer a nuestros aliados comerciales: portafolio,
          precio, asesoría y cumplimiento en la entrega.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 mob:grid-cols-2 tablet:grid-cols-4" data-revelar-grupo>
        {
          beneficios.map((b) => (
            <a class="tarjeta-int flex flex-col p-8" href={ruta(b.enlace)}>
              <span class="icono-chip mb-5 h-12 w-12">
                <Icono nombre={b.icono} class="h-6 w-6" interactivo={false} />
              </span>
              <h3 class="mb-2 text-base">{b.titulo}</h3>
              <p class="m-0 text-[14px] text-muted">{b.texto}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-secondary-dark">
                {b.enlaceTexto}
                <Icono nombre="arrow-right" class="flecha-int h-4 w-4" interactivo={false} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- RESEÑAS DE GOOGLE -->
  <Resenas />

  <!-- HAZ TU PEDIDO -->
  <section
    id="haz-tu-pedido"
    class="section border-y border-line bg-fondo"
    data-seccion="haz_tu_pedido"
  >
    <div class="wrap">
      <div class="mx-auto mb-14 max-w-[46ch] text-center">
        <span class="kicker">Haz tu pedido</span>
        <h2 class="text-[28px] tablet:text-[38px]">Pide fácil y rápido</h2>
        <p class="mt-4 text-lg text-muted">Elige el canal que prefieras.</p>
      </div>

      <div
        class:list={[
          'grid grid-cols-1 gap-6',
          hayPideky ? 'tablet:grid-cols-2' : 'mx-auto max-w-[520px]',
        ]}
      >
        <div class="group glass-card flex flex-col items-center p-10 text-center">
          <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-whatsapp/15 text-whatsapp transition-all duration-300 group-hover:scale-105 group-hover:bg-whatsapp group-hover:text-white group-focus-within:scale-105">
            <Icono nombre="whatsapp" class="h-8 w-8" interactivo={false} />
          </span>
          <h3 class="mt-6 text-xl">WhatsApp</h3>
          <p class="mt-3 mb-8 max-w-[30ch] text-[14.5px] text-muted">
            Habla con un asesor y realiza tu pedido.
          </p>
          <a
            class="btn btn-whatsapp mt-auto"
            href={empresa.whatsapp}
            target="_blank"
            rel="noopener"
          >
            Escribir ahora
            <Icono nombre="whatsapp" class="h-[18px] w-[18px]" />
          </a>
        </div>

        {
          hayPideky && (
            <div class="group glass-card flex flex-col items-center p-10 text-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/15 text-accent transition-all duration-300 group-hover:scale-105 group-hover:bg-accent group-hover:text-ink-dark group-focus-within:scale-105">
                <Icono nombre="shopping-cart" class="h-8 w-8" interactivo={false} />
              </span>
              <h3 class="mt-6 text-xl">Pideky</h3>
              <p class="mt-3 mb-8 max-w-[30ch] text-[14.5px] text-muted">
                Haz tu pedido en línea de manera rápida, sin registro previo.
              </p>
              <BotonPideky />
            </div>
          )
        }
      </div>

      <div class="glass-card mt-6 flex flex-wrap items-center justify-between gap-6 px-8 py-7">
        <div>
          <p class="m-0 font-display text-lg font-semibold text-ink">¿Aún no eres cliente?</p>
          <p class="m-0 text-[14.5px] text-muted">Regístrate y empieza a comprar con nosotros.</p>
        </div>
        <a class="btn btn-accent" href={ruta('/contactanos/')}>Quiero ser cliente</a>
      </div>
    </div>
  </section>

  <!-- CTA: EMPLEOS + PQRS -->
  <section class="section" data-seccion="empleos_pqrs">
    <div class="wrap grid grid-cols-1 gap-6 tablet:grid-cols-2">
      <div class="glass-card p-8">
        <h3 class="mb-3 text-[19px]">Únete a nuestro equipo</h3>
        <p class="mb-5 text-[14.5px] text-muted">
          ¿Buscas una oportunidad profesional en el sector logístico? Estamos en constante
          crecimiento.
        </p>
        <a class="btn btn-secondary" href={ruta('/empleos/')}>Postularme ahora</a>
      </div>
      <div class="glass-card p-8">
        <h3 class="mb-3 text-[19px]">Atención al cliente</h3>
        <p class="mb-5 text-[14.5px] text-muted">
          ¿Tienes alguna solicitud, queja o reclamo? Estamos aquí para escucharte y mejorar.
        </p>
        <a class="btn btn-primary" href={ruta('/pqrs/')}>Enviar PQRS</a>
      </div>
    </div>
  </section>
  {/* La franja "Estamos en tus redes" se quitó del inicio: los mismos cuatro
      enlaces ya están en el pie de página, en todas las páginas del sitio. */}

  {/* Mide que secciones de esta pagina se llegan a ver (evento seccion_vista). */}
  <AnaliticaSecciones />
</BaseLayout>

<script>
  /**
   * Cifras que cuentan hacia arriba cuando la barra entra en pantalla.
   *
   * El número se lee del propio texto (así el HTML sigue siendo correcto sin
   * JavaScript) y se respeta el prefijo: "+7.600" cuenta hasta 7600 y conserva
   * el "+". Si el sistema pide menos movimiento, no se anima nada.
   */
  const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cifras = document.querySelectorAll<HTMLElement>('[data-contador]');
  const formato = new Intl.NumberFormat('es-CO');

  if (cifras.length && !menosMovimiento && 'IntersectionObserver' in window) {
    const animar = (el: HTMLElement) => {
      const texto = el.textContent?.trim() ?? '';
      const prefijo = texto.match(/^\D*/)?.[0] ?? '';
      const destino = Number(texto.replace(/\D/g, ''));
      if (!destino) return;

      const duracion = 900;
      const inicio = performance.now();

      const paso = (ahora: number) => {
        const avance = Math.min((ahora - inicio) / duracion, 1);
        // Curva ease-out: arranca rápido y frena al final.
        const valor = Math.round(destino * (1 - Math.pow(1 - avance, 3)));
        el.textContent = prefijo + formato.format(valor);
        if (avance < 1) requestAnimationFrame(paso);
      };

      el.textContent = prefijo + '0';
      requestAnimationFrame(paso);
    };

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          animar(entrada.target as HTMLElement);
          observador.unobserve(entrada.target);
        }
      },
      { threshold: 0.6 },
    );

    cifras.forEach((cifra) => observador.observe(cifra));
  }
</script>

<style>
  /* El realce parejo y el object-contain vienen de .logo-marca, en
     global.css, que comparten la franja y las fichas del catálogo. Aquí solo
     va lo propio de la franja: sobre el fondo gris los logotipos van algo
     atenuados y recuperan su color al pasar el cursor. */
  .logo-marca-franja {
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .logo-marca-franja:hover {
    opacity: 1;
  }
</style>
