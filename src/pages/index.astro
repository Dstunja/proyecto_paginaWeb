import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ruta } from '../lib/rutas';
import { altoSeguroLogo, logoMarcaImagen } from '../lib/imagenes';
import MapaRed from '../components/MapaRed.astro';
import BuscadorMunicipio from '../components/BuscadorMunicipio.astro';
import EspecialesMes from '../components/EspecialesMes.astro';
import BotonPideky from '../components/BotonPideky.astro';
import Icono from '../components/Icono.astro';
import Resenas from '../components/Resenas.astro';
import AnaliticaSecciones from '../components/AnaliticaSecciones.astro';
import {
  cifras,
  marcasDeLaFranja,
  beneficios,
  empresa,
  CLIENTES_TEXTO,
  PIDEKY_URL,
  HERO_IMAGEN,
  HERO_IMAGEN_ALT,
  resumenCobertura,
} from '../data/site';
// De municipios.ts sale el dato real (cuántos municipios cubre cada
// departamento y su color); las cifras de clientes que se muestran son las
// comunicadas y salen de resumenCobertura (ver src/data/site.ts).
import { departamentos } from '../data/municipios';

const formatoNumero = new Intl.NumberFormat('es-CO');

/**
 * EDITAR AQUÍ (src/data/site.ts, PIDEKY_URL): mientras esa variable esté vacía,
 * la tarjeta de Pideky de "Haz tu pedido" no se dibuja y la sección queda con
 * los canales que sí funcionan. Anunciar un canal cuyo botón no lleva a ninguna
 * parte cuesta más confianza de la que gana. Al llenar la URL, la tarjeta
 * reaparece sola y la rejilla vuelve a dos columnas.
 */
const hayPideky = PIDEKY_URL.trim() !== '';

/* Franja "Marcas que distribuimos".

   Solo entran las marcas que ya tienen su logotipo en src/assets/marcas/: la
   lista de src/data/site.ts se filtra contra los archivos reales, así que una
   marca sin archivo (o con el archivo renombrado) simplemente no aparece, en
   vez de mostrarse como texto suelto o como imagen rota.

   Cada logo se muestra a un tamaño calculado, no impuesto por el CSS (ver
   altoSeguroLogo en src/lib/imagenes.ts): ninguno se agranda por encima de la
   resolución que da su archivo. Por eso Corona, el archivo más pequeño, se ve
   un punto más bajo que el resto, y La Especial, que es muy alargada, se ve
   más baja todavía: es preferible a verlas borrosas en una pantalla retina. */
const ALTO_FRANJA = 40;
const ANCHO_MAXIMO_FRANJA = 130;

const logosDeLaFranja = marcasDeLaFranja.flatMap((nombre) => {
  const imagen = logoMarcaImagen(nombre);
  if (!imagen) return []; // marca sin archivo de logo: fuera de la franja

  // Solo se pasa el alto: <Image> deriva el ancho de la relación de aspecto
  // real del archivo, así el atributo width y la imagen generada coinciden.
  return [{ nombre, imagen, alto: altoSeguroLogo(imagen, ALTO_FRANJA, ANCHO_MAXIMO_FRANJA) }];
});
---

<BaseLayout
  title="Distribuciones Santiago de Tunja — Distribuidor Nutresa en Boyacá, Santander y Cundinamarca"
  description="Distribuidor oficial de Grupo Nutresa en Boyacá, Santander y Cundinamarca. 21 años de experiencia, 87 municipios cubiertos y más de 7.000 clientes atendidos."
>
  <!-- HERO -->
  <section class="relative overflow-hidden pt-14 pb-0 tablet:pt-24" data-seccion="hero">
    <div class="wrap">
      <div class="grid grid-cols-1 items-center gap-14 tablet:grid-cols-[1.05fr_.95fr] tablet:gap-16">
        <div>
          <p class="glass mb-7 inline-flex items-center gap-2.5 rounded-full px-4 py-2 text-[13px] font-semibold text-ink">
            <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-verde opacity-75"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-verde"></span>
            </span>
            Aliado comercial de Grupo Nutresa
          </p>
          <h1 class="text-[38px] mob:text-[46px] tablet:text-[60px]">
            Las marcas que mueven tu negocio,{' '}
            <span class="text-accent-strong">más cerca de ti.</span>
          </h1>
          <p class="mt-7 max-w-[48ch] text-lg text-muted tablet:text-xl">
            Distribuimos productos de consumo masivo a negocios de Boyacá, Santander y
            Cundinamarca, con entregas semanales y asesoría cercana.
          </p>
          {/* `data-magnetico`: los dos CTA de la portada se estiran unos
              píxeles hacia el cursor cuando pasa cerca. Solo con ratón y solo
              si el sistema no pide menos movimiento; lo gobierna
              src/lib/interacciones.ts. */}
          <div class="mt-10 flex flex-wrap gap-4">
            <a
              class="btn btn-whatsapp"
              href={empresa.whatsapp}
              target="_blank"
              rel="noopener"
              data-magnetico
            >
              Haz tu pedido
              <Icono nombre="whatsapp" class="h-[18px] w-[18px]" />
            </a>
            <a class="btn btn-secondary" href={ruta('/catalogo/')} data-magnetico>
              Conoce nuestro portafolio
            </a>
          </div>
        </div>

        {
          /* EDITAR AQUÍ: reemplazar cuando se suba la foto real de
             [bodega/equipo/flota]. No se toca este bloque: la ruta y el texto
             alternativo salen de HERO_IMAGEN y HERO_IMAGEN_ALT en
             src/data/site.ts. El object-cover recorta cualquier foto al mismo
             formato 5:4, así que sirve tanto horizontal como vertical. */
          HERO_IMAGEN ? (
            /* `data-parallax`: la foto se desplaza unos píxeles más despacio
               que el texto al hacer scroll, para dar profundidad. El recorrido
               son 16 px como máximo; lo gobierna src/lib/interacciones.ts y se
               apaga solo con "reducir movimiento". */
            <img
              src={ruta(HERO_IMAGEN)}
              alt={HERO_IMAGEN_ALT}
              class="aspect-[5/4] w-full rounded-[28px] object-cover shadow-[0_28px_60px_rgba(13,44,132,.22)] will-change-transform"
              data-parallax
            />
          ) : (
            /* Sin foto todavía: panel de marca. Al definir HERO_IMAGEN en
               src/data/site.ts se reemplaza por la foto real. */
            <div class="sobre-oscuro relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-[28px] bg-gradient-to-br from-primary to-primary-dark shadow-[0_28px_60px_rgba(13,44,132,.22)]">
              <div class="absolute -top-20 -right-16 h-72 w-72 rounded-full bg-secondary/25 blur-2xl" />
              <div class="absolute -bottom-24 -left-12 h-64 w-64 rounded-full bg-accent/10 blur-2xl" />
              <div class="relative flex flex-col items-center gap-6 px-8 text-center">
                <img
                  src={ruta('/LOGO-removebg-preview.png')}
                  alt=""
                  width="183"
                  height="180"
                  class="h-28 w-28 object-contain drop-shadow-[0_10px_28px_rgba(0,0,0,.45)]"
                />
                <p class="max-w-[26ch] font-display text-xl font-semibold text-ink">
                  Llevamos las mejores marcas del país a tu tienda
                </p>
                <p class="text-sm tracking-[0.08em] text-muted uppercase">
                  Boyacá · Santander · Cundinamarca
                </p>
              </div>
            </div>
          )
        }
      </div>

      <!-- BARRA DE CIFRAS -->
      <div
        class="sobre-oscuro mt-20 rounded-[24px] bg-primary px-6 py-9 shadow-[0_18px_44px_rgba(13,44,132,.22)] tablet:px-10"
        data-seccion="cifras"
      >
        <dl class="grid grid-cols-2 gap-y-9 tablet:grid-cols-4">
          {
            cifras.map((cifra, i) => (
              <div
                class:list={[
                  'group flex items-center justify-center gap-4 px-2 text-ink',
                  i > 0 && 'mob:border-l mob:border-line',
                ]}
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-accent/15 text-accent transition-all duration-300 group-hover:scale-105 group-hover:bg-accent group-hover:text-ink-dark">
                  <Icono nombre={cifra.icono} class="h-5 w-5" />
                </span>
                <div>
                  <dd class="font-display text-[30px] leading-none font-bold" data-contador>
                    {cifra.valor}
                  </dd>
                  <dt class="mt-1.5 text-[12.5px] text-muted">{cifra.etiqueta}</dt>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ESPECIALES DEL MES: colaboraciones y ediciones especiales de marca,
       elegidas a mano (ver src/data/especiales.ts). -->
  <EspecialesMes />

  <!-- MARCAS -->
  <div class="border-y border-line bg-fondo py-16" data-seccion="marcas">
    <div class="wrap">
      <p class="mb-8 text-center text-[12.5px] font-semibold tracking-[0.14em] text-muted uppercase">
        Marcas que distribuimos
      </p>
      {/* EDITAR AQUÍ: para sumar una marca a esta franja, deja su logotipo en
          src/assets/marcas/ (nombre en minúsculas y con guiones) y agrégala a
          `marcasDeLaFranja` en src/data/site.ts. */}
    </div>

    {/* El carrusel sale del `wrap` a propósito: ocupa todo el ancho de la
        pantalla para que los logotipos entren y salgan por los bordes, que es
        donde la máscara los difumina.

        La lista se pinta DOS veces (la segunda, oculta para los lectores de
        pantalla, es solo la costura del bucle). Ver el comentario del CSS.

        Los logotipos van en carga inmediata y no diferida: dentro de un
        contenedor con overflow:hidden el navegador da por no visible todo lo
        que queda fuera del recorte, así que con loading="lazy" la segunda
        copia no llegaría a cargarse y el carrusel mostraría huecos en blanco
        a mitad de vuelta. Son 30 WebP de 40 px de alto: algo menos de 50 KB en
        total, y la segunda copia reutiliza los mismos archivos ya en caché. */}
    <div class="marquee-marcas">
      <div class="marquee-marcas__pista">
        {
          [false, true].map((esLaCopia) => (
            <ul class="marquee-marcas__grupo" aria-hidden={esLaCopia ? 'true' : undefined}>
              {logosDeLaFranja.map((marca) => (
                <li style={`height:${ALTO_FRANJA}px`}>
                  <Image
                    src={marca.imagen}
                    alt={esLaCopia ? '' : `Logotipo de ${marca.nombre}`}
                    height={marca.alto}
                    densities={[1, 2]}
                    format="webp"
                    quality={90}
                    loading="eager"
                    decoding="async"
                    class="logo-marca logo-marca-franja"
                  />
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>

  <!-- COBERTURA -->
  <section id="cobertura" class="section border-y border-line bg-fondo" data-seccion="cobertura">
    <div class="wrap">
      <div class="mb-10 flex flex-col gap-8 tablet:flex-row tablet:items-end tablet:justify-between">
        <div class="max-w-[52ch]">
          <span class="kicker">Nuestra red</span>
          <h2 class="text-[28px] tablet:text-[38px]">Cobertura nacional</h2>
          {/* La cifra sale de CLIENTES_TEXTO (src/data/site.ts), la misma que
              muestra la barra del hero: son el mismo dato y no pueden diferir. */}
          <p class="mt-3 text-muted">
            Atendemos {CLIENTES_TEXTO} clientes en 87 municipios de tres departamentos. En el mapa
