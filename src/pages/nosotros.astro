---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ruta } from '../lib/rutas';
import PageHero from '../components/PageHero.astro';
import MisionVision from '../components/MisionVision.astro';
import Icono from '../components/Icono.astro';
import { cifras, cobertura } from '../data/site';
import { equipo } from '../data/equipo';
import { imagenOMarcador } from '../lib/imagenes';
import cumplimiento from '../assets/valores/cumplimiento.jpg';
import cercania from '../assets/valores/cercania.jpg';
import calidad from '../assets/valores/calidad.jpg';
import crecimientoCompartido from '../assets/valores/crecimiento-compartido.jpg';

/* Fotos del equipo: mientras el archivo no esté en public/img/equipo/ se usa
   un marcador de posición con las iniciales de la persona. Cuando el cargo
   todavía no tiene nombre, las iniciales salen del cargo ('Líder Logístico'
   -> 'LL') para que el círculo no quede vacío entre los que sí lo tienen. */
const equipoConFoto = equipo.map((persona) => ({
  ...persona,
  ...imagenOMarcador(persona.foto, iniciales(persona.nombre || persona.cargo), 480, 480),
}));

/** 'Nelson Arias' -> 'NA', para el marcador de posición de la foto. */
function iniciales(nombre: string): string {
  return nombre
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((parte) => parte[0]?.toUpperCase() ?? '')
    .join('');
}

/* EDITAR AQUÍ: valores corporativos oficiales de la empresa.

   Las fotos viven en src/assets/valores/ y no en public/ para que pasen por
   el optimizador de Astro: la tarjeta las muestra en WebP y del tamaño en que
   se ven, no el archivo original. El `alt` describe la escena para quien
   navega con lector de pantalla; no repite el título de la tarjeta, que ya se
   lee justo al lado. */
const valores = [
  {
    icono: 'clock',
    titulo: 'Cumplimiento',
    texto: 'Lo que prometemos se entrega. Cada semana, en cada punto de venta.',
    imagen: cumplimiento,
    alt: 'Un repartidor entrega una caja a una clienta junto al camión de reparto.',
  },
  {
    icono: 'users',
    titulo: 'Cercanía',
    texto: 'Conocemos por nombre a los tenderos de los municipios que atendemos.',
    imagen: cercania,
    alt: 'Un asesor comercial y una tendera revisan juntos un pedido en una tableta.',
  },
  {
    icono: 'shield-check',
    titulo: 'Calidad',
    texto: 'Cadena de frío, manejo y almacenamiento según los estándares de nuestros aliados.',
    imagen: calidad,
    alt: 'Manejo de la mercancía en bodega: transporte con estibadora, revisión de un refrigerador y estantería organizada.',
  },
  {
    icono: 'handshake',
    titulo: 'Crecimiento compartido',
    texto: 'Si al aliado comercial le va bien, a nosotros también.',
    imagen: crecimientoCompartido,
    alt: 'Un asesor comercial y una tendera se dan la mano en la tienda.',
  },
];
---

<BaseLayout
  title="Nosotros — Distribuciones Santiago de Tunja"
  description="21 años distribuyendo las marcas de Grupo Nutresa en Boyacá, Santander y Cundinamarca. Conoce nuestra historia, misión, visión y valores."
>
  <PageHero
    kicker="Quiénes somos"
    titulo="21 años conectando marcas con el comercio de la región"
    texto="Somos una distribuidora y aliada comercial del portafolio de Grupo Nutresa, enfocada en conectar grandes marcas con nuestros clientes y contribuir al crecimiento del mercado en nuestra región."
  />

  <!-- HISTORIA + CIFRAS -->
  <section class="section">
    <div
      class="wrap grid grid-cols-1 items-start gap-14 tablet:grid-cols-[1.1fr_.9fr]"
      data-revelar-grupo="fundido"
    >
      <div>
        <h2 class="text-[28px] tablet:text-[38px]">Nuestra historia</h2>
        <!-- EDITAR AQUÍ: reemplazar por la historia real (fundación, hitos, crecimiento). -->
        <p class="mt-4 text-muted">
          Distribuciones Santiago de Tunja nació en Tunja con una operación pequeña y una idea
          simple: que ningún tendero de la región se quedara sin producto. Hoy, dos décadas después,
          atendemos cada semana el comercio de 87 municipios en tres departamentos desde nuestro
          único punto de venta.
        </p>
        <p class="mt-4 text-muted">
          Nuestra sede principal está en Tunja y desde allí sale la operación logística que cubre el
          centro oriente del país, con un equipo humano que conoce el territorio y el negocio de
          cada cliente.
        </p>

        <div class="mt-8 flex flex-col gap-[18px]">
          {
            cobertura.map((dep) => (
              <div class="flex items-baseline justify-between border-b border-line pb-3.5">
                <span class="font-medium">{dep.departamento}</span>
                <span class="font-display text-[26px] font-bold text-ink">
                  {dep.municipios} municipios
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="glass-card grid grid-cols-2 gap-6 px-8 py-9 text-ink">
        {
          cifras.map((cifra) => (
            <div class="group flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/15 text-accent transition-all duration-200 group-hover:bg-accent group-hover:text-primary">
                <Icono nombre={cifra.icono} class="h-5 w-5" />
              </span>
              <div>
                <div class="font-display text-[28px] leading-none font-bold">{cifra.valor}</div>
                <div class="mt-1.5 text-[12.5px] text-muted">{cifra.etiqueta}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MISIÓN Y VISIÓN -->
  <section class="section border-y border-line bg-fondo">
    <div class="wrap">
      <div class="mb-14 max-w-[56ch]" data-revelar>
        <span class="kicker">Nuestro norte</span>
        <h2 class="text-[28px] tablet:text-[38px]">Misión y visión</h2>
      </div>
      <MisionVision />
    </div>
  </section>

  <!-- EQUIPO DIRECTIVO -->
  <section class="section border-b border-line">
    <div class="wrap">
      <div class="mb-14 max-w-[56ch]" data-revelar>
        <span class="kicker">Quiénes lideran</span>
        <h2 class="text-[28px] tablet:text-[38px]">Nuestro equipo directivo</h2>
        <p class="mt-4 text-muted">
          Detrás de cada entrega hay un equipo que conoce el territorio, el portafolio y el negocio
          de cada cliente.
        </p>
      </div>

      {/* EDITAR AQUÍ: las fotos van en public/img/equipo/, cuadradas y ya
          recortadas por `npm run fotos:equipo`; los nombres, cargos, frases y
          el orden de las tarjetas viven en src/data/equipo.ts. Una tarjeta sin
          nombre (cargo aún sin cubrir) muestra «Próximamente», y una sin frase
          no la dibuja. La rejilla se reparte sola con cualquier número de
          personas: ver .rejilla-equipo al final de este archivo. */}
      <div class="rejilla-equipo grid gap-6" data-revelar-grupo>
        {
          equipoConFoto.map((persona) => (
            <div class="group glass-card flex flex-col items-center p-8 text-center">
              <img
                src={persona.src}
                alt={persona.esMarcador ? '' : [persona.nombre, persona.cargo].filter(Boolean).join(', ')}
                loading="lazy"
                width="480"
                height="480"
                class="h-28 w-28 rounded-full border-4 border-surface object-cover shadow-[0_10px_28px_rgba(13,44,132,.14)] transition-transform duration-300 group-hover:scale-105"
              />
              <h3 class:list={['mt-6 mb-1 text-[17px]', !persona.nombre && 'text-muted']}>
                {persona.nombre || 'Próximamente'}
              </h3>
              <p class="m-0 font-display text-[13px] font-semibold tracking-[0.08em] text-accent-text uppercase">
                {persona.cargo}
              </p>
              {persona.frase && (
                <p class="mt-4 mb-0 text-[14px] text-muted">«{persona.frase}»</p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- VALORES -->
  <section class="section">
    <div class="wrap">
      <div class="mb-14 max-w-[56ch]" data-revelar>
        <span class="kicker">Cómo trabajamos</span>
        <h2 class="text-[28px] tablet:text-[38px]">Nuestros valores</h2>
      </div>
      {/*
        Tarjetas de valor: ícono y texto a la izquierda, foto a la derecha.

        La rejilla baja de cuatro columnas a dos porque la tarjeta ahora es
        horizontal: repartida en cuatro, la foto quedaría de unos 80 px y el
        texto en columnas de dos palabras. En dos columnas la tarjeta mide
        unos 545 px y la foto ronda el 37% de ese ancho.

        Por debajo de 900 px la tarjeta se apila (texto arriba, foto abajo)
        para que ninguna de las dos cosas quede comprimida. Ahí la foto se
        limita a 440 px de ancho, que es lo que dan los archivos originales
        (unos 455 px): más allá de eso el navegador la agrandaría y se vería
        blanda, igual que con los logotipos de marca.
      */}
      <div class="grid grid-cols-1 gap-6 mob:grid-cols-2" data-revelar-grupo>
        {
          valores.map((valor) => (
            <div class="group glass-card flex flex-col gap-6 p-8 tablet:flex-row tablet:items-stretch">
              <div class="tablet:flex-1">
                <span class="icono-chip mb-5 h-12 w-12">
                  <Icono nombre={valor.icono} class="h-6 w-6" interactivo={false} />
                </span>
                <h3 class="mb-3 text-lg">{valor.titulo}</h3>
                <p class="m-0 text-[14.5px] text-muted">{valor.texto}</p>
              </div>
              <Image
                src={valor.imagen}
                alt={valor.alt}
                widths={[220, 440]}
                sizes="(min-width: 900px) 220px, 440px"
                format="webp"
                quality={82}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full max-w-[440px] rounded-2xl object-cover tablet:aspect-auto tablet:h-full tablet:w-[42%] tablet:max-w-none tablet:shrink-0"
              />
            </div>
          ))
        }
      </div>

      <div class="mt-12 flex flex-wrap gap-3.5">
        <a class="btn btn-primary" href={ruta('/contactanos/')}>Hablar con un asesor</a>
        <a class="btn btn-secondary" href={ruta('/empleos/')}>Trabajar con nosotros</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Rejilla del equipo directivo.

     Reparte cualquier número de tarjetas con el mismo ancho y deja CENTRADA la
     fila incompleta del final, en vez de pegada a la izquierda. Con las cinco
     de hoy queda así:

       móvil       (< 520 px)   1 columna
       tablet      (520-899 px) 2 + 2 + 1
       escritorio  (>= 900 px)  3 + 2

     Cinco en fila no caben: a 1440 px cada tarjeta mediría 204 px y los cargos
     se partirían en dos líneas («Gerencia Estratégica» incluso bajando el
     relleno de la tarjeta).

     Para centrar sin cambiar el ancho de las tarjetas se duplican las columnas:
     en tablet la rejilla tiene 4 y cada tarjeta ocupa 2, así que la tarjeta que
     queda sola al final puede empezar en la columna 2 y cae en el centro. En
     escritorio son 6 columnas de a 2, y la fila final se corre una columna si
     tiene dos tarjetas, o dos si tiene una.

     `grid-auto-rows: 1fr` iguala la altura de TODAS las filas, no solo la de
     las tarjetas que comparten fila: si una frase o un cargo largo estira una
     tarjeta, las de la otra fila crecen con ella y el conjunto no se descuadra.

     Los dos anchos repiten a mano `--breakpoint-mob` y `--breakpoint-tablet`
     (global.css); si allí cambian, aquí también. */
  .rejilla-equipo {
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
  }

  @media (min-width: 520px) {
    .rejilla-equipo {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .rejilla-equipo > * {
      grid-column: span 2;
    }

    /* Número impar de tarjetas: la última va sola en su fila. */
    .rejilla-equipo > :last-child:nth-child(odd) {
      grid-column: 2 / span 2;
    }
  }

  @media (min-width: 900px) {
    .rejilla-equipo {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    /* Anula el centrado de tablet, que aquí no corresponde. */
    .rejilla-equipo > *,
    .rejilla-equipo > :last-child:nth-child(odd) {
      grid-column: span 2;
    }

    /* Fila final de dos tarjetas: la primera empieza en la columna 2. */
    .rejilla-equipo > :nth-child(3n + 1):nth-last-child(2) {
      grid-column: 2 / span 2;
    }

    /* Fila final de una sola tarjeta: empieza en la columna 3. */
    .rejilla-equipo > :nth-child(3n + 1):last-child {
      grid-column: 3 / span 2;
    }
  }
</style>
