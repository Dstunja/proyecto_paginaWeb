---
/**
 * "Arma tu pedido": el catálogo completo convertido en una lista que el
 * tendero le manda a su asesor por WhatsApp.
 *
 * Los precios que se muestran son SUGERIDOS AL PÚBLICO y solo aparecen en las
 * referencias que los tienen confirmados (src/data/precios.ts). El sitio es
 * estático y no consulta inventario ni lista de precios: el valor final y la
 * disponibilidad los confirma el asesor, y así se advierte en el panel del
 * pedido y en el mensaje que se envía.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CatalogoPedido from '../components/pedido/CatalogoPedido.astro';
import PanelPedido from '../components/pedido/PanelPedido.astro';
import Icono from '../components/Icono.astro';
import EnlaceTeleventas from '../components/EnlaceTeleventas.astro';
import { productos, MARCAS } from '../data/productos';

/** Sin saludo: "Hola {nombre}, " lo pone el reparto de Televentas. */
const mensajeDirecto = 'quiero hacer un pedido y necesito que me acompañes.';
---

<BaseLayout
  title="Arma tu pedido — Distribuciones Santiago de Tunja"
  description="Elige las referencias que necesita tu negocio, indica las cantidades y envíale la lista a tu asesor por WhatsApp. Sin registro y sin compromiso."
>
  <PageHero
    kicker="Arma tu pedido"
    titulo="Elige lo que necesita tu negocio"
    texto={`Busca entre ${productos.length} referencias de ${MARCAS.length} marcas, marca las cantidades y envíale la lista a tu asesor por WhatsApp. Sin registro y sin compromiso.`}
  />

  {/* `pb-28` en móvil y tableta: la barra fija del carrito mide unos 76 px y
      sin este aire taparía la última fila de productos. En escritorio la barra
      es una píldora suelta en la esquina y no hace falta tanto. */}
  <section class="section pt-10 pb-28 tablet:pt-12 tablet:pb-20">
    <div class="wrap">
      {/* Salida rápida para quien prefiere que se lo tomen por chat. */}
      <p class="mb-8 text-[14.5px] text-muted">
        ¿Prefieres hablar con una persona?
        <EnlaceTeleventas
          class="ml-1 inline-flex items-center gap-1.5 font-semibold text-secondary-dark underline"
          mensaje={mensajeDirecto}
          data-escribir-directo
        >
          Escríbenos directo por WhatsApp
          <Icono nombre="whatsapp" class="h-4 w-4" interactivo={false} />
        </EnlaceTeleventas>
        y un asesor te toma el pedido.
      </p>

      <CatalogoPedido />
    </div>
  </section>

  <PanelPedido />
</BaseLayout>
